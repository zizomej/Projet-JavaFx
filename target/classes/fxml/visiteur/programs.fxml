<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.learnhub.controller.ProgramsPageController"
            stylesheets="@/css/styles.css">

    <VBox styleClass="page-root">

        <!-- ═══ TOP NAV ═══ -->
        <HBox styleClass="top-nav" alignment="CENTER_LEFT" spacing="0" minHeight="68">
            <padding><Insets top="0" right="36" bottom="0" left="36"/></padding>
            <Label text="🎓 LearnHub" styleClass="logo-brand" fx:id="titleLabel"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="4">
                <Label text="Accueil"     styleClass="nav-link" onMouseClicked="#goToHome"/>
                <Label text="Programmes"  styleClass="nav-link nav-link-active"/>
                <Label text="Événements"  styleClass="nav-link" onMouseClicked="#goToEvents"/>
                <Label text="Partenaires" styleClass="nav-link" onMouseClicked="#goToPartners"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="8">
                <Button text="S'inscrire"   styleClass="btn-login" onAction="#goToRegister"/>
                <Button text="Se connecter" styleClass="btn-login" onAction="#goToLogin"/>
            </HBox>
        </HBox>

        <!-- ═══ HERO ═══ -->
        <VBox styleClass="page-hero" alignment="CENTER" spacing="14" minHeight="240">
            <padding><Insets top="70" right="40" bottom="70" left="40"/></padding>
            <Label text="Nos Programmes" styleClass="hero-title"/>
            <Label text="Choisissez la formation qui correspond à vos ambitions et construisez votre avenir"
                   styleClass="hero-subtitle" wrapText="true" maxWidth="580" textAlignment="CENTER"/>
            <HBox alignment="CENTER" spacing="10">
                <Label text="🏅 Accrédité"
                       style="-fx-background-color:rgba(255,255,255,0.15); -fx-text-fill:white;
                              -fx-padding:8 16; -fx-background-radius:999; -fx-font-size:12px;"/>
                <Label text="🌍 International"
                       style="-fx-background-color:rgba(250,204,21,0.20); -fx-text-fill:#facc15;
                              -fx-padding:8 16; -fx-background-radius:999; -fx-font-size:12px;"/>
                <Label text="💼 Débouchés 95%"
                       style="-fx-background-color:rgba(255,255,255,0.15); -fx-text-fill:white;
                              -fx-padding:8 16; -fx-background-radius:999; -fx-font-size:12px;"/>
            </HBox>
        </VBox>

        <!-- ═══ AVANTAGES BAR ═══ -->
        <HBox styleClass="stats-showcase" alignment="CENTER" spacing="0" minHeight="100">
            <VBox styleClass="stat-box" alignment="CENTER" HBox.hgrow="ALWAYS" spacing="4">
                <Label text="🏅" style="-fx-font-size:26px;"/>
                <Label text="Accréditation nationale" styleClass="stat-box-text"/>
            </VBox>
            <VBox styleClass="stat-box" alignment="CENTER" HBox.hgrow="ALWAYS" spacing="4">
                <Label text="🌍" style="-fx-font-size:26px;"/>
                <Label text="Partenariats internationaux" styleClass="stat-box-text"/>
            </VBox>
            <VBox styleClass="stat-box" alignment="CENTER" HBox.hgrow="ALWAYS" spacing="4">
                <Label text="💼" style="-fx-font-size:26px;"/>
                <Label text="Insertion 95%" styleClass="stat-box-text"/>
            </VBox>
            <VBox styleClass="stat-box" alignment="CENTER" HBox.hgrow="ALWAYS" spacing="4">
                <Label text="🔬" style="-fx-font-size:26px;"/>
                <Label text="Laboratoires modernes" styleClass="stat-box-text"/>
            </VBox>
            <VBox styleClass="stat-box" alignment="CENTER" HBox.hgrow="ALWAYS" spacing="4">
                <Label text="🎓" style="-fx-font-size:26px;"/>
                <Label text="12 spécialités" styleClass="stat-box-text"/>
            </VBox>
        </HBox>

        <!-- ═══ PROGRAMMES GRID ═══ -->
        <VBox styleClass="section-block" alignment="CENTER" spacing="32">
            <padding><Insets top="60" right="80" bottom="60" left="80"/></padding>

            <VBox alignment="CENTER" spacing="8">
                <Label text="TOUTES NOS FORMATIONS" styleClass="section-label"/>
                <Label text="Des cursus reconnus, des débouchés assurés"
                       styleClass="section-subtitle"/>
            </VBox>

            <!-- Licence Programs -->
            <VBox alignment="CENTER" spacing="12">
                <HBox alignment="CENTER_LEFT">
                    <Label text="🎓  LICENCE (3 ans)"
                           style="-fx-font-size:16px; -fx-font-weight:800; -fx-text-fill:#0A1F44; -fx-padding:0 0 0 4;"/>
                </HBox>
                <FlowPane alignment="CENTER" hgap="22" vgap="22">

                    <!-- Informatique -->
                    <VBox styleClass="course-card" spacing="0" prefWidth="250">
                        <VBox styleClass="course-header course-header-blue" alignment="CENTER" prefHeight="90">
                            <Label text="💻" style="-fx-font-size:38px;"/>
                        </VBox>
                        <VBox spacing="10" style="-fx-padding:16 16 20 16;">
                            <Label text="LICENCE" styleClass="course-level"/>
                            <Label text="Licence Informatique" styleClass="course-title"/>
                            <Label text="3 ans · 50 places" styleClass="course-desc"/>
                            <Label text="Algorithmique, POO, Réseaux, Base de données"
                                   wrapText="true" styleClass="course-desc"/>
                            <Button text="En savoir plus" styleClass="btn-details" onAction="#goToLogin"/>
                        </VBox>
                    </VBox>

                    <!-- Génie Civil -->
                    <VBox styleClass="course-card" spacing="0" prefWidth="250">
                        <VBox alignment="CENTER" prefHeight="90"
                              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #f59e0b, #d97706); -fx-background-radius:14 14 0 0;">
                            <Label text="🏗️" style="-fx-font-size:38px;"/>
                        </VBox>
                        <VBox spacing="10" style="-fx-padding:16 16 20 16;">
                            <Label text="LICENCE" styleClass="course-level"/>
                            <Label text="Génie Civil" styleClass="course-title"/>
                            <Label text="3 ans · 40 places" styleClass="course-desc"/>
                            <Label text="Structures, BTP, Hydraulique, Béton armé"
                                   wrapText="true" styleClass="course-desc"/>
                            <Button text="En savoir plus" styleClass="btn-details" onAction="#goToLogin"/>
                        </VBox>
                    </VBox>

                    <!-- Marketing -->
                    <VBox styleClass="course-card" spacing="0" prefWidth="250">
                        <VBox alignment="CENTER" prefHeight="90"
                              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #ec4899, #db2777); -fx-background-radius:14 14 0 0;">
                            <Label text="📊" style="-fx-font-size:38px;"/>
                        </VBox>
                        <VBox spacing="10" style="-fx-padding:16 16 20 16;">
                            <Label text="LICENCE" styleClass="course-level"/>
                            <Label text="Marketing Digital" styleClass="course-title"/>
                            <Label text="3 ans · 45 places" styleClass="course-desc"/>
                            <Label text="SEO, Réseaux sociaux, Analytics, E-commerce"
                                   wrapText="true" styleClass="course-desc"/>
                            <Button text="En savoir plus" styleClass="btn-details" onAction="#goToLogin"/>
                        </VBox>
                    </VBox>

                    <!-- Finance -->
                    <VBox styleClass="course-card" spacing="0" prefWidth="250">
                        <VBox alignment="CENTER" prefHeight="90"
                              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #10b981, #059669); -fx-background-radius:14 14 0 0;">
                            <Label text="💰" style="-fx-font-size:38px;"/>
                        </VBox>
                        <VBox spacing="10" style="-fx-padding:16 16 20 16;">
                            <Label text="LICENCE" styleClass="course-level"/>
                            <Label text="Finance &amp; Comptabilité" styleClass="course-title"/>
                            <Label text="3 ans · 40 places" styleClass="course-desc"/>
                            <Label text="Comptabilité, Finance, Audit, Fiscalité"
                                   wrapText="true" styleClass="course-desc"/>
                            <Button text="En savoir plus" styleClass="btn-details" onAction="#goToLogin"/>
                        </VBox>
                    </VBox>

                </FlowPane>
            </VBox>

            <!-- Master Programs -->
            <VBox alignment="CENTER" spacing="12">
                <HBox alignment="CENTER_LEFT">
                    <Label text="🏆  MASTER (2 ans)"
                           style="-fx-font-size:16px; -fx-font-weight:800; -fx-text-fill:#0A1F44; -fx-padding:0 0 0 4;"/>
                </HBox>
                <FlowPane alignment="CENTER" hgap="22" vgap="22">

                    <!-- Data Science -->
                    <VBox styleClass="course-card" spacing="0" prefWidth="250">
                        <VBox alignment="CENTER" prefHeight="90"
                              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #7c3aed, #6d28d9); -fx-background-radius:14 14 0 0;">
                            <Label text="🤖" style="-fx-font-size:38px;"/>
                        </VBox>
                        <VBox spacing="10" style="-fx-padding:16 16 20 16;">
                            <Label text="MASTER" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#7c3aed;"/>
                            <Label text="Data Science &amp; IA" styleClass="course-title"/>
                            <Label text="2 ans · 30 places" styleClass="course-desc"/>
                            <Label text="Machine Learning, Big Data, Python, Deep Learning"
                                   wrapText="true" styleClass="course-desc"/>
                            <Button text="En savoir plus" styleClass="btn-details" onAction="#goToLogin"/>
                        </VBox>
                    </VBox>

                    <!-- Cybersécurité -->
                    <VBox styleClass="course-card" spacing="0" prefWidth="250">
                        <VBox alignment="CENTER" prefHeight="90"
                              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #1e3a8a, #1e40af); -fx-background-radius:14 14 0 0;">
                            <Label text="🔐" style="-fx-font-size:38px;"/>
                        </VBox>
                        <VBox spacing="10" style="-fx-padding:16 16 20 16;">
                            <Label text="MASTER" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#1e3a8a;"/>
                            <Label text="Cybersécurité" styleClass="course-title"/>
                            <Label text="2 ans · 25 places" styleClass="course-desc"/>
                            <Label text="Sécurité réseaux, Cryptographie, Ethical Hacking"
                                   wrapText="true" styleClass="course-desc"/>
                            <Button text="En savoir plus" styleClass="btn-details" onAction="#goToLogin"/>
                        </VBox>
                    </VBox>

                    <!-- Management -->
                    <VBox styleClass="course-card" spacing="0" prefWidth="250">
                        <VBox alignment="CENTER" prefHeight="90"
                              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #0891b2, #0e7490); -fx-background-radius:14 14 0 0;">
                            <Label text="🏢" style="-fx-font-size:38px;"/>
                        </VBox>
                        <VBox spacing="10" style="-fx-padding:16 16 20 16;">
                            <Label text="MASTER" style="-fx-font-size:11px; -fx-font-weight:800; -fx-text-fill:#0891b2;"/>
                            <Label text="Management des Entreprises" styleClass="course-title"/>
                            <Label text="2 ans · 35 places" styleClass="course-desc"/>
                            <Label text="RH, Stratégie, Leadership, Gestion de projet"
                                   wrapText="true" styleClass="course-desc"/>
                            <Button text="En savoir plus" styleClass="btn-details" onAction="#goToLogin"/>
                        </VBox>
                    </VBox>

                </FlowPane>
            </VBox>

        </VBox>

        <!-- ═══ CTA ═══ -->
        <VBox alignment="CENTER" spacing="14" minHeight="150"
              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #0A1F44, #1e3a8a);">
            <padding><Insets top="48" right="40" bottom="48" left="40"/></padding>
            <Label text="Prêt à rejoindre LearnHub ?"
                   style="-fx-font-size:26px; -fx-font-weight:900; -fx-text-fill:white;"/>
            <Label text="Inscrivez-vous dès maintenant et accédez à tous nos programmes"
                   style="-fx-font-size:14px; -fx-text-fill:rgba(255,255,255,0.80);"/>
            <Button text="S'inscrire maintenant" onAction="#goToRegister"
                    style="-fx-background-color:#facc15; -fx-text-fill:#0A1F44; -fx-font-weight:800;
                           -fx-background-radius:50; -fx-padding:12 32; -fx-cursor:hand;"/>
        </VBox>

        <!-- ═══ FOOTER ═══ -->
        <VBox styleClass="footer" alignment="CENTER" spacing="6" minHeight="80">
            <padding><Insets top="28" right="40" bottom="28" left="40"/></padding>
            <Label text="© 2026 LearnHub · Plateforme Universitaire Intelligente" styleClass="footer-text"/>
            <Label text="contact@learnhub.tn  ·  +216 XX XXX XXX" styleClass="footer-text"/>
        </VBox>

    </VBox>
</ScrollPane>

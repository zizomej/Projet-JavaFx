<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.admin.AdminDashboardController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="5">
                <Label text="🎓 LearnHub" styleClass="sidebar-brand-text"/>
                <Label text="Espace Administrateur" styleClass="sidebar-brand-sub"/>
            </VBox>
            <VBox spacing="2" style="-fx-padding:10 0;">
                <Label text="NAVIGATION" styleClass="nav-section-title"/>
                <Button text="🏠  Tableau de bord" styleClass="nav-btn" onAction="#goBack" maxWidth="Infinity"/>
                <Button text="🕐  Créneaux" styleClass="nav-btn, nav-btn-active" maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="admin-section" spacing="10">
                <Button text="🚪  Déconnexion" styleClass="nav-logout" onAction="#handleLogout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <VBox styleClass="content-area" spacing="20">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="🕐 Gestion des Créneaux" styleClass="page-title"/>
                    <Label text="Gérez les créneaux médicaux disponibles" styleClass="page-subtitle"/>
                </VBox>
                <Button text="← Tableau de bord" styleClass="btn, btn-secondary, btn-sm" onAction="#goBack"/>
            </HBox>
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
                <HBox styleClass="card-header" spacing="12" alignment="CENTER_LEFT">
                    <Label text="🕐 Gestion des Créneaux" styleClass="card-header-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="searchField" promptText="🔍 Rechercher..." prefWidth="220" styleClass="search-field"/>
                    <Button text="➕ Ajouter" styleClass="btn, btn-primary, btn-sm" onAction="#handleAdd"/>
                    <Button text="↻" styleClass="btn, btn-secondary, btn-sm" onAction="#handleRefresh"/>
                </HBox>
                <VBox styleClass="card-body" VBox.vgrow="ALWAYS">
                    <TableView fx:id="table" VBox.vgrow="ALWAYS" style="-fx-border-color:transparent;">
                        <columns><TableColumn fx:id="colJour" text="Jour" prefWidth="130"/>
        <TableColumn fx:id="colHeure" text="Heure" prefWidth="120"/>
        <TableColumn fx:id="colMedecin" text="Médecin" prefWidth="200"/>
        <TableColumn fx:id="colRecurrence" text="Récurrence" prefWidth="140"/>
        <TableColumn fx:id="colDisponibilite" text="Disponible" prefWidth="110"/></columns>
                        <placeholder><Label text="Aucune donnée" style="-fx-text-fill:#9ca3af;"/></placeholder>
                    </TableView>
                </VBox>
                <HBox style="-fx-padding:12 20;-fx-border-color:#e5e7eb;-fx-border-width:1 0 0 0;"
                      spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="statusLabel" text="" style="-fx-text-fill:#6b7280;-fx-font-size:12px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="✏️ Modifier" styleClass="btn, btn-warning, btn-sm" onAction="#handleEdit"/>
        <Button text="🗑 Supprimer" styleClass="btn, btn-danger, btn-sm" onAction="#handleDelete"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>

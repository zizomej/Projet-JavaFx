<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.learnhub.controller.student.StudentDemandesStageController"
           stylesheets="@/css/styles.css"
           prefWidth="1280" prefHeight="800">

    <BorderPane style="-fx-background-color: #f9fafb;">
        <top>
            <HBox styleClass="student-topbar" alignment="CENTER_LEFT" spacing="30">
                <VBox>
                    <Label text="🎓 LearnHub" style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-text-fill: #1e40af;"/>
                    <Label text="ESPACE ÉTUDIANT" style="-fx-font-size: 10px; -fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER">
                    <Button text="📊 Tableau de bord" styleClass="student-nav-btn" onAction="#goDashboard"/>
                    <Button text="📚 Mes Modules" styleClass="student-nav-btn" onAction="#goModules"/>
                    <Button text="📝 Mes Notes" styleClass="student-nav-btn" onAction="#goNotes"/>
                    <Button text="🗓 Emploi du Temps" styleClass="student-nav-btn" onAction="#goEmploi"/>
                    <Button text="💼 Stages" styleClass="student-nav-btn student-nav-active" onAction="#goOffresStage"/>
                    <Button text="✅ Présences" styleClass="student-nav-btn" onAction="#goPresences"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="15">
                    <Button text="🔔" style="-fx-background-color: transparent; -fx-font-size: 16px;"/>
                    <HBox alignment="CENTER" spacing="10">
                        <Label text="ET" styleClass="prof-user-avatar" style="-fx-background-color: #fbbf24;"/>
                        <VBox alignment="CENTER_LEFT">
                            <Label fx:id="topUserName" text="Étudiant" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                            <Label text="Étudiant LearnHub" style="-fx-text-fill: #6b7280; -fx-font-size: 10px;"/>
                        </VBox>
                    </HBox>
                    <Button text="🚪" style="-fx-background-color: transparent; -fx-cursor: hand;" onAction="#handleLogout"/>
                </HBox>
            </HBox>
        </top>

        <center>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <VBox spacing="20" style="-fx-padding: 30;">

                    <VBox style="-fx-background-color: #1e3a8a; -fx-background-radius: 12; -fx-padding: 24 30;" spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📋" style="-fx-font-size: 24px;"/>
                            <Label text="Mes demandes de stage" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                        </HBox>
                        <Label text="Suivez vos candidatures et gérez vos pièces jointes." style="-fx-text-fill: #bfdbfe; -fx-font-size: 14px;"/>
                        <Button text="← Voir les offres de stage" onAction="#goOffresStage"
                                style="-fx-background-color: #fbbf24; -fx-text-fill: #111827; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 16; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
                    </VBox>

                    <HBox spacing="20">
                        <VBox styleClass="student-dash-card" HBox.hgrow="ALWAYS" spacing="10">
                            <Label text="EN ATTENTE" style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <Label fx:id="enAttenteLabel" text="0" styleClass="student-dash-stat" style="-fx-font-size: 24px;"/>
                        </VBox>
                        <VBox styleClass="student-dash-card" HBox.hgrow="ALWAYS" spacing="10">
                            <Label text="ACCEPTÉES" style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <Label fx:id="accepteesLabel" text="0" styleClass="student-dash-stat" style="-fx-font-size: 24px;"/>
                        </VBox>
                        <VBox styleClass="student-dash-card" HBox.hgrow="ALWAYS" spacing="10">
                            <Label text="REFUSÉES" style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <Label fx:id="refuseesLabel" text="0" styleClass="student-dash-stat" style="-fx-font-size: 24px;"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="student-dash-card" spacing="0" style="-fx-padding: 0;">
                        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 16 20; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
                            <VBox HBox.hgrow="ALWAYS" spacing="2">
                                <Label text="Historique des candidatures" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                                <Label fx:id="statusLabel" text="" style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
                            </VBox>
                            <Button text="➕ Nouvelle demande" onAction="#openNewDemandeDialog"
                                    style="-fx-background-color: #fbbf24; -fx-text-fill: #111827; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 18; -fx-cursor: hand;"/>
                        </HBox>
                        <TableView fx:id="demandeTable" VBox.vgrow="ALWAYS" prefHeight="460" style="-fx-border-color: transparent;">
                            <columns>
                                <TableColumn fx:id="colId" text="ID" prefWidth="55"/>
                                <TableColumn fx:id="colOffre" text="Offre" prefWidth="230"/>
                                <TableColumn fx:id="colPartenaire" text="Partenaire" prefWidth="170"/>
                                <TableColumn fx:id="colDate" text="Date" prefWidth="120"/>
                                <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
                                <TableColumn fx:id="colCommentaire" text="Motivation / CV" prefWidth="220"/>
                            </columns>
                            <placeholder>
                                <Label text="Aucune demande pour le moment" style="-fx-text-fill:#9ca3af;"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>

    <StackPane fx:id="popupOverlay" visible="false" managed="false"
               style="-fx-background-color: rgba(0,0,0,0.55);">

        <VBox alignment="CENTER_LEFT" spacing="0"
              style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 28, 0, 0, 8);"
              maxWidth="600" minWidth="560">

            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: #1e3a8a; -fx-background-radius: 14 14 0 0; -fx-padding: 20 24;">
                <Label text="📋" style="-fx-font-size: 24px;"/>
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="Nouvelle demande de stage" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Remplissez le formulaire et joignez votre CV" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.85);"/>
                </VBox>
                <Button text="✕" onAction="#closeNewDemandeDialog"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand; -fx-border-width: 0; -fx-font-weight: bold;"/>
            </HBox>

            <VBox spacing="16" style="-fx-padding: 24;">
                <VBox spacing="6">
                    <Label text="🏢 Offre de stage *" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <ComboBox fx:id="offreCombo" promptText="Sélectionnez une offre de stage" maxWidth="Infinity"
                              style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 6;"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="✉ Lettre de motivation *" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <TextArea fx:id="motivationArea" promptText="Expliquez pourquoi vous postulez à cette offre…"
                              prefHeight="110" wrapText="true"
                              style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;"/>
                </VBox>
                <VBox spacing="8">
                    <Label text="📎 CV (PDF ou Word)" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button fx:id="cvUploadBtn" text="📁 Choisir un fichier CV" onAction="#handleCvUpload"
                                style="-fx-background-color: #eff6ff; -fx-text-fill: #1d4ed8; -fx-border-color: #93c5fd; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 18; -fx-font-size: 13px; -fx-cursor: hand; -fx-font-weight: bold;"/>
                        <Label fx:id="cvFileLabel" text="Aucun fichier sélectionné"
                               style="-fx-text-fill: #888; -fx-font-size: 12px; -fx-font-style: italic;"/>
                    </HBox>
                    <Label text="Formats acceptés : PDF, DOC, DOCX (max 5 Mo recommandé)"
                           style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;"/>
                </VBox>
                <Label fx:id="formErrorLabel" text="" visible="false" managed="false" wrapText="true"
                       maxWidth="Infinity"
                       style="-fx-background-color: #fef2f2; -fx-text-fill: #b91c1c; -fx-padding: 8 12; -fx-background-radius: 6; -fx-font-size: 12px;"/>
            </VBox>

            <HBox spacing="12" alignment="CENTER_RIGHT"
                  style="-fx-padding: 16 24 20 24; -fx-border-color: #f3f4f6; -fx-border-width: 1 0 0 0;">
                <Button text="Annuler" onAction="#closeNewDemandeDialog"
                        style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-border-color: #e5e7eb; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 22; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="✅ Soumettre ma candidature" onAction="#handleSubmitDemande"
                        style="-fx-background-color: #1e3a8a; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 22; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </StackPane>
</StackPane>

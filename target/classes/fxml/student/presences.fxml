<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.student.StudentDashboardController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="5">
                <Label text="🎓 LearnHub" styleClass="sidebar-brand-text"/>
                <Label text="Espace Étudiant" styleClass="sidebar-brand-sub"/>
            </VBox>
            <VBox spacing="2" style="-fx-padding:10 0;">
                <Label text="NAVIGATION" styleClass="nav-section-title"/>
                <Button text="🏠  Tableau de bord" styleClass="nav-btn"              onAction="#goDashboard" maxWidth="Infinity"/>
                <Button text="📚  Mes Modules"    styleClass="nav-btn" onAction="#goModules"   maxWidth="Infinity"/>
                <Button text="📊  Mes Notes"      styleClass="nav-btn"   onAction="#goNotes"     maxWidth="Infinity"/>
                <Button text="✅  Mes Présences"  styleClass="nav-btn, nav-btn-active" onAction="#goPresences" maxWidth="Infinity"/>
                <Button text="🗓  Emploi du temps" styleClass="nav-btn" onAction="#goEmploi"   maxWidth="Infinity"/>
                <Label text="MÉDICAL" styleClass="nav-section-title"/>
                <Button text="🏥  Mes RDV"        styleClass="nav-btn"     onAction="#goRdv"       maxWidth="Infinity"/>
                <Label text="CAMPUS" styleClass="nav-section-title"/>
                <Button text="💼  Stages"         styleClass="nav-btn"  onAction="#goStages"    maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox style="-fx-padding:8 0 0 0;-fx-border-color:rgba(255,255,255,0.12);-fx-border-width:1 0 0 0;">
                <Label fx:id="welcomeLabel" text="Étudiant"
                       style="-fx-text-fill:rgba(255,255,255,0.7);-fx-font-size:12px;-fx-padding:8 15 4 15;"/>
                <Button text="🚪  Déconnexion" styleClass="nav-logout" onAction="#handleLogout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:#f5f7fa;-fx-border-color:transparent;">
            <VBox styleClass="content-area" spacing="24">
                <VBox spacing="4">
                    <Label text="✅ Mes Présences" styleClass="page-title"/>
                    <Label text="Suivez votre taux de présence par module"   styleClass="page-subtitle"/>
                </VBox>
                <VBox styleClass="welcome-banner" spacing="10"
      style="-fx-background-color:linear-gradient(to bottom right,#1E3A8A,#0A1F44);">
    <HBox alignment="CENTER_LEFT" spacing="40">
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="6">
            <Label text="Présences" style="-fx-text-fill:rgba(255,255,255,0.75);-fx-font-size:13px;-fx-font-weight:bold;"/>
            <Label fx:id="presentsLabel" text="—" style="-fx-text-fill:white;-fx-font-size:40px;-fx-font-weight:900;"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="6">
            <Label text="Absences" style="-fx-text-fill:rgba(255,255,255,0.75);-fx-font-size:13px;-fx-font-weight:bold;"/>
            <Label fx:id="absentsLabel" text="—" style="-fx-text-fill:#FFC107;-fx-font-size:40px;-fx-font-weight:900;"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="6">
            <Label text="Retards" style="-fx-text-fill:rgba(255,255,255,0.75);-fx-font-size:13px;-fx-font-weight:bold;"/>
            <Label fx:id="retardsLabel" text="—" style="-fx-text-fill:#FF6F61;-fx-font-size:40px;-fx-font-weight:900;"/>
        </VBox>
    </HBox>
</VBox>
<VBox styleClass="card" VBox.vgrow="ALWAYS">
    <HBox styleClass="card-header" alignment="CENTER_LEFT">
        <Label text="✅ Détail des Présences" styleClass="card-header-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="moduleFilter" promptText="📚 Module" prefWidth="200" styleClass="filter-combo"/>
    </HBox>
    <VBox styleClass="card-body" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS" style="-fx-border-color:transparent;">
            <columns>
                <TableColumn fx:id="colModule" text="Module" prefWidth="220"/>
                <TableColumn fx:id="colSeance" text="Séance" prefWidth="180"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="130"/>
                <TableColumn fx:id="colStatut" text="Statut" prefWidth="130"/>
            </columns>
            <placeholder><Label text="Aucune présence enregistrée" style="-fx-text-fill:#9ca3af;"/></placeholder>
        </TableView>
    </VBox>
</VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

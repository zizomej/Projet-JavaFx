<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.professor.ProfessorModulesController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">

    <!-- TOP NAV -->
    <top>
        <HBox styleClass="prof-topnav" alignment="CENTER_LEFT" spacing="12">
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 40 0 0;">
                <Label text="🎓" style="-fx-font-size: 24px;"/>
                <Label text="LEARNHUB" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 900;"/>
                <Label text="ESPACE PROFESSEUR" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 11px; -fx-font-weight: bold;"/>
            </HBox>
            <HBox spacing="15" alignment="CENTER">
                <Button text="🏠 Tableau de bord" styleClass="prof-nav-btn" onAction="#goDashboard"/>
                <Button text="📚 Modules" style="-fx-background-color: #FFC107; -fx-text-fill: #0A1F44; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16;" onAction="#goModules"/>
                <Button text="📊 Notes" styleClass="prof-nav-btn" onAction="#goNotes"/>
                <Button text="🗓 Séances" styleClass="prof-nav-btn" onAction="#goSeances"/>
                <Button text="✔ Présences" styleClass="prof-nav-btn" onAction="#goPresences"/>
                <Button text="🎉 Événements" styleClass="prof-nav-btn" onAction="#goEvenements"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <VBox spacing="0" alignment="CENTER_RIGHT">
                    <Label fx:id="welcomeLabel" text="Professeur" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                    <Label text="Professeur" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 10px;"/>
                </VBox>
                <Label text="PR" styleClass="prof-user-avatar" style="-fx-min-width: 32px; -fx-min-height: 32px; -fx-max-width: 32px; -fx-max-height: 32px; -fx-font-size: 12px;"/>
                <Button text="🚪 Déconnexion" styleClass="prof-logout" onAction="#handleLogout"/>
            </HBox>
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f5f7fa; -fx-border-color: transparent;">
            <VBox styleClass="content-area" spacing="20">
                <!-- Header -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="📚 Modules &amp; Ressources" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #0A1F44;"/>
                        <Label text="Gérez vos modules et ajoutez des ressources pédagogiques" style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
                    </VBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="⬅ Retour" style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16;" onAction="#handleRetour"/>
                        <Button text="➕ Ajouter un module" style="-fx-background-color: #1E3A8A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16;" onAction="#handleAddModule"/>
                    </HBox>
                </HBox>

                <HBox spacing="20" VBox.vgrow="ALWAYS">
                    <!-- Liste des modules -->
                    <VBox HBox.hgrow="NEVER" prefWidth="300" spacing="10">
                        <Label text="📋 Liste des Modules" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-border-color: transparent transparent #e5e7eb transparent; -fx-padding: 0 0 10 0;"/>
                        <VBox fx:id="moduleListContainer" spacing="10"/>
                    </VBox>

                    <!-- Liste des ressources -->
                    <VBox HBox.hgrow="ALWAYS" spacing="10" style="-fx-background-color: transparent;">
                        <Label text="📂 Ressources du Module" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                        <Label text="Sélectionnez un module pour voir ses ressources" style="-fx-text-fill: #6b7280; -fx-font-size: 11px;"/>

                        <!-- Module Selected Header -->
                        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1E3A8A; -fx-padding: 12 20; -fx-background-radius: 8 8 0 0;">
                            <Label fx:id="selectedModuleLabel" text="Sélectionnez un module" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="➕ Ressource" style="-fx-background-color: #0A1F44; -fx-text-fill: white; -fx-font-size: 11px; -fx-background-radius: 15; -fx-padding: 4 12;" onAction="#handleAddRessource"/>
                        </HBox>

                        <VBox fx:id="ressourcesListContainer" spacing="1" style="-fx-background-color: #e5e7eb; -fx-border-color: #e5e7eb; -fx-border-radius: 0 0 8 8; -fx-background-radius: 0 0 8 8;"/>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

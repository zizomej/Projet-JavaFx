<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.professor.ProfessorModulesController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">

    <!-- TOP NAV -->
    <top>
        <HBox styleClass="prof-topnav" alignment="CENTER_LEFT" spacing="12">
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 40 0 0;">
                <Label text="🎓" style="-fx-font-size: 24px;"/>
                <Label text="LEARNHUB" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 900;"/>
                <Label text="ESPACE PROFESSEUR" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 11px; -fx-font-weight: bold;"/>
            </HBox>
            <HBox spacing="15" alignment="CENTER">
                <Button text="🏠 Tableau de bord" styleClass="prof-nav-btn" onAction="#goDashboard"/>
                <Button text="📚 Modules"     style="-fx-background-color: #FFC107; -fx-text-fill: #0A1F44; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16;" onAction="#goModules"/>
                <Button text="👥 Étudiants"   styleClass="prof-nav-btn"/>
                <Button text="📊 Notes"       styleClass="prof-nav-btn" onAction="#goNotes"/>
                <Button text="🗓 Séances"     styleClass="prof-nav-btn" onAction="#goSeances"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <VBox spacing="0" alignment="CENTER_RIGHT">
                    <Label fx:id="welcomeLabel" text="Prof. Hassan Alami" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                    <Label text="Professeur" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 10px;"/>
                </VBox>
                <Label text="HA" styleClass="prof-user-avatar" style="-fx-min-width: 32px; -fx-min-height: 32px; -fx-max-width: 32px; -fx-max-height: 32px; -fx-font-size: 12px;"/>
                <Button text="🚪 Déconnexion" styleClass="prof-logout" onAction="#handleLogout"/>
            </HBox>
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f5f7fa; -fx-border-color: transparent;">
            <VBox styleClass="content-area" spacing="20" style="-fx-padding: 30;">
                <!-- Header part -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <!-- Folder icon image or label -->
                            <Label text="📚" style="-fx-font-size: 28px;"/>
                            <Label text="Modules &amp; Ressources" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #0A1F44;"/>
                        </HBox>
                        <Label text="Gérez les modules et leurs ressources pédagogiques" style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>
                    </VBox>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Button text="✉ Envoyer Email aux Étudiants" style="-fx-background-color: linear-gradient(to right, #FF7E5F, #FEB47B); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-effect: dropshadow(gaussian, rgba(255,126,95,0.4), 8, 0, 0, 3);"/>
                        <Button text="➕ Ajouter un module" style="-fx-background-color: #1E3A8A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-effect: dropshadow(gaussian, rgba(30,58,138,0.4), 8, 0, 0, 3);" onAction="#handleAddModule"/>
                    </HBox>
                </HBox>
                
                <!-- Main Split Area -->
                <HBox spacing="25" VBox.vgrow="ALWAYS">
                    <!-- LEFT COLUMN: Modules List -->
                    <VBox prefWidth="320" minWidth="320" maxWidth="320" style="-fx-background-color: #fafafc; -fx-background-radius: 12; -fx-padding: 20; -fx-border-radius: 12; -fx-border-color: #e5e7eb; -fx-border-width: 1;">
                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 15 0;">
                            <Label text="📋 Liste des Modules" style="-fx-font-weight: 900; -fx-font-size: 16px; -fx-text-fill: #1f2937;"/>
                        </HBox>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                            <VBox fx:id="moduleListContainer" spacing="15" style="-fx-background-color: transparent;">
                                <!-- Module Cards injectées ici -->
                            </VBox>
                        </ScrollPane>
                    </VBox>
                    
                    <!-- RIGHT COLUMN: Ressources List -->
                    <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: #fafafc; -fx-background-radius: 12; -fx-padding: 25; -fx-border-radius: 12; -fx-border-color: #e5e7eb; -fx-border-width: 1;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📂 Toutes les Ressources" style="-fx-font-weight: 900; -fx-font-size: 18px; -fx-text-fill: #1f2937;"/>
                        </HBox>
                        <Label text="Liste de toutes les ressources pédagogiques" style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-padding: 0 0 10 0;"/>

                        <VBox fx:id="mainModulesContainer" spacing="25">
                            <!-- Section Module+Ressources injectées ici -->
                        </VBox>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

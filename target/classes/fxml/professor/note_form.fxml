<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.learnhub.controller.professor.NoteFormController"
      style="-fx-background-color: white; -fx-background-radius: 12;"
      prefWidth="550">

    <!-- Top Banner -->
    <VBox style="-fx-background-color: #0A1F44; -fx-padding: 20 24; -fx-background-radius: 12 12 0 0;" spacing="5">
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="➕ Ajouter une Note" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                <Label text="Saisissez une nouvelle note pour un étudiant" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12px;"/>
            </VBox>
            <Button text="✕" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 50; -fx-font-weight: bold; -fx-cursor: hand;" onAction="#handleClose"/>
        </HBox>
    </VBox>

    <VBox spacing="15" style="-fx-padding: 24;">
        
        <Label text="📋 Informations de l'évaluation" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A; -fx-font-size: 14px; -fx-border-color: transparent transparent #FFC107 transparent; -fx-padding: 0 0 6 0;"/>

        <HBox spacing="15">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Module *" style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 11px;"/>
                <ComboBox fx:id="cbModule" promptText="📚 Sélectionnez un module" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 3 0;" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Type de Note *" style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 11px;"/>
                <ComboBox fx:id="cbTypeNote" promptText="Sélectionnez un type" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 3 0;" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Coefficient *" style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 11px;"/>
                <TextField fx:id="tfCoefficient" promptText="1.0" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12;"/>
            </VBox>
        </HBox>

        <Label text="👨‍🎓 Saisie des notes (Laissez vide si absent/non noté)" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A; -fx-font-size: 14px; -fx-border-color: transparent transparent #FFC107 transparent; -fx-padding: 5 0 6 0;"/>

        <!-- Container for dynamically generated student rows -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: white;" prefHeight="300" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER">
            <VBox fx:id="studentsListContainer" spacing="10" style="-fx-padding: 10; -fx-background-color: white;"/>
        </ScrollPane>

        <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-margin-top: 10;">
            <Button text="✕ Annuler" style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;" onAction="#handleClose"/>
            <Button text="💾 Enregistrer les notes" style="-fx-background-color: #FFC107; -fx-text-fill: #0A1F44; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;" onAction="#handleSave"/>
        </HBox>
    </VBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.professor.ProfessorNotesController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">

    <top>
        <HBox styleClass="prof-topnav" alignment="CENTER_LEFT" spacing="12">
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 40 0 0;">
                <Label text="🎓" style="-fx-font-size: 24px;"/>
                <Label text="LEARNHUB" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 900;"/>
                <Label text="ESPACE PROFESSEUR" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 11px; -fx-font-weight: bold;"/>
            </HBox>
            <HBox spacing="15" alignment="CENTER">
                <Button text="🏠 Tableau de bord" styleClass="prof-nav-btn" onAction="#goDashboard"/>
                <Button text="📚 Modules"     styleClass="prof-nav-btn" onAction="#goModules"/>
                <Button text="👥 Étudiants"   styleClass="prof-nav-btn"/>
                <Button text="📊 Notes"       style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16;" onAction="#goNotes"/>
                <Button text="🗓 Séances"     styleClass="prof-nav-btn" onAction="#goSeances"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <VBox spacing="0" alignment="CENTER_RIGHT">
                    <Label fx:id="welcomeLabel" text="Prof. Hassan Alami" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                    <Label text="Professeur" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 10px;"/>
                </VBox>
                <Label text="HA" styleClass="prof-user-avatar" style="-fx-min-width: 32px; -fx-background-color: #f59e0b;"/>
                <Button text="🚪 Déconnexion" styleClass="prof-logout" onAction="#handleLogout"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f5f7fa; -fx-border-color: transparent;">
            <VBox styleClass="content-area" spacing="20">
                <!-- Page Banner -->
                <VBox style="-fx-background-color: #1E3A8A; -fx-background-radius: 12; -fx-padding: 24 30;">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox HBox.hgrow="ALWAYS" spacing="4">
                            <Label text="📊 Gestion des Notes" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                            <Label text="Saisie et suivi des évaluations" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12px;"/>
                        </VBox>
                        <Button text="➕ Nouvelle Note" style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20;" onAction="#handleAdd"/>
                    </HBox>
                </VBox>

                <!-- Search block -->
                <HBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 3);">
                    <TextField fx:id="searchField" promptText="🔍 Rechercher par module, étudiant..." style="-fx-background-color: transparent; -fx-font-size: 14px;" HBox.hgrow="ALWAYS"/>
                    <Button text="▼ Filtres" styleClass="btn, btn-secondary, btn-sm"/>
                </HBox>

                <!-- Stats summary -->
                <HBox spacing="20">
                    <VBox styleClass="stat-card" style="-fx-padding: 16;" HBox.hgrow="ALWAYS">
                        <Label text="TOTAL NOTES" style="-fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-font-size: 10px;"/>
                        <Label fx:id="totalNotesLabel" text="-" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #1E3A8A;"/>
                    </VBox>
                    <VBox styleClass="stat-card" style="-fx-padding: 16;" HBox.hgrow="ALWAYS">
                        <Label text="MODULES" style="-fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-font-size: 10px;"/>
                        <Label fx:id="totalModulesLabel" text="-" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #1E3A8A;"/>
                    </VBox>
                    <VBox styleClass="stat-card" style="-fx-padding: 16;" HBox.hgrow="ALWAYS">
                        <Label text="ÉTUDIANTS" style="-fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-font-size: 10px;"/>
                        <Label fx:id="totalStudentsLabel" text="-" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #1E3A8A;"/>
                    </VBox>
                </HBox>

                <!-- Accordion contenant les tables par module -->
                <Accordion fx:id="modulesAccordion"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

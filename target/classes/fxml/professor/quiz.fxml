<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.professor.QuizController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">

    <!-- TOP NAV -->
    <top>
        <HBox styleClass="prof-topnav" alignment="CENTER_LEFT" spacing="12">
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 40 0 0;">
                <Label text="🎓" style="-fx-font-size: 24px;"/>
                <Label text="LEARNHUB" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 900;"/>
                <Label text="ESPACE PROFESSEUR" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 11px; -fx-font-weight: bold;"/>
            </HBox>
            <HBox spacing="15" alignment="CENTER">
                <Button text="🏠 Tableau de bord" styleClass="prof-nav-btn" onAction="#goDashboard"/>
                <Button text="📚 Modules"     styleClass="prof-nav-btn" onAction="#goModules"/>
                <Button text="📝 Quiz"        style="-fx-background-color: #FFC107; -fx-text-fill: #0A1F44; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16;"/>
                <Button text="👥 Étudiants"   styleClass="prof-nav-btn"/>
                <Button text="📊 Notes"       styleClass="prof-nav-btn" onAction="#goNotes"/>
                <Button text="🗓 Séances"     styleClass="prof-nav-btn" onAction="#goSeances"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <VBox spacing="0" alignment="CENTER_RIGHT">
                    <Label text="Prof. Hassan Alami" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                    <Label text="Professeur" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 10px;"/>
                </VBox>
                <Label text="HA" styleClass="prof-user-avatar"/>
            </HBox>
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f5f7fa; -fx-border-color: transparent;">
            <VBox styleClass="content-area" spacing="20" style="-fx-padding: 30;">
                <!-- Header part -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📝" style="-fx-font-size: 28px;"/>
                            <Label text="Gestion des Quiz" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #0A1F44;"/>
                        </HBox>
                        <Label text="Créez et gérez les quiz interactifs avec ou non des délais pour vos étudiants." style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>
                    </VBox>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Button text="➕ Créer un Quiz" style="-fx-background-color: #1E3A8A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20;" onAction="#handleAddQuiz"/>
                    </HBox>
                </HBox>
                
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #e5e7eb; -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="Sélectionnez un Module :" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <ComboBox fx:id="moduleComboBox" prefWidth="250" styleClass="form-control"/>
                    </HBox>

                    <TableView fx:id="quizTable" VBox.vgrow="ALWAYS" styleClass="table-view" prefHeight="400">
                        <columns>
                            <TableColumn fx:id="colTitre" text="Titre du Quiz" prefWidth="300" />
                            <TableColumn fx:id="colDeadline" text="Deadline" prefWidth="200" />
                            <TableColumn fx:id="colVisible" text="Visible" prefWidth="100" style="-fx-alignment: center;"/>
                            <TableColumn fx:id="colActions" text="Actions" prefWidth="100" style="-fx-alignment: center;"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.learnhub.controller.professor.RessourceFormController"
      style="-fx-background-color: white; -fx-background-radius: 12;"
      prefWidth="500">

    <!-- Top Banner -->
    <VBox style="-fx-background-color: linear-gradient(to right, #FFC107, #FF6F61); -fx-padding: 20 24; -fx-background-radius: 12 12 0 0;" spacing="5">
        <HBox alignment="CENTER_LEFT">
            <Label text="📂 Nouvelle Ressource" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="✕" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 50; -fx-font-weight: bold; -fx-cursor: hand;" onAction="#handleClose"/>
        </HBox>
        <Label fx:id="moduleNameLabel" text="Module: —" style="-fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold;"/>
    </VBox>

    <VBox spacing="20">
        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

        <VBox spacing="6">
            <Label text="Titre de la ressource *" style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 12px;"/>
            <TextField fx:id="tfTitre" promptText="Ex: Cours d'introduction" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12;"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Type de ressource *" style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 12px;"/>
            <ComboBox fx:id="cbType" promptText="Sélectionnez un type" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 4 0;" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="6">
            <Label text="📄 Fichier à uploader *" style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 12px;"/>
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-border-color: #FFC107; -fx-border-width: 1; -fx-border-style: dashed; -fx-border-radius: 8; -fx-background-color: rgba(255,193,7,0.05); -fx-padding: 12 16;">
                <Button text="Choisir un fichier" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand;" onAction="#handleChooseFile"/>
                <Label fx:id="fileNameLabel" text="Aucun fichier choisi" style="-fx-text-fill: #6b7280;"/>
            </HBox>
            <Label text="Formats acceptés : PDF, Word, Excel, PowerPoint, Images, Vidéos (max 50MB)" style="-fx-text-fill: #9ca3af; -fx-font-size: 10px;"/>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 12 16;">
            <CheckBox fx:id="chkPublic" text="Ressource visible publiquement" style="-fx-text-fill: #1E3A8A; -fx-font-weight: bold;"/>
        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-padding: 10 0 0 0;">
            <Button text="← Annuler" style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;" onAction="#handleClose"/>
            <Button text="✅ Enregistrer" style="-fx-background-color: #FF6F61; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;" onAction="#handleSave"/>
        </HBox>
    </VBox>
</VBox>

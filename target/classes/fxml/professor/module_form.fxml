<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.learnhub.controller.professor.ModuleFormController"
      style="-fx-background-color: white; -fx-background-radius: 12;"
      prefWidth="500">

    <!-- Top Banner -->
    <VBox style="-fx-background-color: #0A1F44; -fx-padding: 20 24; -fx-background-radius: 12 12 0 0;" spacing="5">
        <HBox alignment="CENTER_LEFT">
            <Label text="➕ Nouveau Module" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="✕" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 50; -fx-font-weight: bold; -fx-cursor: hand;" onAction="#handleClose"/>
        </HBox>
    </VBox>

    <VBox spacing="20">
        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

        <Label text="📋 Informations Générales" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A; -fx-font-size: 14px; -fx-border-color: transparent transparent #FFC107 transparent; -fx-padding: 0 0 6 0;"/>

        <HBox spacing="15">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Code du module *" style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 11px;"/>
                <TextField fx:id="tfCode" promptText="Ex: INF501" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12;"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Filière *" style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 11px;"/>
                <ComboBox fx:id="cbFiliere" promptText="Sélectionnez une filière" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 3 0;" maxWidth="Infinity"/>
            </VBox>
        </HBox>

        <VBox spacing="6">
            <Label text="Intitulé *" style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 11px;"/>
            <TextField fx:id="tfIntitule" promptText="Ex: Intelligence Artificielle" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12;"/>
        </VBox>

        <Label text="⚙ Configuration Académique" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A; -fx-font-size: 14px; -fx-border-color: transparent transparent #FFC107 transparent; -fx-padding: 10 0 6 0;"/>

        <HBox spacing="15">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Semestre *" style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 11px;"/>
                <TextField fx:id="tfSemestre" promptText="Ex: 1" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12;"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Crédits *" style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 11px;"/>
                <TextField fx:id="tfCredits" promptText="1-10" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12;"/>
            </VBox>
        </HBox>

        <VBox spacing="6">
            <Label text="Responsable *" style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 11px;"/>
            <ComboBox fx:id="cbResponsable" promptText="Sélectionnez un responsable" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 3 0;" maxWidth="Infinity"/>
        </VBox>

        <HBox alignment="CENTER" spacing="12" style="-fx-background-color: #f9fafb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16;">
            <Button text="← Annuler" style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;" onAction="#handleClose"/>
            <Button text="✅ Enregistrer" style="-fx-background-color: #1E3A8A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;" onAction="#handleSave"/>
        </HBox>
    </VBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.DashboardController">
    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="250.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <!-- Logo area -->
            <VBox alignment="CENTER" prefHeight="100.0">
                <Label text="LearnHub" textFill="WHITE">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
            </VBox>
            
            <!-- Navigation Menu -->
            <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                <Button maxWidth="Infinity" styleClass="sidebar-btn, sidebar-btn-active" text="📊 Dashboard" />
                <Button maxWidth="Infinity" styleClass="sidebar-btn" text="👥 Utilisateurs" onAction="#goToUtilisateurs" />
                <Button maxWidth="Infinity" styleClass="sidebar-btn" text="🏫 Universités" onAction="#goToUniversites" />
                <Button maxWidth="Infinity" styleClass="sidebar-btn" text="📁 Filières" />
                <Button maxWidth="Infinity" styleClass="sidebar-btn" text="🧩 Modules" />
                <Button maxWidth="Infinity" styleClass="sidebar-btn" text="🗓 Séances" />
                <Button maxWidth="Infinity" styleClass="sidebar-btn" text="📝 Notes" />
                <Button maxWidth="Infinity" styleClass="sidebar-btn" text="💼 Offres de Stage" />
                <Button maxWidth="Infinity" styleClass="sidebar-btn" text="📋 Demandes de Stage" />
                <Button maxWidth="Infinity" styleClass="sidebar-btn" text="🤝 Partenaires" />
                <Button maxWidth="Infinity" styleClass="sidebar-btn" text="🏥 RDV Médicaux" />
            </VBox>
            
            <!-- User Profile Area at bottom -->
            <VBox alignment="CENTER" prefHeight="120.0" spacing="10.0" style="-fx-background-color: #151a2b; -fx-padding: 10;">
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 0 0 0 10;">
                    <StackPane>
                        <Circle fill="#ff9800" radius="18.0" />
                        <Label text="AD" textFill="WHITE" style="-fx-font-weight: bold;"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT">
                        <Label text="Admin Principal" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                        <Label text="admin@learnhub.tn" textFill="#a0aabf" style="-fx-font-size: 11px;"/>
                    </VBox>
                </HBox>
                <Button text="Déconnexion" maxWidth="Infinity" style="-fx-background-color: #293047; -fx-text-fill: white; -fx-background-radius: 5; margin: 10;" />
            </VBox>
        </VBox>
    </left>
    
    <!-- MAIN CONTENT AREA -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f4f5f7; -fx-border-color: transparent;">
            <VBox spacing="20.0" style="-fx-background-color: #f4f5f7; -fx-padding: 20 30 20 30;">
                
                <!-- Top Header -->
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <VBox>
                        <Label text="Dashboard" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a2238;" />
                        <Label text="Bienvenue sur votre tableau de bord" textFill="#7a7a7a" />
                    </VBox>
                    <Pane HBox.hgrow="ALWAYS" />
                    <TextField promptText="Rechercher..." prefWidth="250.0" styleClass="search-field" />
                    <StackPane><Circle fill="WHITE" radius="18.0" style="-fx-stroke: #e0e0e0;" /><Label text="🔔" /><Circle fill="RED" radius="5.0" StackPane.alignment="TOP_RIGHT" /></StackPane>
                    <StackPane><Circle fill="WHITE" radius="18.0" style="-fx-stroke: #e0e0e0;" /><Label text="⚙" /></StackPane>
                </HBox>
                
                <!-- Header Card -->
                <HBox alignment="CENTER_LEFT" styleClass="dashboard-card">
                    <VBox spacing="5.0">
                        <Label text="📊 Tableau de Bord" style="-fx-font-size: 24px; -fx-font-weight: bold;" textFill="#1a2238"/>
                        <Label text="Bienvenue sur votre tableau de bord LearnHub" textFill="#888888" />
                    </VBox>
                    <Pane HBox.hgrow="ALWAYS" />
                    <Label text="📅 Thursday 09 April 2026" style="-fx-background-color: #f0f4f8; -fx-padding: 10 20; -fx-background-radius: 20; -fx-text-fill: #333;" />
                </HBox>
                
                <!-- Top 4 Summary Cards -->
                <HBox spacing="20.0">
                    <!-- Utilisateurs Card -->
                    <VBox styleClass="dashboard-card" spacing="10.0" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT"><Label text="👥" style="-fx-font-size:30; -fx-text-fill: #8338ec;" /><Pane HBox.hgrow="ALWAYS"/><Label text="↗ 12" styleClass="subcard-green" textFill="#388e3c" /></HBox>
                        <Label fx:id="lblTotalUtilisateurs" text="0" style="-fx-font-weight: bold; -fx-font-size: 36px; -fx-text-fill: #1a2238;" />
                        <Label text="Utilisateurs" textFill="#888888" />
                        <VBox spacing="5.0" style="-fx-padding: 10 0 0 0;">
                            <Label fx:id="lblEtudiantsList" text="0 Étudiants" style="-fx-font-size: 12px; -fx-text-fill: #555;" graphicTextGap="5"><graphic><Label text="🎓" /></graphic></Label>
                            <Label fx:id="lblProfsList" text="0 Professeurs" style="-fx-font-size: 12px; -fx-text-fill: #555;" graphicTextGap="5"><graphic><Label text="👨‍🏫" /></graphic></Label>
                            <Label fx:id="lblMedecinsList" text="0 Médecins" style="-fx-font-size: 12px; -fx-text-fill: #555;" graphicTextGap="5"><graphic><Label text="⚕" /></graphic></Label>
                        </VBox>
                    </VBox>
                    
                    <!-- Universités Card -->
                    <VBox styleClass="dashboard-card" spacing="10.0" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT"><Label text="🏫" style="-fx-font-size:30; -fx-text-fill: #f7941d;" /><Pane HBox.hgrow="ALWAYS"/><Label text="↗ 4" styleClass="subcard-green" textFill="#388e3c" /></HBox>
                        <Label fx:id="lblTotalUniversites" text="0" style="-fx-font-weight: bold; -fx-font-size: 36px; -fx-text-fill: #1a2238;" />
                        <Label text="Universités" textFill="#888888" />
                        <VBox spacing="5.0" style="-fx-padding: 10 0 0 0;">
                            <Label text="Plateforme" style="-fx-font-size: 12px; -fx-text-fill: #555;" graphicTextGap="5"><graphic><Label text="💻" /></graphic></Label>
                            <Label text="E-Learning" style="-fx-font-size: 12px; -fx-text-fill: #555;" graphicTextGap="5"><graphic><Label text="🌐" /></graphic></Label>
                        </VBox>
                    </VBox>

                    <!-- Modules Card -->
                    <VBox styleClass="dashboard-card" spacing="10.0" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT"><Label text="📚" style="-fx-font-size:30; -fx-text-fill: #1a56db;" /><Pane HBox.hgrow="ALWAYS"/><Label text="↗ 2" styleClass="subcard-green" textFill="#388e3c" /></HBox>
                        <Label fx:id="lblModules" text="0" style="-fx-font-weight: bold; -fx-font-size: 36px; -fx-text-fill: #1a2238;" />
                        <Label text="Modules actifs" textFill="#888888" />
                        <VBox spacing="5.0" style="-fx-padding: 10 0 0 0;">
                            <Label text="2 Ressources" style="-fx-font-size: 12px; -fx-text-fill: #555;" graphicTextGap="5"><graphic><Label text="📑" /></graphic></Label>
                            <Label text="6 Notes" style="-fx-font-size: 12px; -fx-text-fill: #555;" graphicTextGap="5"><graphic><Label text="📝" /></graphic></Label>
                        </VBox>
                    </VBox>

                    <!-- Filières Card -->
                    <VBox styleClass="dashboard-card" spacing="10.0" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT"><Label text="🎓" style="-fx-font-size:30; -fx-text-fill: #1a2238;" /><Pane HBox.hgrow="ALWAYS"/><Label text="↗ 4" styleClass="subcard-green" textFill="#388e3c" /></HBox>
                        <Label fx:id="lblFilieres" text="0" style="-fx-font-weight: bold; -fx-font-size: 36px; -fx-text-fill: #1a2238;" />
                        <Label text="Filières" textFill="#888888" />
                        <VBox spacing="5.0" style="-fx-padding: 10 0 0 0;">
                            <Label text="Programmes" style="-fx-font-size: 12px; -fx-text-fill: #555;" graphicTextGap="5"><graphic><Label text="📊" /></graphic></Label>
                            <Label text="Formations" style="-fx-font-size: 12px; -fx-text-fill: #555;" graphicTextGap="5"><graphic><Label text="📕" /></graphic></Label>
                        </VBox>
                    </VBox>
                </HBox>
                
                <!-- Middle Section: Performances & Repartition -->
                <HBox spacing="20.0">
                    <!-- Performances Academiques -->
                    <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS" spacing="15.0" prefWidth="600.0">
                        <Label text="📈 Performances Académiques" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                        <Label text="Statistiques des notes ce semestre" textFill="#888888" style="-fx-font-size: 11px;"/>
                        
                        <!-- Progress Bars -->
                        <VBox spacing="10.0">
                            <HBox><Label text="Excellent (≥ 16)" textFill="#555" /><Pane HBox.hgrow="ALWAYS" /><Label text="33% • 2 notes" style="-fx-font-weight:bold;" /></HBox>
                            <ProgressBar progress="0.33" prefWidth="800.0" prefHeight="10.0" styleClass="progress-bar-green" maxWidth="Infinity" />
                            
                            <HBox><Label text="Bien (12-16)" textFill="#555" /><Pane HBox.hgrow="ALWAYS" /><Label text="33% • 2 notes" style="-fx-font-weight:bold;" /></HBox>
                            <ProgressBar progress="0.33" prefWidth="800.0" prefHeight="10.0" styleClass="progress-bar-blue" maxWidth="Infinity" />
                            
                            <HBox><Label text="Passable (10-12)" textFill="#555" /><Pane HBox.hgrow="ALWAYS" /><Label text="0% • 0 notes" style="-fx-font-weight:bold;" /></HBox>
                            <ProgressBar progress="0.0" prefWidth="800.0" prefHeight="10.0" styleClass="progress-bar-red" maxWidth="Infinity" />
                            
                            <HBox><Label text="Insuffisant (&lt; 10)" textFill="#555" /><Pane HBox.hgrow="ALWAYS" /><Label text="33% • 2 notes" style="-fx-font-weight:bold;" /></HBox>
                            <ProgressBar progress="0.33" prefWidth="800.0" prefHeight="10.0" styleClass="progress-bar-red" maxWidth="Infinity" />
                        </VBox>
                        
                        <HBox alignment="CENTER" style="-fx-background-color: #f9f9f9; -fx-padding: 15; -fx-background-radius: 10;">
                            <Label text="Moyenne générale : " style="-fx-font-weight:bold; -fx-font-size: 16px;" textFill="#555" />
                            <Pane HBox.hgrow="ALWAYS"/>
                            <Label text="12.83 / 20" style="-fx-font-weight:bold; -fx-font-size: 18px;" textFill="#0BB177" />
                        </HBox>
                    </VBox>

                    <!-- Repartition -->
                    <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS" spacing="15.0" prefWidth="500.0">
                        <Label text="👥 Répartition des Utilisateurs" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                        <Label text="Par rôle" textFill="#888888" style="-fx-font-size: 11px;"/>
                        
                        <HBox alignment="CENTER" spacing="40.0" VBox.vgrow="ALWAYS">
                            <StackPane>
                                <Circle radius="60.0" styleClass="donut-circle" />
                                <Label text="100%" style="-fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: #1a2238;" />
                            </StackPane>
                            <VBox spacing="10.0" alignment="CENTER_LEFT">
                                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="subcard-green" prefWidth="200.0">
                                    <Label text="🎓" style="-fx-font-size: 18px;" />
                                    <VBox>
                                        <Label fx:id="lblEtuStat" text="0" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                                        <Label text="Étudiants" textFill="#555" style="-fx-font-size: 11px;" />
                                    </VBox>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="subcard-red" prefWidth="200.0">
                                    <Label text="👨‍🏫" style="-fx-font-size: 18px;" />
                                    <VBox>
                                        <Label fx:id="lblProfStat" text="0" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                                        <Label text="Professeurs" textFill="#555" style="-fx-font-size: 11px;" />
                                    </VBox>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="subcard-yellow" prefWidth="200.0">
                                    <Label text="⚕" style="-fx-font-size: 18px;" />
                                    <VBox>
                                        <Label fx:id="lblMedStat" text="0" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                                        <Label text="Médecins" textFill="#555" style="-fx-font-size: 11px;" />
                                    </VBox>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- 3rd Section: Actifs and Ressources -->
                <HBox spacing="20.0">
                    <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS" spacing="15.0" prefWidth="600.0">
                        <HBox>
                            <VBox><Label text="📚 Modules &amp; Ressources" style="-fx-font-size: 18px; -fx-font-weight: bold;" /><Label text="Vue d'ensemble" textFill="#888888" style="-fx-font-size: 11px;"/></VBox>
                            <Pane HBox.hgrow="ALWAYS"/><Label text="Gérer →" textFill="#1a56db" style="-fx-cursor: hand;" />
                        </HBox>
                        <HBox spacing="10.0">
                            <VBox alignment="CENTER" style="-fx-background-color: #2b5c9c; -fx-background-radius: 10;" HBox.hgrow="ALWAYS" prefHeight="80.0">
                                <Label text="2" style="-fx-font-weight: bold; -fx-font-size: 24px;" textFill="WHITE"/>
                                <Label text="Modules" textFill="WHITE" style="-fx-font-size: 12px;"/>
                            </VBox>
                            <VBox alignment="CENTER" style="-fx-background-color: #f7941d; -fx-background-radius: 10;" HBox.hgrow="ALWAYS" prefHeight="80.0">
                                <Label text="4" style="-fx-font-weight: bold; -fx-font-size: 24px;" textFill="WHITE"/>
                                <Label text="Ressources" textFill="WHITE" style="-fx-font-size: 12px;"/>
                            </VBox>
                        </HBox>
                        <VBox spacing="15.0" style="-fx-padding: 10 0 0 0;">
                            <HBox><Circle radius="4" fill="#0bb177"/><Label text="  Notes totales" textFill="#555"/><Pane HBox.hgrow="ALWAYS"/><Label text="6" style="-fx-font-weight: bold;"/></HBox>
                            <HBox><Circle radius="4" fill="#ffc107"/><Label text="  Moyenne générale" textFill="#555"/><Pane HBox.hgrow="ALWAYS"/><Label text="12.83/20" style="-fx-font-weight: bold;"/></HBox>
                            <HBox><Circle radius="4" fill="#0bb177"/><Label text="  Filières" textFill="#555"/><Pane HBox.hgrow="ALWAYS"/><Label text="4" style="-fx-font-weight: bold;"/></HBox>
                        </VBox>
                    </VBox>
                    
                    <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS" spacing="15.0" prefWidth="500.0">
                        <HBox>
                            <VBox><Label text="👤 Utilisateurs Actifs" style="-fx-font-size: 18px; -fx-font-weight: bold;" /><Label text="État des comptes" textFill="#888888" style="-fx-font-size: 11px;"/></VBox>
                            <Pane HBox.hgrow="ALWAYS"/><Label text="Voir tout →" textFill="#1a56db" style="-fx-cursor: hand;" />
                        </HBox>
                        <HBox spacing="10.0">
                            <VBox styleClass="subcard-green" HBox.hgrow="ALWAYS" alignment="CENTER" prefHeight="60.0">
                                <HBox alignment="CENTER" spacing="10"><Label text="✅"/><VBox><Label fx:id="lblActifs" text="0" style="-fx-font-weight: bold; -fx-font-size: 18px;"/><Label text="Actifs" style="-fx-font-size:10px;"/></VBox></HBox>
                            </VBox>
                            <VBox styleClass="subcard-yellow" HBox.hgrow="ALWAYS" alignment="CENTER" prefHeight="60.0">
                                <HBox alignment="CENTER" spacing="10"><Label text="⏸"/><VBox><Label fx:id="lblInactifs" text="0" style="-fx-font-weight: bold; -fx-font-size: 18px;"/><Label text="Inactifs" style="-fx-font-size:10px;"/></VBox></HBox>
                            </VBox>
                            <VBox styleClass="subcard-blue" HBox.hgrow="ALWAYS" alignment="CENTER" prefHeight="60.0">
                                <HBox alignment="CENTER" spacing="10"><Label text="📊"/><VBox><Label fx:id="lblTotalActifs" text="0" style="-fx-font-weight: bold; -fx-font-size: 18px;"/><Label text="Total" style="-fx-font-size:10px;"/></VBox></HBox>
                            </VBox>
                        </HBox>
                        <VBox spacing="15.0" style="-fx-padding: 10 0 0 0;">
                            <HBox><Label text="🎓" /><Label text="  Étudiants" textFill="#555"/><Pane HBox.hgrow="ALWAYS"/><Label fx:id="lblEtuStat" text="0" style="-fx-font-weight: bold;"/></HBox>
                            <HBox><Label text="👨‍🏫" /><Label text="  Professeurs" textFill="#555"/><Pane HBox.hgrow="ALWAYS"/><Label fx:id="lblProfStat" text="0" style="-fx-font-weight: bold;"/></HBox>
                            <HBox><Label text="⚕" /><Label text="  Médecins" textFill="#555"/><Pane HBox.hgrow="ALWAYS"/><Label fx:id="lblMedStat" text="0" style="-fx-font-weight: bold;"/></HBox>
                        </VBox>
                    </VBox>
                </HBox>

                <!-- Bottom Section: Acces Rapides -->
                <VBox styleClass="dashboard-card" spacing="15.0">
                    <Label text="🚀 Accès Rapides" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                    <HBox spacing="15.0" alignment="CENTER">
                        <VBox styleClass="quick-access-btn" prefWidth="100.0"><Label text="👥" style="-fx-font-size: 30; -fx-text-fill: #8338ec;"/><Label text="Utilisateurs" style="-fx-font-weight: bold; -fx-font-size: 11px;"/></VBox>
                        <VBox styleClass="quick-access-btn" prefWidth="100.0"><Label text="🏫" style="-fx-font-size: 30; -fx-text-fill: #f7941d;"/><Label text="Universités" style="-fx-font-weight: bold; -fx-font-size: 11px;"/></VBox>
                        <VBox styleClass="quick-access-btn" prefWidth="100.0"><Label text="🎓" style="-fx-font-size: 30; -fx-text-fill: #1a2238;"/><Label text="Filières" style="-fx-font-weight: bold; -fx-font-size: 11px;"/></VBox>
                        <VBox styleClass="quick-access-btn" prefWidth="100.0"><Label text="📚" style="-fx-font-size: 30; -fx-text-fill: #1a56db;"/><Label text="Modules" style="-fx-font-weight: bold; -fx-font-size: 11px;"/></VBox>
                        <VBox styleClass="quick-access-btn" prefWidth="100.0"><Label text="📝" style="-fx-font-size: 30; -fx-text-fill: #0bb177;"/><Label text="Notes" style="-fx-font-weight: bold; -fx-font-size: 11px;"/></VBox>
                        <VBox styleClass="quick-access-btn" prefWidth="100.0"><Label text="📅" style="-fx-font-size: 30; -fx-text-fill: #00bcd4;"/><Label text="Séances" style="-fx-font-weight: bold; -fx-font-size: 11px;"/></VBox>
                        <VBox styleClass="quick-access-btn" prefWidth="100.0"><Label text="🤝" style="-fx-font-size: 30; -fx-text-fill: #f7941d;"/><Label text="Partenaires" style="-fx-font-weight: bold; -fx-font-size: 11px;"/></VBox>
                        <VBox styleClass="quick-access-btn" prefWidth="100.0"><Label text="🏥" style="-fx-font-size: 30; -fx-text-fill: #ef3c42;"/><Label text="RDV Médicaux" style="-fx-font-weight: bold; -fx-font-size: 11px;"/></VBox>
                        <VBox styleClass="quick-access-btn" prefWidth="100.0"><Label text="🎉" style="-fx-font-size: 30; -fx-text-fill: #8338ec;"/><Label text="Événements" style="-fx-font-weight: bold; -fx-font-size: 11px;"/></VBox>
                        <VBox styleClass="quick-access-btn" prefWidth="100.0"><Label text="🏢" style="-fx-font-size: 30; -fx-text-fill: #555555;"/><Label text="Lieux" style="-fx-font-weight: bold; -fx-font-size: 11px;"/></VBox>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

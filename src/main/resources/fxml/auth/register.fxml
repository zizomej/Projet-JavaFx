<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.auth.RegisterController"
            stylesheets="@/css/styles.css"
            prefWidth="1280.0" prefHeight="800.0">

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f5f7fa; -fx-border-color: transparent;">
            <VBox alignment="CENTER" style="-fx-background-color: #f5f7fa;" spacing="30.0">

                <VBox styleClass="card" spacing="0.0" maxWidth="550.0">

                    <HBox styleClass="card-header" alignment="CENTER">
                        <Label text="🎓 LearnHub" styleClass="card-header-title"/>
                    </HBox>

                    <VBox styleClass="card-body" spacing="20.0">

                        <VBox spacing="4.0" alignment="CENTER">
                            <Label text="Créer un compte" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                            <Label text="Inscrivez-vous sur notre plateforme éducative" style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                        </VBox>

                        <HBox spacing="20.0" alignment="CENTER">
                            <Label text="1. Type de compte" styleClass="step-label"/>
                            <Label text="2. Informations" styleClass="step-label"/>
                            <Label text="3. Coordonnées" styleClass="step-label"/>
                        </HBox>

                        <VBox spacing="8.0">
                            <Label text="Type de compte" styleClass="form-label"/>
                            <HBox spacing="20.0">
                                <RadioButton fx:id="etudiantRadio" text="Étudiant" selected="true">
                                    <toggleGroup>
                                        <ToggleGroup fx:id="accountTypeGroup"/>
                                    </toggleGroup>
                                </RadioButton>
                                <RadioButton fx:id="professeurRadio" text="Professeur" toggleGroup="$accountTypeGroup"/>
                                <RadioButton fx:id="adminRadio" text="Administrateur" toggleGroup="$accountTypeGroup"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="8.0">
                            <Label text="Informations personnelles" styleClass="form-label"/>
                            <GridPane hgap="15.0" vgap="12.0">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50.0"/>
                                    <ColumnConstraints percentWidth="50.0"/>
                                </columnConstraints>

                                <Label text="Nom" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <TextField fx:id="nomField" promptText="Votre nom" styleClass="form-control"
                                           prefHeight="40.0" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                                <Label text="Prénom" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <TextField fx:id="prenomField" promptText="Votre prénom" styleClass="form-control"
                                           prefHeight="40.0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="CIN" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <TextField fx:id="cinField" promptText="Numéro CIN" styleClass="form-control"
                                           prefHeight="40.0" GridPane.columnIndex="0" GridPane.rowIndex="3"/>

                                <Label text="Téléphone" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                <TextField fx:id="telephoneField" promptText="+216 XX XXX XXX" styleClass="form-control"
                                           prefHeight="40.0" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                            </GridPane>
                        </VBox>

                        <VBox fx:id="filiereContainer" spacing="8.0">
                            <Label text="Filière *(Obligatoire pour les étudiants)" styleClass="form-label"/>
                            <ComboBox fx:id="filiereCombo" promptText="Sélectionnez votre filière"
                                      styleClass="form-control" prefHeight="40.0" maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="8.0">
                            <Label text="Coordonnées" styleClass="form-label"/>

                            <VBox spacing="6.0">
                                <Label text="Email" styleClass="form-label"/>
                                <TextField fx:id="emailField" promptText="exemple@learnhub.tn"
                                           styleClass="form-control" prefHeight="40.0"/>
                            </VBox>

                            <VBox spacing="6.0">
                                <Label text="Mot de passe" styleClass="form-label"/>
                                <PasswordField fx:id="passwordField" promptText="••••••••"
                                               styleClass="form-control" prefHeight="40.0"/>
                            </VBox>

                            <VBox spacing="6.0">
                                <Label text="Confirmer le mot de passe" styleClass="form-label"/>
                                <PasswordField fx:id="confirmPasswordField" promptText="••••••••"
                                               styleClass="form-control" prefHeight="40.0"/>
                            </VBox>
                        </VBox>

                        <Label fx:id="errorLabel" styleClass="alert-danger" wrapText="true"
                               managed="false" visible="false"/>

                        <HBox spacing="15.0" alignment="CENTER">
                            <Button text="← Précédent" styleClass="btn-outline"
                                    onAction="#previousStep" prefHeight="40.0" prefWidth="120.0"/>
                            <Button text="S'inscrire" styleClass="btn-primary"
                                    fx:id="registerButton" onAction="#handleRegister"
                                    prefHeight="40.0" prefWidth="120.0"/>
                        </HBox>

                        <Separator styleClass="custom-separator"/>

                        <HBox alignment="CENTER" spacing="5.0">
                            <Label text="Vous avez déjà un compte ?" style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
                            <Button text="Se connecter" styleClass="auth-link" onAction="#goToLogin"/>
                        </HBox>

                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
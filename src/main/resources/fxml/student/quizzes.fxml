<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.student.StudentQuizzesController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800"
            style="-fx-background-color: #f9fafb;">

    <!-- TOPBAR -->
    <top>
        <HBox styleClass="student-topbar" alignment="CENTER_LEFT" spacing="30" style="-fx-background-color: white; -fx-padding: 14 32;">
            <VBox>
                <Label text="🎓 LearnHub" style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-text-fill: #1e40af;"/>
                <Label text="ESPACE ÉTUDIANT" style="-fx-font-size: 10px; -fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="10" alignment="CENTER">
                <Button text="📊 Tableau de bord" styleClass="student-nav-btn" onAction="#goDashboard"/>
                <Button text="📚 Mes Modules" styleClass="student-nav-btn" onAction="#goModules"/>
                <Button text="📝 Quizzes" style="-fx-text-fill: #1e40af; -fx-font-weight: bold; -fx-background-color: #e0e7ff; -fx-background-radius: 8; -fx-padding: 8 16;"/>
                <Button text="📝 Mes Notes" styleClass="student-nav-btn" onAction="#goNotes"/>
                <Button text="🗓 Emploi du Temps" styleClass="student-nav-btn" onAction="#goEmploi"/>
                <Button text="💼 Stages" styleClass="student-nav-btn" onAction="#goStages"/>
                <Button text="✅ Présences" styleClass="student-nav-btn" onAction="#goPresences"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="15">
                <Button text="🚪" style="-fx-background-color: transparent; -fx-cursor: hand;" onAction="#handleLogout"/>
            </HBox>
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 30;">
                <VBox style="-fx-background-color: #1e3a8a; -fx-background-radius: 12; -fx-padding: 24 30;" spacing="5">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📝" style="-fx-font-size: 24px;"/>
                        <Label text="Mes Quizzes" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    </HBox>
                    <Label text="Participez aux tests interactifs proposés par vos professeurs." style="-fx-text-fill: #bfdbfe; -fx-font-size: 14px;"/>
                </VBox>

                <VBox styleClass="card" spacing="15">
                    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 16 20; -fx-background-color: #f9fafb; -fx-background-radius: 14 14 0 0; -fx-border-color: transparent transparent #e5e7eb transparent; -fx-border-width: 0 0 1 0;">
                        <Label text="Sélectionnez un Module :" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <ComboBox fx:id="moduleComboBox" prefWidth="250" styleClass="form-control"/>
                    </HBox>
                    
                    <VBox fx:id="quizzesContainer" spacing="15" style="-fx-padding: 20;">
                        <!-- Les cartes de quiz seront générées ici -->
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

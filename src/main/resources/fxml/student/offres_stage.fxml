<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.student.StudentOffresStageController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800"
            style="-fx-background-color: #f9fafb;">

    <top>
        <HBox styleClass="student-topbar" alignment="CENTER_LEFT" spacing="30">
            <VBox>
                <Label text="🎓 LearnHub" style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-text-fill: #1e40af;"/>
                <Label text="ESPACE ÉTUDIANT" style="-fx-font-size: 10px; -fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="10" alignment="CENTER">
                <Button text="📊 Tableau de bord" styleClass="student-nav-btn" onAction="#goDashboard"/>
                <Button text="📚 Mes Modules" styleClass="student-nav-btn" onAction="#goModules"/>
                <Button text="📝 Mes Notes" styleClass="student-nav-btn" onAction="#goNotes"/>
                <Button text="🗓 Emploi du Temps" styleClass="student-nav-btn" onAction="#goEmploi"/>
                <Button text="💼 Stages" styleClass="student-nav-btn student-nav-active" onAction="#goOffresStage"/>
                <Button text="✅ Présences" styleClass="student-nav-btn" onAction="#goPresences"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="15">
                <Button text="🔔" style="-fx-background-color: transparent; -fx-font-size: 16px;"/>
                <HBox alignment="CENTER" spacing="10">
                    <Label text="ET" styleClass="prof-user-avatar" style="-fx-background-color: #fbbf24;"/>
                    <VBox alignment="CENTER_LEFT">
                        <Label fx:id="topUserName" text="Étudiant" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                        <Label text="Étudiant LearnHub" style="-fx-text-fill: #6b7280; -fx-font-size: 10px;"/>
                    </VBox>
                </HBox>
                <Button text="🚪" style="-fx-background-color: transparent; -fx-cursor: hand;" onAction="#handleLogout"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 30;">

                <VBox style="-fx-background-color: #1e3a8a; -fx-background-radius: 12; -fx-padding: 24 30;" spacing="5">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="💼" style="-fx-font-size: 24px;"/>
                        <Label text="Offres de stage" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    </HBox>
                    <Label text="Explorez les opportunités et postulez à une offre sélectionnée dans le tableau"
                           style="-fx-text-fill: #bfdbfe; -fx-font-size: 14px;" wrapText="true"/>
                    <Button text="📄 Mes candidatures" onAction="#goDemandesStage"
                            style="-fx-background-color: #fbbf24; -fx-text-fill: #111827; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 16; -fx-cursor: hand;"/>
                </VBox>

                <HBox spacing="20">
                    <VBox styleClass="student-dash-card" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="OFFRES DISPONIBLES" style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="totalOffresLabel" text="0" styleClass="student-dash-stat" style="-fx-font-size: 24px;"/>
                    </VBox>
                    <VBox styleClass="student-dash-card" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="DEMANDES EN ATTENTE" style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="enAttenteLabel" text="0" styleClass="student-dash-stat" style="-fx-font-size: 24px;"/>
                    </VBox>
                    <VBox styleClass="student-dash-card" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="DEMANDES ACCEPTÉES" style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="accepteesLabel" text="0" styleClass="student-dash-stat" style="-fx-font-size: 24px;"/>
                    </VBox>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT"
                       style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.05),8,0,0,2);">
                    <TextField fx:id="searchField" promptText="Rechercher une offre, un partenaire, une filière…"
                               HBox.hgrow="ALWAYS" maxWidth="Infinity"
                               style="-fx-background-radius:6; -fx-border-color:#e5e7eb; -fx-border-radius:6; -fx-padding:8;"/>
                    <ComboBox fx:id="filtreType" promptText="Type de stage" prefWidth="180"/>
                    <Button text="Postuler" onAction="#handlePostuler"
                            style="-fx-background-color:#fbbf24; -fx-text-fill:#111827; -fx-font-weight:bold; -fx-background-radius:20; -fx-padding:8 18; -fx-cursor:hand;"/>
                </HBox>

                <VBox styleClass="student-dash-card" spacing="0" style="-fx-padding: 0;">
                    <TableView fx:id="offreTable" prefHeight="460" style="-fx-border-color: transparent;">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="52"/>
                            <TableColumn fx:id="colTitre" text="Offre" prefWidth="240"/>
                            <TableColumn fx:id="colPartenaire" text="Partenaire" prefWidth="160"/>
                            <TableColumn fx:id="colType" text="Type" prefWidth="120"/>
                            <TableColumn fx:id="colDuree" text="Durée (mois)" prefWidth="100"/>
                            <TableColumn fx:id="colDateDebut" text="Publication" prefWidth="110"/>
                            <TableColumn fx:id="colStatut" text="Filière" prefWidth="160"/>
                        </columns>
                        <placeholder>
                            <Label text="Aucune offre pour le moment" style="-fx-text-fill:#9ca3af;"/>
                        </placeholder>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.student.StudentDashboardController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="5">
                <Label text="🎓 LearnHub" styleClass="sidebar-brand-text"/>
                <Label text="Espace Étudiant" styleClass="sidebar-brand-sub"/>
            </VBox>
            <VBox spacing="2" style="-fx-padding:10 0;">
                <Label text="NAVIGATION" styleClass="nav-section-title"/>
                <Button text="🏠  Tableau de bord" styleClass="nav-btn"              onAction="#goDashboard" maxWidth="Infinity"/>
                <Button text="📚  Mes Modules"    styleClass="nav-btn" onAction="#goModules"   maxWidth="Infinity"/>
                <Button text="📊  Mes Notes"      styleClass="nav-btn"   onAction="#goNotes"     maxWidth="Infinity"/>
                <Button text="✅  Mes Présences"  styleClass="nav-btn" onAction="#goPresences" maxWidth="Infinity"/>
                <Button text="🗓  Emploi du temps" styleClass="nav-btn, nav-btn-active" onAction="#goEmploi"   maxWidth="Infinity"/>
                <Label text="MÉDICAL" styleClass="nav-section-title"/>
                <Button text="🏥  Mes RDV"        styleClass="nav-btn"     onAction="#goRdv"       maxWidth="Infinity"/>
                <Label text="CAMPUS" styleClass="nav-section-title"/>
                <Button text="💼  Stages"         styleClass="nav-btn"  onAction="#goStages"    maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox style="-fx-padding:8 0 0 0;-fx-border-color:rgba(255,255,255,0.12);-fx-border-width:1 0 0 0;">
                <Label fx:id="welcomeLabel" text="Étudiant"
                       style="-fx-text-fill:rgba(255,255,255,0.7);-fx-font-size:12px;-fx-padding:8 15 4 15;"/>
                <Button text="🚪  Déconnexion" styleClass="nav-logout" onAction="#handleLogout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:#f5f7fa;-fx-border-color:transparent;">
            <VBox styleClass="content-area" spacing="24">
                <VBox spacing="4">
                    <Label text="🗓 Emploi du Temps" styleClass="page-title"/>
                    <Label text="Consultez votre planning de cours de la semaine"   styleClass="page-subtitle"/>
                </VBox>
                <VBox styleClass="card" VBox.vgrow="ALWAYS">
    <HBox styleClass="card-header" spacing="12" alignment="CENTER_LEFT">
        <Label text="🗓 Mon Planning de la Semaine" styleClass="card-header-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="semaineFilter" promptText="📅 Semaine" prefWidth="200" styleClass="filter-combo"/>
        <Button text="↻" styleClass="btn, btn-secondary, btn-sm" onAction="#handleRefresh"/>
    </HBox>
    <VBox styleClass="card-body" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS" style="-fx-border-color:transparent;">
            <columns>
                <TableColumn fx:id="colJour" text="Jour" prefWidth="120"/>
                <TableColumn fx:id="colHeure" text="Heure" prefWidth="130"/>
                <TableColumn fx:id="colModule" text="Module" prefWidth="220"/>
                <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
                <TableColumn fx:id="colSalle" text="Salle" prefWidth="110"/>
                <TableColumn fx:id="colProfesseur" text="Professeur" prefWidth="180"/>
            </columns>
            <placeholder><Label text="Aucune séance cette semaine" style="-fx-text-fill:#9ca3af;"/></placeholder>
        </TableView>
    </VBox>
</VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

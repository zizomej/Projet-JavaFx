<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.student.StudentNotesController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800"
            style="-fx-background-color: #f9fafb;">

    <!-- TOPBAR -->
    <top>
        <HBox styleClass="student-topbar" alignment="CENTER_LEFT" spacing="30">
            <!-- Logo -->
            <VBox>
                <Label text="🎓 LearnHub" style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-text-fill: #1e40af;"/>
                <Label text="ESPACE ÉTUDIANT" style="-fx-font-size: 10px; -fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <!-- Navigation -->
            <HBox spacing="10" alignment="CENTER">
                <Button text="📊 Tableau de bord" styleClass="student-nav-btn" onAction="#goDashboard"/>
                <Button text="📚 Mes Modules" styleClass="student-nav-btn" onAction="#goModules"/>
                <Button text="📝 Mes Notes" styleClass="student-nav-btn, student-nav-active"/>
                <Button text="🗓 Emploi du Temps" styleClass="student-nav-btn" onAction="#goEmploi"/>
                <Button text="💼 Stages" styleClass="student-nav-btn" onAction="#goStages"/>
                <Button text="✅ Présences" styleClass="student-nav-btn" onAction="#goPresences"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- User Profile & Logout -->
            <HBox alignment="CENTER" spacing="15">
                <Button text="🔔" style="-fx-background-color: transparent; -fx-font-size: 16px;"/>
                <HBox alignment="CENTER" spacing="10">
                    <Label text="AZ" styleClass="prof-user-avatar" style="-fx-background-color: #fbbf24; -fx-text-fill: white;"/>
                    <VBox alignment="CENTER_LEFT">
                        <Label fx:id="topUserName" text="ahmed zneidi" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                        <Label text="Étudiant LearnHub" style="-fx-text-fill: #6b7280; -fx-font-size: 10px;"/>
                    </VBox>
                </HBox>
                <Button text="🚪" style="-fx-background-color: transparent; -fx-cursor: hand;" onAction="#handleLogout"/>
            </HBox>
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 30;">

                <!-- Big Banner Mes Notes -->
                <VBox style="-fx-background-color: #1e3a8a; -fx-background-radius: 12; -fx-padding: 24 30;" spacing="5">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📊" style="-fx-font-size: 24px;"/>
                        <Label text="Mes Notes" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    </HBox>
                    <Label text="Consultez vos résultats et suivez votre progression" style="-fx-text-fill: #bfdbfe; -fx-font-size: 14px;"/>
                </VBox>

                <!-- Stats Row -->
                <HBox spacing="20">
                    <VBox styleClass="student-dash-card" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="TOTAL NOTES" style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblTotalNotes" text="0" styleClass="student-dash-stat" style="-fx-font-size: 24px;"/>
                    </VBox>
                    <VBox styleClass="student-dash-card" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="MODULES" style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblModules" text="0" styleClass="student-dash-stat" style="-fx-font-size: 24px;"/>
                    </VBox>
                    <VBox styleClass="student-dash-card" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="MOYENNE GÉNÉRALE" style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblMoyenne" text="0.00" styleClass="student-dash-stat" style="-fx-font-size: 24px;"/>
                    </VBox>
                </HBox>

                <!-- Accordion For Pivot Notes -->
                <Accordion fx:id="notesAccordion" styleClass="notes-accordion" VBox.vgrow="ALWAYS"/>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

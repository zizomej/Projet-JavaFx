<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.student.StudentPresencesController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800"
            style="-fx-background-color: #f9fafb;">

    <!-- TOPBAR (Identique à Mes Modules) -->
    <top>
        <HBox styleClass="student-topbar" alignment="CENTER_LEFT" spacing="30">
            <!-- Logo -->
            <VBox>
                <Label text="🎓 LearnHub" style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-text-fill: #1e40af;"/>
                <Label text="ESPACE ÉTUDIANT" style="-fx-font-size: 10px; -fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <!-- Navigation -->
            <HBox spacing="10" alignment="CENTER">
                <Button text="📊 Tableau de bord" styleClass="student-nav-btn" onAction="#goDashboard"/>
                <Button text="📚 Mes Modules" styleClass="student-nav-btn" onAction="#goModules"/>
                <Button text="📝 Mes Notes" styleClass="student-nav-btn" onAction="#goNotes"/>
                <Button text="🗓 Emploi du Temps" styleClass="student-nav-btn" onAction="#goEmploi"/>
                <Button text="💼 Stages" styleClass="student-nav-btn" onAction="#goStages"/>
                <Button text="✅ Présences" styleClass="student-nav-btn, student-nav-active" onAction="#goPresences"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- User Profile & Logout -->
            <HBox alignment="CENTER" spacing="15">
                <StackPane>
                    <Button text="🔔" style="-fx-background-color: transparent; -fx-font-size: 18px; -fx-cursor: hand;" onAction="#handleNotifications"/>
                    <javafx.scene.shape.Circle fx:id="notifBadge" radius="4" fill="#ef4444" StackPane.alignment="TOP_RIGHT" visible="false" style="-fx-translate-x: -5; -fx-translate-y: 5;"/>
                </StackPane>
                <HBox alignment="CENTER" spacing="10">
                    <Label text="AZ" styleClass="prof-user-avatar" style="-fx-background-color: #fbbf24; -fx-text-fill: white;"/>
                    <VBox alignment="CENTER_LEFT">
                        <Label fx:id="welcomeLabel" text="ahmed zneidi" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                        <Label text="Étudiant LearnHub" style="-fx-text-fill: #6b7280; -fx-font-size: 10px;"/>
                    </VBox>
                </HBox>
                <Button text="🚪" style="-fx-background-color: transparent; -fx-cursor: hand;" onAction="#handleLogout"/>
            </HBox>
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="24" style="-fx-padding: 30;">
                
                <!-- Banner Mes Présences -->
                <VBox style="-fx-background-color: #1e3a8a; -fx-background-radius: 12; -fx-padding: 24 30;" spacing="5">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📊" style="-fx-font-size: 24px;"/>
                        <Label text="Mes Présences" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    </HBox>
                    <Label text="Consultez votre bilan de présence détaillé par module" style="-fx-text-fill: #bfdbfe; -fx-font-size: 14px;"/>
                </VBox>

                <!-- Stats Row -->
                <HBox spacing="20">
                    <VBox styleClass="student-dash-card" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="PRÉSENCES" style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="presentsLabel" text="0" styleClass="student-dash-stat" style="-fx-font-size: 24px; -fx-text-fill: #10b981;"/>
                    </VBox>
                    <VBox styleClass="student-dash-card" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="ABSENCES / RETARDS" style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="absentsLabel" text="0" styleClass="student-dash-stat" style="-fx-font-size: 24px; -fx-text-fill: #ef4444;"/>
                    </VBox>
                </HBox>

                <VBox spacing="15">
                    <Label text="Détail par Module" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-padding: 10 0 5 0;"/>
                    <Accordion fx:id="presencesAccordion" styleClass="notes-accordion"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

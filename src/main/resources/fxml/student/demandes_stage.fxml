<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.learnhub.controller.student.StudentDemandesStageController"
           stylesheets="@/css/styles.css"
           prefWidth="1280" prefHeight="800">

    <BorderPane style="-fx-background-color: #f1f5f9;">
        <top>
            <HBox styleClass="student-topbar" alignment="CENTER_LEFT" spacing="24"
                  style="-fx-padding: 0 24; -fx-min-height: 62; -fx-background-color: #1e3a8a;
                         -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.15),8,0,0,3);">
                <VBox alignment="CENTER_LEFT">
                    <Label text="🎓 LearnHub"
                           style="-fx-font-size: 17px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    <Label text="ESPACE ÉTUDIANT"
                           style="-fx-font-size: 9px; -fx-text-fill: #93c5fd; -fx-font-weight: bold;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="4" alignment="CENTER">
                    <Button text="📊 Dashboard"    styleClass="student-nav-btn" onAction="#goDashboard"/>
                    <Button text="📚 Modules"      styleClass="student-nav-btn" onAction="#goModules"/>
                    <Button text="📝 Notes"        styleClass="student-nav-btn" onAction="#goNotes"/>
                    <Button text="🗓 Emploi"       styleClass="student-nav-btn" onAction="#goEmploi"/>
                    <Button text="💼 Offres Stage" styleClass="student-nav-btn" onAction="#goOffresStage"/>
                    <Button text="✅ Présences"    styleClass="student-nav-btn" onAction="#goPresences"/>
                    <Button text="📋 Candidatures"
                            styleClass="student-nav-btn student-nav-active" onAction="#goDemandesStage"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="12">
                    <StackPane>
                        <Circle fill="#f59e0b" radius="18"/>
                        <Label text="ET" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 12px;"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT">
                        <Label fx:id="topUserName" text="Étudiant"
                               style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: white;"/>
                        <Label text="Étudiant LearnHub"
                               style="-fx-text-fill: #93c5fd; -fx-font-size: 10px;"/>
                    </VBox>
                    <Button text="🚪" style="-fx-background-color: rgba(255,255,255,0.15);
                                   -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6;
                                   -fx-padding: 6 10;" onAction="#handleLogout"/>
                </HBox>
            </HBox>
        </top>

        <center>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <VBox spacing="20" style="-fx-padding: 28 32;">

                    <!-- Header banner -->
                    <VBox spacing="10"
                          style="-fx-background-color: linear-gradient(to right, #1e3a8a, #7c3aed);
                                 -fx-background-radius: 16; -fx-padding: 28 32;">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="📋 Mes Candidatures"
                                       style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                                <Label text="Suivez l'état de vos demandes de stage en temps réel"
                                       style="-fx-text-fill: #c4b5fd; -fx-font-size: 13px;"/>
                            </VBox>
                            <Button text="💼 Voir les offres" onAction="#goOffresStage"
                                    style="-fx-background-color: #f59e0b; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-background-radius: 10;
                                           -fx-padding: 10 20; -fx-cursor: hand; -fx-font-size: 13px;
                                           -fx-border-width: 0;"/>
                        </HBox>
                    </VBox>

                    <!-- Stats row -->
                    <HBox spacing="16">
                        <VBox HBox.hgrow="ALWAYS" spacing="6" alignment="CENTER_LEFT"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-padding: 20 24;
                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),12,0,0,3);
                                     -fx-border-color: #f59e0b; -fx-border-width: 0 0 0 4;
                                     -fx-border-radius: 0 14 14 0;">
                            <Label text="EN ATTENTE"
                                   style="-fx-text-fill: #64748b; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                            <Label fx:id="enAttenteLabel" text="0"
                                   style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #d97706;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="6" alignment="CENTER_LEFT"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-padding: 20 24;
                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),12,0,0,3);
                                     -fx-border-color: #10b981; -fx-border-width: 0 0 0 4;
                                     -fx-border-radius: 0 14 14 0;">
                            <Label text="ACCEPTÉES"
                                   style="-fx-text-fill: #64748b; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                            <Label fx:id="accepteesLabel" text="0"
                                   style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #059669;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="6" alignment="CENTER_LEFT"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-padding: 20 24;
                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),12,0,0,3);
                                     -fx-border-color: #ef4444; -fx-border-width: 0 0 0 4;
                                     -fx-border-radius: 0 14 14 0;">
                            <Label text="REFUSÉES"
                                   style="-fx-text-fill: #64748b; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                            <Label fx:id="refuseesLabel" text="0"
                                   style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #dc2626;"/>
                        </VBox>
                    </HBox>

                    <!-- Table card -->
                    <VBox spacing="0"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),12,0,0,3);">
                        <HBox alignment="CENTER_LEFT" spacing="12"
                              style="-fx-padding: 16 20 14 20; -fx-border-color: #f1f5f9;
                                     -fx-border-width: 0 0 1 0;">
                            <VBox HBox.hgrow="ALWAYS" spacing="2">
                                <Label text="📋 Historique des candidatures"
                                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                <Label fx:id="statusLabel" text=""
                                       style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                            </VBox>
                            <Button text="➕ Nouvelle candidature" onAction="#openNewDemandeDialog"
                                    style="-fx-background-color: #1e3a8a; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-background-radius: 10;
                                           -fx-padding: 10 20; -fx-cursor: hand; -fx-font-size: 13px;
                                           -fx-border-width: 0;"/>
                        </HBox>
                        <TableView fx:id="demandeTable" prefHeight="480"
                                   style="-fx-background-color: white; -fx-border-color: transparent;">
                            <columns>
                                <TableColumn fx:id="colId"          text="#"               prefWidth="50"/>
                                <TableColumn fx:id="colOffre"       text="Offre"           prefWidth="240"/>
                                <TableColumn fx:id="colPartenaire"  text="Partenaire"      prefWidth="170"/>
                                <TableColumn fx:id="colDate"        text="Date"            prefWidth="110"/>
                                <TableColumn fx:id="colStatut"      text="Statut"          prefWidth="130"/>
                                <TableColumn fx:id="colCommentaire" text="Motivation / CV" prefWidth="240"/>
                            </columns>
                            <placeholder>
                                <Label text="Aucune candidature — cliquez sur Nouvelle candidature"
                                       style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>

    <!-- ═══════  POPUP OVERLAY — Nouvelle candidature  ═══════ -->
    <StackPane fx:id="popupOverlay" visible="false" managed="false"
               style="-fx-background-color: rgba(15,23,42,0.65);">

        <VBox alignment="TOP_LEFT" spacing="0"
              style="-fx-background-color: white; -fx-background-radius: 18;
                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.35),30,0,0,10);"
              maxWidth="640" minWidth="580">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: linear-gradient(to right, #1e3a8a, #2563eb);
                         -fx-background-radius: 18 18 0 0; -fx-padding: 22 26;">
                <Label text="📋" style="-fx-font-size: 26px;"/>
                <VBox HBox.hgrow="ALWAYS" spacing="3">
                    <Label text="Nouvelle demande de stage"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Remplissez le formulaire et joignez votre CV"
                           style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.80);"/>
                </VBox>
                <Button text="✕" onAction="#closeNewDemandeDialog"
                        style="-fx-background-color: rgba(255,255,255,0.18); -fx-text-fill: white;
                               -fx-background-radius: 50; -fx-min-width: 34; -fx-min-height: 34;
                               -fx-cursor: hand; -fx-border-width: 0; -fx-font-weight: bold;
                               -fx-font-size: 14px;"/>
            </HBox>

            <!-- Form body -->
            <VBox spacing="18" style="-fx-padding: 26 28;">

                <!-- Offre combo -->
                <VBox spacing="6">
                    <Label text="🏢 Offre de stage *"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <ComboBox fx:id="offreCombo" promptText="Sélectionnez une offre de stage"
                              maxWidth="Infinity"
                              style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0;
                                     -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 5;
                                     -fx-font-size: 13px;"/>
                </VBox>

                <!-- Motivation letter -->
                <VBox spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="✉ Lettre de motivation *" HBox.hgrow="ALWAYS"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                        <Button fx:id="generateLetterBtn"
                                text="✨ Générer automatiquement"
                                onAction="#handleGenerateLetter"
                                style="-fx-background-color: #7c3aed; -fx-text-fill: white;
                                       -fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-background-radius: 8; -fx-cursor: hand;
                                       -fx-padding: 7 14; -fx-border-width: 0;"/>
                    </HBox>
                    <TextArea fx:id="motivationArea"
                              promptText="Rédigez votre lettre de motivation, ou cliquez sur Générer pour une lettre personnalisée basée sur votre profil…"
                              prefHeight="130" wrapText="true"
                              style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0;
                                     -fx-border-radius: 8; -fx-background-radius: 8;
                                     -fx-padding: 12; -fx-font-size: 13px;"/>
                    <Label text="💡 Cliquez sur Générer pour une lettre pré-remplie avec vos données (nom, filière, notes, etc.)"
                           wrapText="true"
                           style="-fx-font-size: 10px; -fx-text-fill: #94a3b8; -fx-font-style: italic;"/>
                </VBox>

                <!-- CV upload -->
                <VBox spacing="8">
                    <Label text="📎 CV (PDF, DOC, DOCX)"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button fx:id="cvUploadBtn" text="📁 Choisir mon CV"
                                onAction="#handleCvUpload"
                                style="-fx-background-color: #eff6ff; -fx-text-fill: #1e40af;
                                       -fx-border-color: #93c5fd; -fx-border-width: 1.5;
                                       -fx-border-radius: 8; -fx-background-radius: 8;
                                       -fx-padding: 10 20; -fx-font-size: 13px;
                                       -fx-cursor: hand; -fx-font-weight: bold;"/>
                        <Label fx:id="cvFileLabel" text="Aucun fichier sélectionné"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-style: italic;"/>
                    </HBox>
                    <Label text="Formats acceptés : PDF, DOC, DOCX (max 5 Mo)"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
                </VBox>

                <!-- Error label -->
                <Label fx:id="formErrorLabel" text="" visible="false" managed="false"
                       wrapText="true" maxWidth="Infinity"
                       style="-fx-background-color: #fef2f2; -fx-text-fill: #b91c1c;
                              -fx-padding: 10 14; -fx-background-radius: 8; -fx-font-size: 12px;"/>
            </VBox>

            <!-- Action buttons -->
            <HBox spacing="12" alignment="CENTER_RIGHT"
                  style="-fx-padding: 16 28 24 28; -fx-border-color: #f1f5f9;
                         -fx-border-width: 1 0 0 0;">
                <Button text="Annuler" onAction="#closeNewDemandeDialog"
                        style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569;
                               -fx-border-color: #e2e8f0; -fx-border-width: 1;
                               -fx-border-radius: 8; -fx-background-radius: 8;
                               -fx-padding: 11 24; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="✅ Soumettre ma candidature" onAction="#handleSubmitDemande"
                        style="-fx-background-color: #1e3a8a; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-padding: 11 24;
                               -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px;
                               -fx-border-width: 0;"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.professor.ProfessorPresencesController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">
    <top>
        <HBox styleClass="prof-topnav" alignment="CENTER_LEFT" spacing="10">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="🎓" style="-fx-font-size:28px;"/>
                <VBox spacing="2">
                    <Label text="🎓 LearnHub" style="-fx-text-fill:white;-fx-font-size:17px;-fx-font-weight:900;"/>
                    <Label text="ESPACE PROFESSEUR" styleClass="prof-brand"/>
                </VBox>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="4" alignment="CENTER">
                <Button text="🏠 Tableau de bord" styleClass="prof-nav-btn" onAction="#goDashboard"/>
                <Button text="📚 Mes Modules"     styleClass="prof-nav-btn" onAction="#goModules"/>
                <Button text="🗓 Mes Séances"     styleClass="prof-nav-btn" onAction="#goSeances"/>
                <Button text="📊 Gérer Notes"     styleClass="prof-nav-btn" onAction="#goNotes"/>
                <Button text="✅ Présences"        styleClass="prof-nav-btn, prof-nav-btn-active" onAction="#goPresences"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Label fx:id="welcomeLabel" text="Professeur" style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:13px;"/>
                <Label text="PR" styleClass="prof-user-avatar"/>
                <Button text="🚪 Déconnexion" styleClass="prof-logout" onAction="#handleLogout"/>
            </HBox>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:#f5f7fa;-fx-border-color:transparent;">
            <VBox styleClass="content-area" spacing="24">
                <VBox styleClass="welcome-banner" spacing="10">
                    <Label text="✅ Gestion des Présences" styleClass="welcome-name"/>
                    <Label text="Sélectionnez une séance pour effectuer l'appel de vos étudiants" styleClass="welcome-sub"/>
                </VBox>

                <VBox styleClass="card" alignment="CENTER" spacing="30" style="-fx-padding: 60 40;">
                    <VBox spacing="20" maxWidth="600" alignment="CENTER_LEFT">
                        <Label text="📋 Paramètres de l'appel" styleClass="card-header-title" style="-fx-font-size: 18px;"/>
                        
                        <VBox spacing="8">
                            <Label text="L'unité d'enseignement (Module)" styleClass="form-label"/>
                            <ComboBox fx:id="moduleSelector" prefWidth="600" styleClass="filter-combo" promptText="Sélectionner le module..."/>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="La séance programmée" styleClass="form-label"/>
                            <ComboBox fx:id="seanceSelector" prefWidth="600" styleClass="filter-combo" promptText="Sélectionner la séance..."/>
                        </VBox>
                        
                        <Region prefHeight="10"/>
                        
                        <Button text="📝 Commencer l'appel des étudiants" styleClass="btn, btn-primary" 
                                prefWidth="600" style="-fx-padding: 15; -fx-font-size: 15px; -fx-font-weight: bold;"
                                onAction="#handleLoadPresences"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

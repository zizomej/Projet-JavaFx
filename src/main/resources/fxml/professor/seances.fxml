<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.professor.ProfessorSeancesController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">
    <top>
        <HBox styleClass="prof-topnav" alignment="CENTER_LEFT" spacing="10">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="&#127891;" style="-fx-font-size:28px;"/>
                <VBox spacing="2">
                    <Label text="LearnHub" style="-fx-text-fill:white;-fx-font-size:17px;-fx-font-weight:900;"/>
                    <Label text="ESPACE PROFESSEUR" styleClass="prof-brand"/>
                </VBox>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="4" alignment="CENTER">
                <Button text="Tableau de bord" styleClass="prof-nav-btn" onAction="#goDashboard"/>
                <Button text="Mes Modules"     styleClass="prof-nav-btn" onAction="#goModules"/>
                <Button text="Mes Seances"     styleClass="prof-nav-btn, prof-nav-btn-active" onAction="#goSeances"/>
                <Button text="Gerer Notes"     styleClass="prof-nav-btn" onAction="#goNotes"/>
                <Button text="Presences"       styleClass="prof-nav-btn" onAction="#goPresences"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Label fx:id="welcomeLabel" text="Professeur" style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:13px;"/>
                <Label text="PR" styleClass="prof-user-avatar"/>
                <Button text="Deconnexion" styleClass="prof-logout" onAction="#handleLogout"/>
            </HBox>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <StackPane styleClass="root-container">
                <VBox styleClass="content-area" spacing="30" style="-fx-padding: 40 60;">

                    <!-- BANNER HEADER -->
                    <VBox spacing="8" style="-fx-background-color: linear-gradient(to right, #0A1F44, #1e3a8a, #3b82f6); -fx-background-radius: 20; -fx-padding: 35 40; -fx-effect: dropshadow(gaussian, rgba(30,58,138,0.35), 25, 0, 0, 10);">
                        <HBox alignment="CENTER_LEFT" spacing="20">
                            <VBox HBox.hgrow="ALWAYS" spacing="8">
                                <Label text="Mes Seances" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                                <Label text="Consultez et modifiez vos seances de cours planifiees" style="-fx-font-size: 15px; -fx-text-fill: rgba(255,255,255,0.75);"/>
                            </VBox>

                        </HBox>
                    </VBox>

                    <!-- STAT CARDS REMOVED AS REQUESTED -->


                    <!-- SEARCH BAR -->
                    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 5);">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Rechercher une seance" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <TextField fx:id="searchField" promptText="Ex: IntelligenceArtificielle, TP, Amphi A..." styleClass="form-control" prefHeight="48"/>
                        </VBox>
                        <VBox alignment="BOTTOM_CENTER">
                            <Button text="Actualiser" onAction="#handleRefresh"
                                    style="-fx-background-color: #f8fafc; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-padding: 14 25; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 12; -fx-cursor: hand;"/>
                        </VBox>
                    </HBox>

                    <!-- TABLE CARD -->
                    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 30, 0, 0, 12);">

                        <!-- Card Header -->
                        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 25 35; -fx-border-color: #f1f5f9; -fx-border-width: 0 0 1 0;">
                            <VBox spacing="3">
                                <Label text="Planning des Seances" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #0f172a;"/>
                                <Label text="Toutes vos seances par ordre chronologique" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Cliquez sur une ligne pour la selectionner" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8; -fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-padding: 6 12;"/>
                        </HBox>

                        <!-- Table -->
                        <VBox VBox.vgrow="ALWAYS">
                            <TableView fx:id="seancesTable" VBox.vgrow="ALWAYS" fixedCellSize="55" style="-fx-border-color: transparent; -fx-background-color: transparent;">
                                <columns>
                                    <TableColumn fx:id="colDate"   text="DATE"   prefWidth="160" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colHeure"  text="HEURE"  prefWidth="150" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colModule" text="MODULE" prefWidth="280" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colType"   text="TYPE"   prefWidth="130" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colSalle"  text="SALLE"  prefWidth="150" style="-fx-alignment: CENTER;"/>
                                </columns>
                                <placeholder>
                                    <VBox alignment="CENTER" spacing="15" style="-fx-padding: 60;">
                                        <Label text="Aucune seance planifiee" style="-fx-text-fill: #94a3b8; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                                        <Label text="Vos seances apparaitront ici une fois planifiees" style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px;"/>
                                    </VBox>
                                </placeholder>
                            </TableView>
                        </VBox>

                        <!-- Card Footer -->
                        <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 20 35; -fx-border-color: #f1f5f9; -fx-border-width: 1 0 0 0; -fx-background-color: #fafafa; -fx-background-radius: 0 0 20 20;">
                            <Button text="Modifier la seance selectionnee" onAction="#handleEdit"
                                    style="-fx-background-color: linear-gradient(to right, #f59e0b, #d97706); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 28; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(217,119,6,0.25), 10, 0, 0, 4);"/>
                        </HBox>
                    </VBox>

                </VBox>
            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>

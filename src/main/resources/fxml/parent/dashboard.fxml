<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.parent.ParentDashboardController"
            stylesheets="@/css/styles.css" style="-fx-background-color: #f5f7fa; -fx-border-color: transparent;" prefWidth="1440" prefHeight="900">
    <VBox styleClass="content-area" spacing="24" style="-fx-padding: 0 40 40 40;">

        <!-- Top Header Navigation -->
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15 30; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0; -fx-margin: 0 -40 10 -40;">
            <Label text="L E A R N H U B" style="-fx-font-weight: 900; -fx-font-size: 16px; -fx-text-fill: #111827;"/>
            <Region minWidth="20"/>
            <Label text="Espace Parent | Suivi de la scolarité de votre enfant" style="-fx-text-fill: #6b7280; -fx-font-size: 14px;"/>
            
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="10">
                <VBox alignment="CENTER_RIGHT">
                    <Label fx:id="topParentNameLabel" text="Parent de ..." style="-fx-font-weight: 700; -fx-text-fill: #374151; -fx-font-size: 14px;"/>
                    <Label text="Compte parent" style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;"/>
                </VBox>
                <Label fx:id="topParentInitialLabel" text="P" style="-fx-background-color: #9333ea; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 900; -fx-alignment: CENTER; -fx-background-radius: 50; -fx-min-width: 40; -fx-min-height: 40; -fx-max-width: 40; -fx-max-height: 40;"/>
            </HBox>
        </HBox>

        <!-- Title & Action Buttons -->
        <HBox alignment="CENTER" spacing="15">
            <VBox spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="👨‍👩‍👧" style="-fx-font-size: 28px;"/>
                    <Label text="Espace Parent" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #111827;"/>
                </HBox>
                <Label text="Suivi de la scolarité de votre enfant en temps réel" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <HBox spacing="10" alignment="CENTER">
                <Button text="🔄 Actualiser" onAction="#handleRefresh"
                        style="-fx-background-color: #9333ea; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button text="📥 Bulletin PDF" onAction="#handleDownloadPDF"
                        style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button text="🚪 Déconnexion" onAction="#handleLogout"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>
        </HBox>

        <!-- Bannière Violette -->
        <VBox spacing="10"
                style="-fx-background-color: linear-gradient(to bottom right, #a855f7, #7e22ce);
                       -fx-background-radius: 12; -fx-padding: 24 32; 
                       -fx-effect: dropshadow(gaussian, rgba(147,51,234,0.3), 15, 0, 0, 8);">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label fx:id="enfantInitialLabel" text="HE"
                       style="-fx-background-color: rgba(255,255,255,0.25); -fx-background-radius: 50;
                              -fx-min-width: 80px; -fx-min-height: 80px; -fx-max-width: 80px; -fx-max-height: 80px;
                              -fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: white; -fx-alignment: CENTER;"/>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label fx:id="enfantNomLabel" text="Nom Prénom Enfant"
                           style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    <Label fx:id="enfantFiliereLabel" text="Filière non définie"
                           style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                    <Label fx:id="enfantEmailLabel" text="mail@learnhub.com"
                           style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.6);"/>
                </VBox>
                <HBox spacing="16">
                    <VBox alignment="CENTER" spacing="5"
                          style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 8; -fx-padding: 12 25;">
                        <Label text="Moyenne Générale" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: bold;"/>
                        <Label fx:id="moyenneLabel" text="—/20"
                               style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="5"
                          style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 8; -fx-padding: 12 25;">
                        <Label text="Taux de Présence" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: bold;"/>
                        <Label fx:id="presenceTauxLabel" text="—%"
                               style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    </VBox>
                </HBox>
            </HBox>
        </VBox>

        <!-- Stats Cards -->
        <HBox spacing="20">
            <!-- Modules Suivis -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="📚" style="-fx-font-size: 24px; -fx-background-color: #f3f4f6; -fx-padding: 10; -fx-background-radius: 8;"/>
                    <VBox spacing="5">
                        <Label text="Modules Suivis" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af; -fx-font-weight: bold;"/>
                        <Label fx:id="modulesCountLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #1f2937;"/>
                    </VBox>
                </HBox>
            </VBox>
            
            <!-- Crédits Acquis -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="⭐" style="-fx-font-size: 24px; -fx-background-color: #fef3c7; -fx-padding: 10; -fx-background-radius: 8;"/>
                    <VBox spacing="5">
                        <Label text="Crédits Acquis" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af; -fx-font-weight: bold;"/>
                        <Label fx:id="creditsAcquisLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #1f2937;"/>
                    </VBox>
                </HBox>
            </VBox>
            
            <!-- Meilleure Note -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="🏆" style="-fx-font-size: 24px; -fx-background-color: #e0e7ff; -fx-padding: 10; -fx-background-radius: 8;"/>
                    <VBox spacing="5">
                        <Label text="Meilleure Note" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af; -fx-font-weight: bold;"/>
                        <Label fx:id="meilleureNoteLabel" text="—" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #1f2937;"/>
                    </VBox>
                </HBox>
            </VBox>
            
            <!-- Total Notes -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="📝" style="-fx-font-size: 24px; -fx-background-color: #fce7f3; -fx-padding: 10; -fx-background-radius: 8;"/>
                    <VBox spacing="5">
                        <Label text="Total Notes" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af; -fx-font-weight: bold;"/>
                        <Label fx:id="totalNotesLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #1f2937;"/>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>

        <!-- Relevé de Notes Table -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);" VBox.vgrow="ALWAYS">
            <VBox style="-fx-padding: 15 20; -fx-border-color: transparent;">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="📊" style="-fx-font-size: 18px;"/>
                    <Label text="Relevé de Notes" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #111827;"/>
                </HBox>
                <Label fx:id="moyenneTopRightLabel" text="Moyenne générale : —/20" style="-fx-text-fill: #9333ea; -fx-font-size: 13.5px; -fx-padding: 4 0 0 0;"/>
            </VBox>
            <TableView fx:id="releveTable" styleClass="table-releve" VBox.vgrow="ALWAYS" style="-fx-border-color: transparent; -fx-background-radius: 0 0 8 8;">
                <columns>
                    <TableColumn fx:id="colCode"     text="Code"      prefWidth="100" style="-fx-text-fill: #9333ea; -fx-font-weight: bold; -fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="colModule"   text="Module"    prefWidth="220" style="-fx-font-weight: bold; -fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="colCC"       text="Contrôle"  prefWidth="100" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                    <TableColumn fx:id="colTP"       text="TP"        prefWidth="100" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                    <TableColumn fx:id="colExamen"   text="Examen"    prefWidth="100" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                    <TableColumn fx:id="colMoyenne"  text="Moyenne"   prefWidth="100" style="-fx-alignment: CENTER; -fx-font-weight: bold; -fx-text-fill: #ef4444;"/>
                    <TableColumn fx:id="colCredits"  text="Crédits"   prefWidth="80"  style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                    <TableColumn fx:id="colResultat" text="Résultat"  prefWidth="120" style="-fx-alignment: CENTER;"/>
                </columns>
                <placeholder>
                    <Label text="Aucune note disponible pour cet étudiant" style="-fx-text-fill: #9ca3af;"/>
                </placeholder>
            </TableView>
            <HBox alignment="CENTER" style="-fx-background-color: #f9f5ff; -fx-padding: 15; -fx-background-radius: 0 0 8 8; -fx-border-color: #e9d5ff; -fx-border-width: 1 0 0 0;">
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="MOYENNE GÉNÉRALE :" style="-fx-font-weight: 800; -fx-text-fill: #1f2937; -fx-font-size: 14px; -fx-padding: 0 15 0 0;"/>
                <Label fx:id="tableMoyenneLabel" text="—/20" style="-fx-font-weight: 900; -fx-text-fill: #ef4444; -fx-font-size: 14px; -fx-padding: 0 60 0 0;"/>
                <Label fx:id="tableCreditsLabel" text="0" style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 14px;"/>
                <Region prefWidth="120"/> <!-- Match colResultat width approximately -->
            </HBox>
        </VBox>

        <!-- Informations Importantes -->
        <VBox style="-fx-background-color: #f3e8ff; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: #e9d5ff; -fx-border-width: 1; -fx-border-radius: 8;">
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 10 0;">
                <Label text="ℹ️" style="-fx-font-size: 18px;"/>
                <Label text="Informations Importantes" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #6b21a8;"/>
            </HBox>
            <VBox spacing="8" style="-fx-padding: 0 0 0 35;">
                <HBox spacing="5"><Label text="• "/><Label text="ID Étudiant : " style="-fx-font-weight: bold;"/><Label fx:id="infoCinLabel" text="—"/></HBox>
                <HBox spacing="5"><Label text="• "/><Label text="Total de modules : " style="-fx-font-weight: bold;"/><Label fx:id="infoModulesLabel" text="0"/></HBox>
                <HBox spacing="5"><Label text="• "/><Label text="Crédits acquis : " style="-fx-font-weight: bold;"/><Label fx:id="infoCreditsLabel" text="0 crédits"/></HBox>
                <HBox spacing="5"><Label text="• "/><Label text="Meilleure performance : " style="-fx-font-weight: bold;"/><Label fx:id="infoPerformanceLabel" text="—/20"/></HBox>
                <HBox spacing="5"><Label text="• "/><Label text="Statut : " style="-fx-font-weight: bold;"/><Label fx:id="infoStatutLabel" text="—" style="-fx-font-weight: bold;"/></HBox>
            </VBox>
        </VBox>
        
    </VBox>
</ScrollPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:id="rootPane"
            fx:controller="com.learnhub.controller.visiteur.EventsController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="visiteur-nav">
            <Label text="🎓 LearnHub" styleClass="visiteur-nav-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Accueil"     styleClass="visiteur-nav-btn" onAction="#goHome"/>
            <Button text="Programmes"  styleClass="visiteur-nav-btn" onAction="#goPrograms"/>
            <Button text="Actualités"  styleClass="visiteur-nav-btn"
                    style="-fx-text-fill: #1E3A8A; -fx-border-color: transparent transparent #FFC107 transparent; -fx-border-width: 0 0 3 0;"
                    onAction="#goEvents"/>
            <Button text="Partenaires" styleClass="visiteur-nav-btn" onAction="#goPartners"/>
            <Button text="🔐  Se connecter" styleClass="visiteur-nav-login" onAction="#goLogin"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="0">
                <!-- Page Hero -->
                <VBox styleClass="page-hero" alignment="CENTER_LEFT" spacing="14" minHeight="210">
                    <padding><Insets top="60" bottom="60" left="90" right="90"/></padding>
                    <Label text="🎉 Événements &amp; Actualités" styleClass="page-hero-title"/>
                    <Label text="Restez informé des dernières actualités et événements de l'établissement"
                           styleClass="page-hero-sub" wrapText="true" maxWidth="620"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <padding><Insets top="8"/></padding>
                        <Label text="🏠 Accueil" style="-fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 13px;"/>
                        <Label text="›" style="-fx-text-fill: rgba(255,255,255,0.45);"/>
                        <Label text="Événements" style="-fx-text-fill: #FFC107; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

                <!-- Content -->
                <VBox style="-fx-background-color: #f5f7fa; -fx-padding: 40 80 60 80;" spacing="28">
                    <!-- Filtres -->
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <ComboBox fx:id="typeFilter" promptText="📂 Type d'événement" prefWidth="200" styleClass="filter-combo"/>
                        <TextField fx:id="searchField" promptText="🔍 Rechercher un événement..." HBox.hgrow="ALWAYS" styleClass="search-field"/>
                        <Button text="🔍 Rechercher" styleClass="btn, btn-primary" onAction="#handleSearch"/>
                    </HBox>

                    <!-- Liste événements -->
                    <VBox styleClass="card" VBox.vgrow="ALWAYS">
                        <HBox styleClass="card-header" alignment="CENTER_LEFT">
                            <Label text="🎉 Tous les Événements" styleClass="card-header-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="countLabel" text="" style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>
                        </HBox>
                        <VBox styleClass="card-body" VBox.vgrow="ALWAYS">
                            <TableView fx:id="table" VBox.vgrow="ALWAYS" style="-fx-border-color: transparent;">
                                <columns>
                                    <TableColumn fx:id="colTitre"     text="Titre"       prefWidth="260"/>
                                    <TableColumn fx:id="colType"      text="Type"        prefWidth="130"/>
                                    <TableColumn fx:id="colDate"      text="Date"        prefWidth="130"/>
                                    <TableColumn fx:id="colLieu"      text="Lieu"        prefWidth="180"/>
                                    <TableColumn fx:id="colStatut"    text="Statut"      prefWidth="110"/>
                                </columns>
                                <placeholder>
                                    <Label text="Aucun événement trouvé" style="-fx-text-fill: #9ca3af;"/>
                                </placeholder>
                            </TableView>
                        </VBox>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
  VISITEUR EVENTS — Liste publique des événements
  Navbar blanche, Entête dégradée, Grille d'événements dynamique
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:id="rootPane"
            fx:controller="com.learnhub.controller.visiteur.EventsController"
            stylesheets="@/css/styles.css"
            prefWidth="1280" prefHeight="800">

    <!-- TOP NAVBAR BLANCHE -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="visiteur-nav">
            <Label text="🎓 LearnHub" styleClass="visiteur-nav-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Accueil"      styleClass="visiteur-nav-btn" onAction="#goHome"/>
            <Button text="Programmes"  styleClass="visiteur-nav-btn" onAction="#goPrograms"/>
            <Button text="Actualités"  styleClass="visiteur-nav-btn"
                    style="-fx-text-fill: #1E3A8A; -fx-border-color: transparent transparent #FFC107 transparent; -fx-border-width: 0 0 3 0;"
                    onAction="#goEvents"/>
            <Button text="Partenaires" styleClass="visiteur-nav-btn" onAction="#goPartners"/>
            <Button text="🔐  Se connecter" styleClass="visiteur-nav-login" onAction="#goLogin"/>
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-background: #f8fafc;">
            <VBox spacing="0">

                <!-- HEADER SECTION -->
                <VBox styleClass="visiteur-hero" alignment="CENTER" spacing="15" minHeight="250">
                    <padding><Insets top="50" bottom="50" left="100" right="100"/></padding>
                    <Label text="Événements et Actualités" styleClass="visiteur-hero-title" style="-fx-font-size: 42px;"/>
                    <Label text="Restez informé des prochains séminaires, conférences et activités étudiantes."
                           styleClass="visiteur-hero-sub" wrapText="true" maxWidth="720" textAlignment="CENTER"/>
                </VBox>

                <!-- EVENTS GRID -->
                <VBox alignment="CENTER" spacing="30" style="-fx-padding: 60 40; -fx-background-color: #f8fafc;">
                    <HBox alignment="CENTER_LEFT" maxWidth="1000">
                        <Label text="Tous nos événements" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #0f172a;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="eventsCountLabel" text="0 événement trouvé" style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </HBox>

                    <!-- Container dynamique -->
                    <FlowPane fx:id="eventsContainer" hgap="25" vgap="25" alignment="CENTER_LEFT" maxWidth="1000">
                        <!-- Les cartes seront injectées ici par le contrôleur -->
                    </FlowPane>
                </VBox>
                
                <!-- FOOTER -->
                <VBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-padding: 50 20; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">
                    <Label text="© 2026 LearnHub. Tous droits réservés." style="-fx-text-fill: #64748b; -fx-font-size: 14px;"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

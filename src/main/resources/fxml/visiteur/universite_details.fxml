<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
  VISITEUR UNIVERSITY DETAILS
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:id="rootPane"
            fx:controller="com.learnhub.controller.visiteur.UniversiteDetailsController"
            stylesheets="@/css/styles.css"
            prefWidth="1280" prefHeight="800">

    <!-- TOP NAVBAR BLANCHE -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="visiteur-nav">
            <Label text="🎓 LearnHub" styleClass="visiteur-nav-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Accueil"      styleClass="visiteur-nav-btn" onAction="#goHome"/>
            <Button text="Programmes"  styleClass="visiteur-nav-btn" onAction="#goPrograms"/>
            <Button text="Actualités"  styleClass="visiteur-nav-btn" onAction="#goEvents"/>
            <Button text="Partenaires" styleClass="visiteur-nav-btn" onAction="#goPartners"/>
            <Button text="🔐  Se connecter" styleClass="visiteur-nav-login" onAction="#goLogin"/>
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-background: #f8fafc;">
            <VBox spacing="0">

                <!-- HEADER SECTION -->
                <VBox fx:id="heroSection" alignment="CENTER" spacing="15" minHeight="250"
                      style="-fx-background-color: linear-gradient(to bottom right, #0A1F44, #1E3A8A);">
                    <padding><Insets top="50" bottom="50" left="100" right="100"/></padding>
                    <Label fx:id="uniNameLabel" text="Nom Université" styleClass="visiteur-hero-title" style="-fx-font-size: 42px;"/>
                    <Label fx:id="uniSubInfoLabel" text="Type • Ville"
                           styleClass="visiteur-hero-sub" wrapText="true" maxWidth="720" textAlignment="CENTER"/>
                </VBox>

                <HBox alignment="CENTER_LEFT" style="-fx-padding: 30 100 0 100;">
                    <Button text="&lt; Retour aux universités" onAction="#goHome"
                            style="-fx-background-color: transparent; -fx-text-fill: #3B82F6; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                </HBox>

                <!-- FILIERES GRID -->
                <VBox alignment="CENTER" spacing="30" style="-fx-padding: 30 100 60 100; -fx-background-color: #f8fafc;">
                    <HBox alignment="CENTER_LEFT" maxWidth="1200">
                        <Label text="Nos Formations" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #0f172a;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="filieresCountLabel" text="0 formation trouvée" style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </HBox>

                    <!-- Container dynamique -->
                    <FlowPane fx:id="filieresContainer" hgap="25" vgap="25" alignment="CENTER_LEFT" maxWidth="1200">
                        <!-- Les cartes seront injectées ici par le contrôleur -->
                    </FlowPane>
                </VBox>
                
                <!-- FOOTER -->
                <VBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-padding: 50 20; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">
                    <Label text="© 2026 LearnHub. Tous droits réservés." style="-fx-text-fill: #64748b; -fx-font-size: 14px;"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
  VISITEUR HOME — Design Symfony visiteur/layout.html.twig + dashboard.html.twig
  Navbar blanche, Hero gradient #0A1F44 → #1E3A8A, cartes programmes
-->
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.learnhub.controller.visiteur.HomeController"
           stylesheets="@/css/styles.css"
           prefWidth="1280" prefHeight="800">

<BorderPane fx:id="rootPane">

    <!-- TOP NAVBAR BLANCHE -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="visiteur-nav">
            <Label text="🎓 LearnHub" styleClass="visiteur-nav-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Accueil"      styleClass="visiteur-nav-btn"
                    style="-fx-text-fill: #1E3A8A; -fx-border-color: transparent transparent #FFC107 transparent; -fx-border-width: 0 0 3 0;"
                    onAction="#goHome"/>
            <Button text="Programmes"  styleClass="visiteur-nav-btn" onAction="#goPrograms"/>
            <Button text="Actualités"  styleClass="visiteur-nav-btn" onAction="#goEvents"/>
            <Button text="Partenaires" styleClass="visiteur-nav-btn" onAction="#goPartners"/>
            <Button text="🔐  Se connecter" styleClass="visiteur-nav-login" onAction="#goLogin"/>
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-background: transparent;">
            <VBox spacing="0">

                <!-- HERO SECTION (gradient comme Symfony) -->
                <VBox styleClass="visiteur-hero" alignment="CENTER" spacing="20" minHeight="500">
                    <padding><Insets top="90" bottom="90" left="100" right="100"/></padding>
                    <Label text="Bienvenue sur LearnHub" styleClass="visiteur-hero-title"/>
                    <Label text="La plateforme tout-en-un pour la gestion scolaire, médicale et universitaire"
                           styleClass="visiteur-hero-sub" wrapText="true" maxWidth="720" textAlignment="CENTER"/>
                    <HBox spacing="20" alignment="CENTER">
                        <padding><Insets top="16"/></padding>
                        <Button text="🎓 Découvrir nos programmes" styleClass="hero-btn-primary"
                                onAction="#goPrograms"/>
                        <Button text="📅 Voir les événements" styleClass="hero-btn-outline"
                                onAction="#goEvents"/>
                    </HBox>
                </VBox>

                <!-- STATS BAR (blanc, comme Symfony) -->
                <HBox alignment="CENTER" spacing="0"
                      style="-fx-background-color: white; -fx-padding: 32 60;
                             -fx-border-color: transparent transparent #e5e7eb transparent; -fx-border-width: 0 0 1 0;">
                    <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4">
                        <Label fx:id="statEtudiantsLabel" text="1 200+"
                               style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: #1E3A8A;"/>
                        <Label text="Étudiants" style="-fx-font-size: 13.5px; -fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                    </VBox>
                    <Separator orientation="VERTICAL" prefHeight="60" style="-fx-background-color: #e5e7eb;"/>
                    <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4">
                        <Label fx:id="statModulesLabel" text="340+"
                               style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: #1E3A8A;"/>
                        <Label text="Modules" style="-fx-font-size: 13.5px; -fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                    </VBox>
                    <Separator orientation="VERTICAL" prefHeight="60" style="-fx-background-color: #e5e7eb;"/>
                    <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4">
                        <Label fx:id="statProfLabel" text="90+"
                               style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: #1E3A8A;"/>
                        <Label text="Professeurs" style="-fx-font-size: 13.5px; -fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                    </VBox>
                    <Separator orientation="VERTICAL" prefHeight="60" style="-fx-background-color: #e5e7eb;"/>
                    <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4">
                        <Label fx:id="statPartenairesLabel" text="50+"
                               style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: #1E3A8A;"/>
                        <Label text="Partenaires" style="-fx-font-size: 13.5px; -fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                    </VBox>
                </HBox>

                <!-- PROGRAMMES SECTION -->
                <VBox alignment="CENTER" spacing="20"
                      style="-fx-background-color: #f5f7fa; -fx-padding: 60 80 60 80;">
                    <Label text="Nos Formations" styleClass="section-title"/>
                    <Label text="Découvrez nos filières et programmes d'excellence"
                           style="-fx-font-size: 15px; -fx-text-fill: #6b7280; -fx-text-alignment: CENTER;"/>

                    <HBox spacing="24" alignment="CENTER">
                        <!-- Programme card 1 -->
                        <VBox spacing="16" alignment="CENTER_LEFT"
                              style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-border-color: #e5e7eb; -fx-border-radius: 16; -fx-border-width: 2;
                                     -fx-padding: 32; -fx-pref-width: 320;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 3);">
                            <Label text="🖥️"
                                   style="-fx-background-color: linear-gradient(to bottom right, #1E3A8A, #0A1F44);
                                          -fx-background-radius: 12; -fx-min-width: 64px; -fx-max-width: 64px;
                                          -fx-min-height: 64px; -fx-max-height: 64px; -fx-font-size: 28px; -fx-alignment: CENTER;"/>
                            <Label text="Informatique" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #0A1F44;"/>
                            <Label text="Licence &amp; Master en Génie Logiciel, IA, Cybersécurité"
                                   style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" wrapText="true"/>
                            <Button text="Découvrir →" styleClass="btn, btn-primary, btn-sm" onAction="#goPrograms"/>
                        </VBox>

                        <!-- Programme card 2 -->
                        <VBox spacing="16" alignment="CENTER_LEFT"
                              style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-border-color: #e5e7eb; -fx-border-radius: 16; -fx-border-width: 2;
                                     -fx-padding: 32; -fx-pref-width: 320;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 3);">
                            <Label text="📡"
                                   style="-fx-background-color: linear-gradient(to bottom right, #FFC107, #FF6F61);
                                          -fx-background-radius: 12; -fx-min-width: 64px; -fx-max-width: 64px;
                                          -fx-min-height: 64px; -fx-max-height: 64px; -fx-font-size: 28px; -fx-alignment: CENTER;"/>
                            <Label text="Télécommunications" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #0A1F44;"/>
                            <Label text="Réseaux, Systèmes embarqués, IoT"
                                   style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" wrapText="true"/>
                            <Button text="Découvrir →" styleClass="btn, btn-primary, btn-sm" onAction="#goPrograms"/>
                        </VBox>

                        <!-- Programme card 3 -->
                        <VBox spacing="16" alignment="CENTER_LEFT"
                              style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-border-color: #e5e7eb; -fx-border-radius: 16; -fx-border-width: 2;
                                     -fx-padding: 32; -fx-pref-width: 320;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 3);">
                            <Label text="💼"
                                   style="-fx-background-color: linear-gradient(to bottom right, #10b981, #059669);
                                          -fx-background-radius: 12; -fx-min-width: 64px; -fx-max-width: 64px;
                                          -fx-min-height: 64px; -fx-max-height: 64px; -fx-font-size: 28px; -fx-alignment: CENTER;"/>
                            <Label text="Gestion" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #0A1F44;"/>
                            <Label text="Finance, Marketing, Management, Commerce"
                                   style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" wrapText="true"/>
                            <Button text="Découvrir →" styleClass="btn, btn-primary, btn-sm" onAction="#goPrograms"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- FOOTER -->
                <HBox alignment="CENTER"
                      style="-fx-background-color: linear-gradient(to right, #0A1F44, #1E3A8A);
                             -fx-padding: 24 60;">
                    <Label text="© 2026 LearnHub • Plateforme d'apprentissage intelligente"
                           style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13px;"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

    <!-- FLOATING CHATBOT WIDGET -->
    <fx:include source="/fxml/chatbot_widget.fxml" />

</StackPane>

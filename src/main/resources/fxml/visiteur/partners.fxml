<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.learnhub.controller.PartnersPageController"
            style="-fx-background: #f8fafc; -fx-background-color: #f8fafc; -fx-border-color: transparent;">

    <VBox style="-fx-background-color: #f8fafc;">

        <HBox alignment="CENTER_LEFT" spacing="0" minHeight="68"
              style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 12, 0, 0, 2);">
            <padding><Insets top="0" right="36" bottom="0" left="36"/></padding>
            <Label fx:id="titleLabel" text="🎓 LearnHub"
                   style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#0A1F44;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="6">
                <Label text="Accueil" style="-fx-text-fill:#4b5563; -fx-cursor:hand; -fx-padding:6 12;" onMouseClicked="#goToHome"/>
                <Label text="Programmes" style="-fx-text-fill:#4b5563; -fx-cursor:hand; -fx-padding:6 12;" onMouseClicked="#goToPrograms"/>
                <Label text="Événements" style="-fx-text-fill:#4b5563; -fx-cursor:hand; -fx-padding:6 12;" onMouseClicked="#goToEvents"/>
                <Label text="Partenaires"
                       style="-fx-text-fill:#1e3a8a; -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:6 12;
                              -fx-border-color:#1e3a8a; -fx-border-width:0 0 2 0;" onMouseClicked="#goToPartners"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="10">
                <Button text="S'inscrire" onAction="#goToRegister"
                        style="-fx-background-color:white; -fx-text-fill:#0A1F44; -fx-font-weight:bold;
                               -fx-border-color:#0A1F44; -fx-border-width:1.5; -fx-border-radius:50;
                               -fx-background-radius:50; -fx-padding:10 22; -fx-cursor:hand;"/>
                <Button text="Se connecter" onAction="#goToLogin"
                        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #1e3a8a, #7c3aed);
                               -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:50;
                               -fx-padding:10 24; -fx-cursor:hand;"/>
            </HBox>
        </HBox>

        <VBox alignment="CENTER" spacing="18" minHeight="220"
              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #0c1445, #1a237e, #283593);">
            <padding><Insets top="56" right="40" bottom="56" left="40"/></padding>
            <Label text="Nos partenaires"
                   style="-fx-font-size:40px; -fx-font-weight:900; -fx-text-fill:white;"/>
            <Label fx:id="heroSubtitleLabel"
                   text="Entreprises et organisations partenaires de LearnHub"
                   style="-fx-font-size:15px; -fx-text-fill:rgba(255,255,255,0.85);"
                   wrapText="true" maxWidth="640" textAlignment="CENTER"/>
        </VBox>

        <HBox alignment="CENTER" spacing="0" minHeight="100"
              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #1e3a8a, #7c3aed);">
            <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
                <Label fx:id="statPartenairesLabel" text="0" style="-fx-font-size:30px; -fx-font-weight:900; -fx-text-fill:white;"/>
                <Label text="Partenaires actifs" style="-fx-font-size:12px; -fx-text-fill:rgba(255,255,255,0.82);"/>
            </VBox>
            <Region minWidth="1" maxWidth="1" minHeight="52" style="-fx-background-color:rgba(255,255,255,0.2);"/>
            <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
                <Label fx:id="statOffresLabel" text="0" style="-fx-font-size:30px; -fx-font-weight:900; -fx-text-fill:white;"/>
                <Label text="Offres de stage" style="-fx-font-size:12px; -fx-text-fill:rgba(255,255,255,0.82);"/>
            </VBox>
        </HBox>

        <VBox spacing="20" style="-fx-padding: 40 48 24 48; -fx-background-color:#f8fafc;">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <TextField fx:id="visitorSearchField" promptText="Rechercher un partenaire, une ville, un secteur…"
                           HBox.hgrow="ALWAYS" maxWidth="Infinity"
                           style="-fx-background-radius:8; -fx-border-color:#e2e8f0; -fx-border-radius:8; -fx-padding:10 14;"/>
                <Button text="Actualiser" onAction="#handleVisitorRefresh"
                        style="-fx-background-color:#1e3a8a; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:8; -fx-padding:10 20; -fx-cursor:hand;"/>
            </HBox>
            <Label fx:id="partnersStatusLabel" text="" style="-fx-text-fill:#64748b; -fx-font-size:12px;"/>
            <FlowPane fx:id="partnersFlow" alignment="TOP_LEFT" hgap="18" vgap="18"/>
        </VBox>

        <VBox alignment="CENTER" spacing="16" minHeight="140"
              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #1e3a8a, #f59e0b);">
            <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
            <Label text="Vous souhaitez devenir partenaire ?"
                   style="-fx-font-size:24px; -fx-font-weight:900; -fx-text-fill:white;"/>
            <Label text="Rejoignez notre réseau et proposez des stages à nos étudiants."
                   style="-fx-font-size:14px; -fx-text-fill:rgba(255,255,255,0.85);"/>
            <Button text="Créer un compte" onAction="#goToRegister"
                    style="-fx-background-color:white; -fx-text-fill:#1e3a8a; -fx-font-weight:800;
                           -fx-background-radius:50; -fx-padding:12 32; -fx-cursor:hand;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="6" minHeight="72"
              style="-fx-background-color:#0A1F44;">
            <padding><Insets top="22" right="40" bottom="22" left="40"/></padding>
            <Label text="© 2026 LearnHub · Plateforme universitaire"
                   style="-fx-text-fill:rgba(255,255,255,0.7); -fx-font-size:12px;"/>
        </VBox>

    </VBox>
</ScrollPane>

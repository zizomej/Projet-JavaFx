<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.admin.SeancesController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="5">
                <Label text="🎓 LearnHub" styleClass="sidebar-brand-text"/>
                <Label text="Espace Administrateur" styleClass="sidebar-brand-sub"/>
            </VBox>
            <VBox spacing="2" style="-fx-padding: 10 0;">
                <Label text="NAVIGATION" styleClass="nav-section-title"/>
                <Button text="🏠  Tableau de bord" styleClass="nav-btn" onAction="#goBack" maxWidth="Infinity"/>
                <Label text="PÉDAGOGIE" styleClass="nav-section-title"/>
                <Button text="📅  Séances" styleClass="nav-btn, nav-btn-active" maxWidth="Infinity"/>
                <Button text="🚀  Outils Avancés" styleClass="nav-btn" onAction="#goMetiers" maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="admin-section" spacing="10">
                <Button text="🚪  Déconnexion" styleClass="nav-logout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <StackPane styleClass="root-container">
                <VBox styleClass="content-area" spacing="35" alignment="TOP_CENTER" maxWidth="1100" style="-fx-padding: 40 60;">
                    
                    <!-- TOP BANNER (Blue Layout) -->
                    <HBox styleClass="card" style="-fx-padding: 30 40; -fx-background-color: #1E3A8A; -fx-border-width: 0; -fx-background-radius: 12;" alignment="CENTER_LEFT" spacing="20">
                        <Label text="📅" style="-fx-font-size: 36px; -fx-text-fill: white;"/>
                        <VBox spacing="6">
                            <Label text="Gestion des Séances" styleClass="page-title" style="-fx-text-fill: white; -fx-font-size: 26px;"/>
                            <Label text="Organisation de l'emploi du temps et optimisation des ressources" styleClass="page-subtitle" style="-fx-text-fill: #e0e7ff; -fx-font-size: 14px;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Nouvelle Séance" styleClass="btn-add-premium" onAction="#handleAdd" 
                                style="-fx-background-color: #ffc107; -fx-text-fill: #1e3a8a; -fx-font-weight: 800; -fx-padding: 12 25;"/>
                    </HBox>

                    <!-- FILTERS AREA -->
                    <VBox styleClass="card" style="-fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 15, 0, 0, 5);" spacing="15">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <TextField fx:id="searchField" promptText="🔍 Rechercher par module, salle ou mot-clé..." styleClass="search-field" HBox.hgrow="ALWAYS" prefHeight="50"/>
                            <Button text="↻" onAction="#handleRefresh" 
                                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-size: 20px; -fx-padding: 8 18; -fx-background-radius: 12; -fx-cursor: hand;"/>
                        </HBox>
                        <HBox spacing="15">
                            <ComboBox fx:id="comboModule" promptText="📚 Tous les modules" styleClass="filter-combo" prefWidth="300" HBox.hgrow="ALWAYS" prefHeight="45"/>
                            <ComboBox fx:id="comboSalle" promptText="🏫 Toutes les salles" styleClass="filter-combo" prefWidth="250" HBox.hgrow="ALWAYS" prefHeight="45"/>
                            <ComboBox fx:id="comboType" promptText="📝 Tous les types" styleClass="filter-combo" prefWidth="200" HBox.hgrow="ALWAYS" prefHeight="45"/>
                        </HBox>
                    </VBox>

                    <!-- STATS BOXES -->
                    <HBox spacing="25">
                        <VBox styleClass="card" HBox.hgrow="ALWAYS" style="-fx-padding: 22;" spacing="10">
                            <Label text="💼" style="-fx-font-size: 24px; -fx-background-color: #e0e7ff; -fx-padding: 6 12; -fx-background-radius: 10; -fx-max-width: 48;"/>
                            <Label fx:id="totalSeancesLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #111827;"/>
                            <Label text="Séances Totales" style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        </VBox>
                        
                        <VBox styleClass="card" HBox.hgrow="ALWAYS" style="-fx-padding: 22;" spacing="10">
                            <Label text="🏛" style="-fx-font-size: 24px; -fx-background-color: #e0e7ff; -fx-padding: 6 12; -fx-background-radius: 10; -fx-max-width: 48;"/>
                            <Label fx:id="lblSallesOccupies" text="12" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #111827;"/>
                            <Label text="Salles Occupées" style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        </VBox>

                        <VBox styleClass="card" HBox.hgrow="ALWAYS" style="-fx-padding: 22;" spacing="10">
                            <Label text="📈" style="-fx-font-size: 24px; -fx-background-color: #d1fae5; -fx-padding: 6 12; -fx-background-radius: 10; -fx-max-width: 48;"/>
                            <Label fx:id="lblTauxOccupation" text="85%" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #111827;"/>
                            <Label text="Taux d'Occupation" style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>

                    <!-- TABLE CARD -->
                    <VBox styleClass="card" VBox.vgrow="ALWAYS" style="-fx-padding: 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 30, 0, 0, 15);">
                        <VBox styleClass="card-body" VBox.vgrow="ALWAYS" style="-fx-padding:20; -fx-background-color: white; -fx-background-radius: 12;">
                            <TableView fx:id="table" VBox.vgrow="ALWAYS" fixedCellSize="55" styleClass="premium-table">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="colDate" text="📅 DATE" prefWidth="120"/>
                                    <TableColumn fx:id="colHeure" text="⏰ HEURE" prefWidth="110"/>
                                    <TableColumn fx:id="colModule" text="🏫 MODULE" prefWidth="320"/>
                                    <TableColumn fx:id="colSalle" text="📍 SALLE" prefWidth="130"/>
                                    <TableColumn fx:id="colType" text="📝 TYPE" prefWidth="110"/>
                                    <TableColumn fx:id="colActions" text="⚙ ACTIONS" prefWidth="140"/>
                                </columns>
                                <placeholder>
                                    <VBox alignment="CENTER" spacing="15">
                                        <Label text="📭" style="-fx-font-size: 40px;"/>
                                        <Label text="Aucune séance planifiée pour le moment." style="-fx-text-fill:#94a3b8; -fx-font-size: 16px;"/>
                                    </VBox>
                                </placeholder>
                            </TableView>
                        </VBox>
                    </VBox>
                    
                </VBox>
            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>

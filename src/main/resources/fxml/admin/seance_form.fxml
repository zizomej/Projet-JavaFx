<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.admin.SeanceFormController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="5">
                <Label text="🎓 LearnHub" styleClass="sidebar-brand-text"/>
                <Label text="Espace Administrateur" styleClass="sidebar-brand-sub"/>
            </VBox>
            <VBox spacing="2" style="-fx-padding: 10 0;">
                <Label text="NAVIGATION" styleClass="nav-section-title"/>
                <Button text="🏠  Tableau de bord" styleClass="nav-btn" onAction="#goBack" maxWidth="Infinity"/>
                <Label text="PÉDAGOGIE" styleClass="nav-section-title"/>
                <Button text="📅  Séances" styleClass="nav-btn, nav-btn-active" onAction="#goBack" maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="admin-section" spacing="10">
                <Button text="🚪  Déconnexion" styleClass="nav-logout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:#f5f7fa;-fx-border-color:transparent;">
            <VBox styleClass="content-area" spacing="24">
                
                <!-- TOP HEADER -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label fx:id="titleLabel" text="Planifier une Séance" styleClass="page-title"/>
                        <Label text="Définir le créneau horaire, le module et la salle" styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="← Retour à la liste" styleClass="btn, btn-secondary, btn-sm" onAction="#goBack"/>
                </HBox>

                <!-- CARD FORM -->
                <VBox styleClass="card" spacing="20" style="-fx-padding:30;">
                    
                    <GridPane hgap="30" vgap="25">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints vgrow="SOMETIMES" />
                            <RowConstraints vgrow="SOMETIMES" />
                            <RowConstraints vgrow="SOMETIMES" />
                        </rowConstraints>
                        
                        <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Module" style="-fx-font-weight:bold; -fx-text-fill: #1e293b;"/>
                            <ComboBox fx:id="moduleCombo" promptText="Sélectionner le module" prefWidth="Infinity" prefHeight="45" styleClass="search-field"/>
                        </VBox>
                        
                        <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Date" style="-fx-font-weight:bold; -fx-text-fill: #1e293b;"/>
                            <DatePicker fx:id="datePicker" prefWidth="Infinity" prefHeight="45" styleClass="search-field"/>
                        </VBox>
                        
                        <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Heure de début" style="-fx-font-weight:bold; -fx-text-fill: #1e293b;"/>
                            <TextField fx:id="heureDebutField" promptText="Ex: 08:30" styleClass="search-field" prefHeight="45"/>
                        </VBox>
                        
                        <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Heure de fin" style="-fx-font-weight:bold; -fx-text-fill: #1e293b;"/>
                            <TextField fx:id="heureFinField" promptText="Ex: 10:30" styleClass="search-field" prefHeight="45"/>
                        </VBox>
                        
                        <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label text="Salle" style="-fx-font-weight:bold; -fx-text-fill: #1e293b;"/>
                            <TextField fx:id="salleField" promptText="Ex: Amphi A / Labo 1" styleClass="search-field" prefHeight="45"/>
                        </VBox>
                        
                        <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label text="Type de séance" style="-fx-font-weight:bold; -fx-text-fill: #1e293b;"/>
                            <ComboBox fx:id="typeCombo" promptText="Sélectionner le type" prefWidth="Infinity" prefHeight="45" styleClass="search-field"/>
                        </VBox>
                    </GridPane>


                    
                    <!-- BOTTOM ACTIONS -->
                    <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 20 0 0 0; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
                        <Button text="Annuler" styleClass="btn, btn-secondary" prefWidth="120" prefHeight="40" onAction="#goBack"/>
                        <Button text="Enregistrer la séance" styleClass="btn, btn-primary" style="-fx-background-color: #0A1F44; -fx-text-fill: white;" prefWidth="150" prefHeight="40" onAction="#handleSave"/>
                    </HBox>
                    
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

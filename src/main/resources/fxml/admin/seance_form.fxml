<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.admin.SeanceFormController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="5">
                <Label text="🎓 LearnHub" styleClass="sidebar-brand-text"/>
                <Label text="Espace Administrateur" styleClass="sidebar-brand-sub"/>
            </VBox>
            <VBox spacing="2" style="-fx-padding: 10 0;">
                <Label text="NAVIGATION" styleClass="nav-section-title"/>
                <Button text="🏠  Tableau de bord" styleClass="nav-btn" onAction="#goBack" maxWidth="Infinity"/>
                <Label text="PÉDAGOGIE" styleClass="nav-section-title"/>
                <Button text="📅  Séances" styleClass="nav-btn, nav-btn-active" onAction="#goBack" maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="admin-section" spacing="10">
                <Button text="🚪  Déconnexion" styleClass="nav-logout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <StackPane styleClass="root-container">
                <VBox styleClass="content-area" spacing="35" style="-fx-padding: 40 60;">
                    
                    <!-- TOP HEADER (Modernized) -->
                    <VBox spacing="10" style="-fx-background-color: transparent; -fx-padding: 0 0 10 0;">
                        <HBox alignment="CENTER_LEFT" spacing="25">
                            <VBox HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="✨" style="-fx-font-size: 32px;"/>
                                    <Label fx:id="titleLabel" text="Planifier une Séance" styleClass="page-title" style="-fx-font-size: 30px; -fx-font-weight: 900; -fx-text-fill: #1e3a8a;"/>
                                </HBox>
                                <Label text="Définissez le créneau horaire, le module et la salle pour cette séance." styleClass="page-subtitle" style="-fx-font-size: 15px; -fx-text-fill: #64748b;"/>
                            </VBox>
                            <Button text="← Retour à la liste" onAction="#goBack" 
                                    style="-fx-background-color: white; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="30" style="-fx-padding: 0 20;">
                        <!-- CARD FORM with accent -->
                        <VBox styleClass="card, card-accent" spacing="45" style="-fx-padding:55; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 40, 0, 0, 20);">
                            
                            <VBox spacing="30">
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label text="🏫" styleClass="icon-blue" style="-fx-font-size: 24px;"/>
                                    <Label text="Configuration de la séance" style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #0f172a;"/>
                                </HBox>
                                
                                <GridPane hgap="40" vgap="30">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                    </columnConstraints>
                                    
                                    <!-- Ligne 1: Module & Date -->
                                    <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Label text="Module" styleClass="form-label"/>
                                        <ComboBox fx:id="moduleCombo" promptText="Sélectionner le module" maxWidth="Infinity" prefHeight="52" styleClass="form-control"/>
                                    </VBox>
                                    <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Label text="Date de la séance" styleClass="form-label"/>
                                        <DatePicker fx:id="datePicker" promptText=" jj / mm / aaaa" maxWidth="Infinity" prefHeight="52" styleClass="form-control"/>
                                    </VBox>
                                    
                                    <!-- Ligne 2: Heures -->
                                    <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                        <Label text="Heure de début" styleClass="form-label"/>
                                        <TextField fx:id="heureDebutField" promptText="Ex: 08:30" styleClass="form-control" prefHeight="52"/>
                                    </VBox>
                                    <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Label text="Heure de fin" styleClass="form-label"/>
                                        <TextField fx:id="heureFinField" promptText="Ex: 10:30" styleClass="form-control" prefHeight="52"/>
                                    </VBox>
                                    
                                    <!-- Ligne 3: Salle & Type -->
                                    <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                        <Label text="Salle" styleClass="form-label"/>
                                        <TextField fx:id="salleField" promptText="Ex: Amphi A / Labo 1" styleClass="form-control" prefHeight="52"/>
                                    </VBox>
                                    <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                        <Label text="Type de séance" styleClass="form-label"/>
                                        <ComboBox fx:id="typeCombo" promptText="Cours / TD / TP" maxWidth="Infinity" prefHeight="52" styleClass="form-control"/>
                                    </VBox>
                                </GridPane>
                            </VBox>

                            <Separator style="-fx-opacity: 0.3;"/>

                            <!-- ACTIONS -->
                            <HBox alignment="CENTER_RIGHT" spacing="25" style="-fx-padding: 10 0 0 0;">
                                <Button text="Annuler" styleClass="btn-cancel-pink" onAction="#goBack" prefWidth="140" prefHeight="48"/>
                                <Button text="Enregistrer la séance" styleClass="btn-save-premium" onAction="#handleSave" prefWidth="250" prefHeight="48"/>
                            </HBox>
                            
                        </VBox>
                    </VBox>
                </VBox>
            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.admin.EvenementsController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="5">
                <Label text="🎓 LearnHub" styleClass="sidebar-brand-text"/>
                <Label text="Espace Administrateur" styleClass="sidebar-brand-sub"/>
            </VBox>
            <VBox spacing="2" style="-fx-padding: 10 0;">
                <Label text="NAVIGATION" styleClass="nav-section-title"/>
                <Button text="🏠  Tableau de bord" styleClass="nav-btn" onAction="#goBack" maxWidth="Infinity"/>
                <Label text="VIE SCOLAIRE" styleClass="nav-section-title"/>
                <Button text="🎉  Événements" styleClass="nav-btn, nav-btn-active" maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="admin-section" spacing="10">
                <Button text="🚪  Déconnexion" styleClass="nav-logout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:#f5f7fa;-fx-border-color:transparent;">
            <VBox styleClass="content-area" spacing="24">
                
                <!-- TOPBAR (Style Symfony Premium) -->
                <HBox alignment="CENTER_LEFT" spacing="20" styleClass="topbar" style="-fx-background-color: white; -fx-padding: 15 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2); -fx-background-radius: 0 0 15 15;">
                    <VBox HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="🎉" style="-fx-font-size:26px;"/>
                            <Label text="Gestion des Événements" styleClass="page-title" style="-fx-font-size: 24px; -fx-font-weight: 800;"/>
                        </HBox>
                        <Label text="Gérer les événements académiques" styleClass="page-subtitle" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                    </VBox>
                    
                    <HBox alignment="CENTER_RIGHT" spacing="15">
                        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f3f4f6; -fx-background-radius: 25; -fx-padding: 5 15; -fx-border-color: #FFC107; -fx-border-radius: 25; -fx-border-width: 1.5;">
                            <TextField fx:id="navbarSearchField" promptText="Rechercher..." style="-fx-background-color: transparent; -fx-pref-width: 180; -fx-font-size: 13px;"/>
                            <Label text="🔍" style="-fx-text-fill: #3b82f6;"/>
                        </HBox>
                        <StackPane style="-fx-background-color: #fef3c7; -fx-background-radius: 50; -fx-padding: 8;">
                            <Label text="🔔" style="-fx-font-size: 18px;"/>
                            <Label text="4" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 9px; -fx-padding: 2 5; -fx-background-radius: 10;" StackPane.alignment="TOP_RIGHT"/>
                        </StackPane>
                        <Button style="-fx-background-color: #f3f4f6; -fx-background-radius: 50; -fx-padding: 8;">
                            <graphic><Label text="⚙️" style="-fx-font-size: 18px;"/></graphic>
                        </Button>
                    </HBox>
                </HBox>

                <VBox spacing="24" style="-fx-padding: 0 25;">
                    <!-- HEADER ACTIONS (Style Sub-Header) -->
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <VBox>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="🎉" style="-fx-font-size:24px;"/>
                                <Label text="Gestion des Événements" style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #0A1F44;"/>
                            </HBox>
                            <Label text="Calendrier des événements académiques" style="-fx-text-fill: #6b7280; -fx-font-size: 14px;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Ajouter un événement" onAction="#handleAdd" style="-fx-background-color: #0A1F44; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 14px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 2);"/>
                    </HBox>

                    <!-- STATS CARDS (Style Premium Grid) -->
                    <GridPane hgap="25" vgap="25">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
                        </columnConstraints>
                        
                        <VBox GridPane.columnIndex="0" styleClass="stat-card, stat-card-primary" alignment="CENTER">
                            <Label text="Total Événements" styleClass="stat-label"/>
                            <Label fx:id="totalEventsLabel" text="1" styleClass="stat-value"/>
                        </VBox>
                        
                        <VBox GridPane.columnIndex="1" styleClass="stat-card, stat-card-success" alignment="CENTER">
                            <Label text="Confirmés" styleClass="stat-label, stat-label-success"/>
                            <Label fx:id="confirmedEventsLabel" text="0" styleClass="stat-value" style="-fx-text-fill: #10b981;"/>
                        </VBox>
                        
                        <VBox GridPane.columnIndex="2" styleClass="stat-card, stat-card-warning" alignment="CENTER">
                            <Label text="En attente" styleClass="stat-label, stat-label-warning"/>
                            <Label fx:id="pendingEventsLabel" text="0" styleClass="stat-value" style="-fx-text-fill: #d97706;"/>
                        </VBox>
                        
                        <VBox GridPane.columnIndex="3" styleClass="stat-card, stat-card-danger" alignment="CENTER">
                            <Label text="Total Participants" styleClass="stat-label, stat-label-danger"/>
                            <Label fx:id="participantsLabel" text="0" styleClass="stat-value" style="-fx-text-fill: #ef4444;"/>
                        </VBox>
                    </GridPane>

                    <!-- TABLE AREA -->
                    <VBox styleClass="card" style="-fx-background-radius: 12; -fx-padding: 24; -fx-spacing: 20;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📋 Liste des événements" fx:id="tableHeaderLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0A1F44;"/>
                        </HBox>
                        
                        <TableView fx:id="table" styleClass="premium-table" VBox.vgrow="ALWAYS" prefHeight="450">
                            <columns>
                                <TableColumn fx:id="colDate" text="Date" prefWidth="150" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colTitre" text="Titre" prefWidth="250" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                                <TableColumn fx:id="colType" text="Type" prefWidth="120" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colLieu" text="Lieu" prefWidth="180" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colStatut" text="Statut" prefWidth="120" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colActions" text="Actions" prefWidth="150" style="-fx-alignment: CENTER;"/>
                            </columns>
                            <placeholder>
                                <Label text="📭 Aucun événement trouvé" style="-fx-text-fill:#9ca3af;"/>
                            </placeholder>
                        </TableView>
                    </VBox>
                </VBox>
                
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.learnhub.controller.admin.demandestage.StatutDemandePopupController"
           stylesheets="@/css/styles.css"
           style="-fx-background-color: transparent;">

    <VBox alignment="TOP_CENTER" spacing="0" maxWidth="520" minWidth="480"
          style="-fx-background-color: white; -fx-background-radius: 16;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 30, 0, 0, 10);">

        <!-- Dynamic Header (color changes: green for accept, red for refuse) -->
        <HBox fx:id="headerBox" alignment="CENTER_LEFT" spacing="14" minHeight="80"
              style="-fx-background-color: #1e3a8a; -fx-background-radius: 16 16 0 0; -fx-padding: 22 28;">
            <Label fx:id="headerIcon" text="✅" style="-fx-font-size: 32px;"/>
            <VBox HBox.hgrow="ALWAYS" spacing="4">
                <Label fx:id="headerTitle" text="Accepter la candidature"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label fx:id="headerSubtitle" text="Cette action sera notifiée à l'étudiant"
                       style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.75);"/>
            </VBox>
            <Button text="✕" onAction="#handleClose"
                    style="-fx-background-color: rgba(255,255,255,0.18); -fx-text-fill: white;
                           -fx-background-radius: 50; -fx-min-width: 34; -fx-min-height: 34;
                           -fx-font-weight: bold; -fx-cursor: hand; -fx-border-width: 0;"/>
        </HBox>

        <!-- Info Cards Row -->
        <HBox spacing="12" style="-fx-padding: 20 28 10 28;">
            <VBox HBox.hgrow="ALWAYS" spacing="4"
                  style="-fx-background-color: #f0f9ff; -fx-background-radius: 10; -fx-padding: 14;">
                <Label text="👤 Étudiant" style="-fx-font-size: 10px; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                <Label fx:id="lblEtudiant" text="—"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" wrapText="true"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" spacing="4"
                  style="-fx-background-color: #fff7ed; -fx-background-radius: 10; -fx-padding: 14;">
                <Label text="💼 Offre" style="-fx-font-size: 10px; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                <Label fx:id="lblOffre" text="—"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" wrapText="true"/>
            </VBox>
        </HBox>

        <!-- Score badge (shown when matching score available) -->
        <HBox fx:id="scoreBox" alignment="CENTER_LEFT" spacing="12" visible="false" managed="false"
              style="-fx-padding: 0 28 10 28;">
            <VBox spacing="4" style="-fx-background-color: #ecfdf5; -fx-background-radius: 10; -fx-padding: 12 18;"
                  HBox.hgrow="ALWAYS">
                <Label text="🎯 Score de Matching" style="-fx-font-size: 10px; -fx-text-fill: #059669; -fx-font-weight: bold;"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="lblScore" text="—"
                           style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #059669;"/>
                    <Label fx:id="lblCategorie" text=""
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 4 10;
                                  -fx-background-radius: 999; -fx-background-color: #d1fae5; -fx-text-fill: #065f46;"/>
                </HBox>
            </VBox>
        </HBox>

        <!-- Comment Section -->
        <VBox spacing="8" style="-fx-padding: 0 28 20 28;">
            <Label text="💬 Commentaire / Motif de décision"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
            <TextArea fx:id="txtCommentaire" prefRowCount="4" wrapText="true"
                      promptText="Saisir un commentaire explicatif pour l'étudiant (optionnel)..."
                      style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0;
                             -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 13px;"/>
            <Label fx:id="lblErreur" text="" visible="false" managed="false"
                   style="-fx-text-fill: #ef4444; -fx-font-size: 12px;"/>
        </VBox>

        <!-- Action Buttons -->
        <HBox alignment="CENTER_RIGHT" spacing="12"
              style="-fx-padding: 16 28 24 28; -fx-border-color: #f1f5f9; -fx-border-width: 1 0 0 0;">
            <Button text="Annuler" onAction="#handleClose"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-padding: 10 22; -fx-cursor: hand; -fx-border-width: 0;"/>
            <Button fx:id="btnConfirm" text="✅  Confirmer"
                    onAction="#handleConfirm"
                    style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-padding: 10 28; -fx-cursor: hand; -fx-border-width: 0;
                           -fx-font-size: 14px;"/>
        </HBox>

    </VBox>
</StackPane>

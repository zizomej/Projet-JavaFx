<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.admin.ModulesController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">

    <!-- SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="5">
                <Label text="🎓 LearnHub" styleClass="sidebar-brand-text"/>
                <Label text="Espace Administrateur" styleClass="sidebar-brand-sub"/>
            </VBox>
            <VBox spacing="2" style="-fx-padding: 10 0;">
                <Label text="NAVIGATION" styleClass="nav-section-title"/>
                <Button text="🏠  Dashboard" styleClass="nav-btn" onAction="#goDashboard" maxWidth="Infinity"/>
                <Button text="📚  Modules" styleClass="nav-btn, nav-btn-active" maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="admin-section" spacing="10">
                <Button text="🚪 Déconnexion" styleClass="nav-logout" onAction="#handleLogout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox styleClass="content-area" spacing="30" style="-fx-padding: 40 60;">
                
                <!-- Banner -->
                <HBox style="-fx-background-color: linear-gradient(to right, #1E3A8A, #6366f1); -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);" alignment="CENTER_LEFT" spacing="20">
                    <StackPane style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 12; -fx-padding: 15;">
                        <Label text="📚" style="-fx-font-size: 30px;"/>
                    </StackPane>
                    <VBox spacing="5">
                        <Label text="Catalogue des Modules" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: 900;"/>
                        <Label text="Consultez et gérez les ressources pédagogiques par module." style="-fx-text-fill: #e0e7ff; -fx-font-size: 14px;"/>
                    </VBox>
                </HBox>

                <!-- Search and Filters -->
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                    <TextField fx:id="searchField" promptText="🔍 Rechercher un module ou une ressource..." HBox.hgrow="ALWAYS" style="-fx-background-color: #f8fafc; -fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #e2e8f0;"/>
                    <ComboBox fx:id="comboSemestre" promptText="Semestre" prefWidth="180" style="-fx-background-color: #f8fafc; -fx-background-radius: 10;"/>
                </HBox>

                <!-- Split Content -->
                <HBox spacing="25" VBox.vgrow="ALWAYS">
                    <!-- Modules Column -->
                    <VBox spacing="15" prefWidth="400" minWidth="350">
                        <Label text="Modules Disponibles" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: #1e293b;"/>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                            <VBox fx:id="modulesContainer" spacing="12"/>
                        </ScrollPane>
                    </VBox>

                    <!-- Resources Column -->
                    <VBox spacing="20" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📂" style="-fx-font-size: 20px;"/>
                            <Label text="Ressources Pédagogiques" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #1e293b;"/>
                        </HBox>
                        <Separator/>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                            <VBox fx:id="resourcesContainer" spacing="15"/>
                        </ScrollPane>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

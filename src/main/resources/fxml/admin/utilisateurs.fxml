<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.admin.UtilisateursController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">

    <!-- SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="5">
                <Label text="🎓 LearnHub" styleClass="sidebar-brand-text"/>
                <Label text="Espace Administrateur" styleClass="sidebar-brand-sub"/>
            </VBox>
            <VBox spacing="2" style="-fx-padding: 10 0;">
                <Label text="NAVIGATION" styleClass="nav-section-title"/>
                <Button text="🏠  Tableau de bord" styleClass="nav-btn" onAction="#goBack" maxWidth="Infinity"/>
                <Button text="👥  Utilisateurs" styleClass="nav-btn, nav-btn-active" maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="admin-section" spacing="10">
                <Button text="🚪  Déconnexion" styleClass="nav-logout" onAction="#handleLogout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox styleClass="content-area" spacing="30" style="-fx-padding: 40 60;">
                
                <!-- Top Banner -->
                <HBox style="-fx-background-color: linear-gradient(to right, #1E3A8A, #10B981); -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);" alignment="CENTER_LEFT" spacing="20">
                    <StackPane style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 12; -fx-padding: 15;">
                        <Label text="👥" style="-fx-font-size: 30px;"/>
                    </StackPane>
                    <VBox spacing="5">
                        <Label text="Gestion des Utilisateurs" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: 900;"/>
                        <Label text="Administrez les comptes étudiants, professeurs et personnels." style="-fx-text-fill: #ecfdf5; -fx-font-size: 14px;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="+ Ajouter un Utilisateur" onAction="#handleAdd" style="-fx-background-color: white; -fx-text-fill: #10B981; -fx-font-weight: 800; -fx-padding: 12 25; -fx-background-radius: 10; -fx-cursor: hand;"/>
                </HBox>

                <!-- Filter Card -->
                <HBox styleClass="card" spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 20; -fx-background-radius: 15; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                    <TextField fx:id="searchField" promptText="🔍 Rechercher un nom, email..." HBox.hgrow="ALWAYS" style="-fx-background-color: #f8fafc; -fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;"/>
                    <ComboBox fx:id="roleFilter" promptText="📋 Filtrer par rôle" prefWidth="200" style="-fx-background-color: #f8fafc; -fx-padding: 8; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;"/>
                    <Button text="↻" onAction="#handleRefresh" style="-fx-background-color: #f1f5f9; -fx-padding: 10 15; -fx-background-radius: 10; -fx-cursor: hand;"/>
                </HBox>

                <!-- Table Card -->
                <VBox styleClass="card" VBox.vgrow="ALWAYS" style="-fx-padding: 0; -fx-background-radius: 15; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="premium-table" style="-fx-padding: 10;">
                        <columns>
                            <TableColumn fx:id="colNom" text="NOM" prefWidth="150"/>
                            <TableColumn fx:id="colPrenom" text="PRÉNOM" prefWidth="150"/>
                            <TableColumn fx:id="colEmail" text="EMAIL" prefWidth="250"/>
                            <TableColumn fx:id="colRole" text="RÔLE" prefWidth="120"/>
                            <TableColumn fx:id="colTelephone" text="TÉLÉPHONE" prefWidth="150"/>
                            <TableColumn fx:id="colActif" text="STATUT" prefWidth="100"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                    
                    <HBox style="-fx-padding: 15 25; -fx-background-color: #f8fafc; -fx-background-radius: 0 0 15 15;" spacing="15" alignment="CENTER_RIGHT">
                        <Label fx:id="statusLabel" text="Total: 0 utilisateurs" style="-fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="✏️ Modifier" onAction="#handleEdit" style="-fx-background-color: #fffbeb; -fx-text-fill: #f59e0b; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                        <Button text="🗑 Supprimer" onAction="#handleDelete" style="-fx-background-color: #fef2f2; -fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.admin.UniversiteFormController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="5">
                <Label text="🎓 LearnHub" styleClass="sidebar-brand-text"/>
                <Label text="Espace Administrateur" styleClass="sidebar-brand-sub"/>
            </VBox>
            <VBox spacing="2" style="-fx-padding: 10 0;">
                <Label text="NAVIGATION" styleClass="nav-section-title"/>
                <Button text="🏠  Tableau de bord" styleClass="nav-btn" onAction="#goBack" maxWidth="Infinity"/>
                <Label text="STAGE" styleClass="nav-section-title"/>
                <Button text="🏫  Universités" styleClass="nav-btn, nav-btn-active" onAction="#goBack" maxWidth="Infinity"/>
                <Button text="💼  Offres de Stage" styleClass="nav-btn" maxWidth="Infinity"/>
                <Button text="📝  Demandes Stage" styleClass="nav-btn" maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="admin-section" spacing="10">
                <Button text="🚪  Déconnexion" styleClass="nav-logout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:#f5f7fa;-fx-border-color:transparent;">
            <VBox styleClass="content-area" spacing="24">
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label fx:id="titleLabel" text="Ajouter une université" styleClass="page-title"/>
                        <Label text="Gérer les informations de l'établissement sélectionné" styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="← Retour à la liste" styleClass="btn, btn-secondary, btn-sm" onAction="#goBack"/>
                </HBox>
                <VBox styleClass="card" spacing="20" style="-fx-padding:30;">
                    <VBox spacing="8">
                        <Label text="Nom de l'université" style="-fx-font-weight:bold;"/>
                        <TextField fx:id="nomField" promptText="Ex: Université Virtuelle de Tunis" styleClass="search-field" prefHeight="40"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Type d'établissement" style="-fx-font-weight:bold;"/>
                        <ComboBox fx:id="secteurCombo" promptText="Sélectionnez le type" prefWidth="Infinity" prefHeight="40" styleClass="search-field"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Ville" style="-fx-font-weight:bold;"/>
                        <TextField fx:id="villeField" promptText="Ex: Tunis" styleClass="search-field" prefHeight="40"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Téléphone" style="-fx-font-weight:bold;"/>
                        <TextField fx:id="telephoneField" promptText="Ex: +216 71 123 456" styleClass="search-field" prefHeight="40"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Adresse complète" style="-fx-font-weight:bold;"/>
                        <TextField fx:id="adresseField" promptText="Ex: Avenue Ibn Sina, Tunis" styleClass="search-field" prefHeight="40"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Email de contact" style="-fx-font-weight:bold;"/>
                        <TextField fx:id="emailField" promptText="Ex: contact@universite.tn" styleClass="search-field" prefHeight="40"/>
                    </VBox>
                    <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 20 0 0 0; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
                        <Button text="Annuler" styleClass="btn, btn-secondary" prefWidth="120" prefHeight="40" onAction="#goBack"/>
                        <Button text="Enregistrer" styleClass="btn, btn-primary" style="-fx-background-color: #059669; -fx-text-fill: white;" prefWidth="120" prefHeight="40" onAction="#handleSave"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.admin.UniversiteFormController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="5">
                <Label text="🎓 LearnHub" styleClass="sidebar-brand-text"/>
                <Label text="Espace Administrateur" styleClass="sidebar-brand-sub"/>
            </VBox>
            <VBox spacing="2" style="-fx-padding: 10 0;">
                <Label text="NAVIGATION" styleClass="nav-section-title"/>
                <Button text="🏠  Tableau de bord" styleClass="nav-btn" onAction="#goBack" maxWidth="Infinity"/>
                <Label text="STAGE" styleClass="nav-section-title"/>
                <Button text="🏫  Universités" styleClass="nav-btn, nav-btn-active" onAction="#goBack" maxWidth="Infinity"/>
                <Button text="💼  Offres de Stage" styleClass="nav-btn" maxWidth="Infinity"/>
                <Button text="📝  Demandes Stage" styleClass="nav-btn" maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="admin-section" spacing="10">
                <Button text="🚪  Déconnexion" styleClass="nav-logout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:#f5f7fa;-fx-border-color:transparent;">
            <VBox styleClass="content-area" spacing="30" style="-fx-padding: 35 50;">
                
                <!-- BANNER HEADER -->
                <VBox spacing="10" style="-fx-background-color: linear-gradient(to right, #0A1F44, #1e3a8a, #4f46e5); -fx-background-radius: 20; -fx-padding: 35 45; -fx-effect: dropshadow(gaussian, rgba(30,58,138,0.3), 25, 0, 0, 10);">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox HBox.hgrow="ALWAYS" spacing="6">
                            <Label fx:id="titleLabel" text="Ajouter une université" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                            <Label text="Partenariats académiques et établissements d'enseignement" style="-fx-font-size: 15px; -fx-text-fill: rgba(255,255,255,0.75);"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="← Retour à la liste" onAction="#goBack"
                                styleClass="btn-cancel-pink" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.3);"/>
                    </HBox>
                </VBox>

                <!-- FORM CARD -->
                <VBox styleClass="card" maxWidth="900" alignment="CENTER" style="-fx-padding: 40; -fx-background-radius: 20; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 30, 0, 0, 10);">
                    <GridPane vgap="25" hgap="30">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="300" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="300" />
                        </columnConstraints>
                        
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Nom de l'université *" styleClass="form-label"/>
                            <TextField fx:id="nomField" promptText="Ex: Esprit, UVT..." styleClass="form-control"/>
                            <Label fx:id="nomErrorLabel" styleClass="error-label" visible="false" managed="false"/>
                        </VBox>
                        
                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Type d'établissement *" styleClass="form-label"/>
                            <ComboBox fx:id="secteurCombo" promptText="Sélectionnez le type" prefWidth="Infinity" styleClass="form-control"/>
                            <Label fx:id="secteurErrorLabel" styleClass="error-label" visible="false" managed="false"/>
                        </VBox>
                        
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Ville *" styleClass="form-label"/>
                            <TextField fx:id="villeField" promptText="Ex: Tunis, Ariana..." styleClass="form-control"/>
                            <Label fx:id="villeErrorLabel" styleClass="error-label" visible="false" managed="false"/>
                        </VBox>
                        
                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Téléphone *" styleClass="form-label"/>
                            <TextField fx:id="telephoneField" promptText="Ex: +216 71 856 935" styleClass="form-control"/>
                            <Label fx:id="telephoneErrorLabel" styleClass="error-label" visible="false" managed="false"/>
                        </VBox>
                        
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                            <Label text="Adresse complète *" styleClass="form-label"/>
                            <TextField fx:id="adresseField" promptText="Ex: Pôle Technologique El Ghazala..." styleClass="form-control"/>
                            <Label fx:id="adresseErrorLabel" styleClass="error-label" visible="false" managed="false"/>
                        </VBox>
                        
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                            <Label text="Email de contact *" styleClass="form-label"/>
                            <TextField fx:id="emailField" promptText="Ex: contact@universite.tn" styleClass="form-control"/>
                            <Label fx:id="emailErrorLabel" styleClass="error-label" visible="false" managed="false"/>
                        </VBox>
                    </GridPane>

                    <HBox spacing="20" alignment="CENTER" style="-fx-padding: 40 0 0 0;">
                        <Button text="Annuler" onAction="#goBack" styleClass="btn-cancel-pink" prefWidth="180" prefHeight="45"/>
                        <Button text="Enregistrer l'université" onAction="#handleSave" styleClass="btn-save-premium" prefWidth="220" prefHeight="45"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

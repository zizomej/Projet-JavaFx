<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.admin.PartenairesController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="5">
                <Label text="🎓 LearnHub" styleClass="sidebar-brand-text"/>
                <Label text="Espace Administrateur" styleClass="sidebar-brand-sub"/>
            </VBox>
            <VBox spacing="2" style="-fx-padding: 10 0;">
                <Label text="NAVIGATION" styleClass="nav-section-title"/>
                <Button text="🏠  Tableau de bord" styleClass="nav-btn" onAction="#goBack" maxWidth="Infinity"/>
                <Label text="STAGE" styleClass="nav-section-title"/>
                <Button text="🏫  Universités" styleClass="nav-btn, nav-btn-active" maxWidth="Infinity"/>
                <Button text="💼  Offres de Stage" styleClass="nav-btn" maxWidth="Infinity"/>
                <Button text="📝  Demandes Stage" styleClass="nav-btn" maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="admin-section" spacing="10">
                <Button text="🚪  Déconnexion" styleClass="nav-logout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:#f5f7fa;-fx-border-color:transparent;">
            <VBox styleClass="content-area" spacing="30" style="-fx-padding: 35 50;">
                
                <!-- BANNER HEADER -->
                <VBox spacing="10" style="-fx-background-color: linear-gradient(to right, #0A1F44, #1e3a8a, #4f46e5); -fx-background-radius: 20; -fx-padding: 35 45; -fx-effect: dropshadow(gaussian, rgba(30,58,138,0.3), 25, 0, 0, 10);">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox HBox.hgrow="ALWAYS" spacing="6">
                            <Label text="Gestion des Universités" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                            <Label text="Partenariats académiques et établissements d'enseignement" style="-fx-font-size: 15px; -fx-text-fill: rgba(255,255,255,0.75);"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Ajouter une université" onAction="#handleAdd"
                                styleClass="btn-add-premium"/>
                    </HBox>
                </VBox>

                <!-- STATS ROW -->
                <HBox spacing="25">
                    <VBox styleClass="stat-card-indigo" HBox.hgrow="ALWAYS" spacing="12">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="🏛️" style="-fx-font-size: 20px;"/>
                            <Label text="UNIVERSITÉS PUBLIQUES" styleClass="stat-label"/>
                        </HBox>
                        <Label fx:id="publiqueLabel" text="0" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card-indigo" HBox.hgrow="ALWAYS" spacing="12" style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #f8fafc); -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 5); -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 15; -fx-background-radius: 15; -fx-padding: 20;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="🏢" style="-fx-font-size: 20px;"/>
                            <Label text="UNIVERSITÉS PRIVÉES" style="-fx-font-weight: 700; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-letter-spacing: 1px;"/>
                        </HBox>
                        <Label fx:id="priveLabel" text="0" style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: #0f172a;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- SEARCH & TABLE CARD -->
                <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 25, 0, 0, 8);">
                    
                    <!-- Card Header -->
                    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 25 35; -fx-border-color: #f1f5f9; -fx-border-width: 0 0 1 0;">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Liste des Établissements" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #0f172a;"/>
                            <Label text="Gérez les informations de contact et Localisation" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
                        </VBox>
                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <TextField fx:id="searchField" promptText="Rechercher une université..." styleClass="form-control" prefWidth="250"/>
                            <Button text="🔍" onAction="#handleSearch"
                                    style="-fx-background-color: #f8fafc; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-padding: 10 15; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10; -fx-cursor: hand;"/>
                            <Button text="↻" onAction="#handleRefresh"
                                    style="-fx-background-color: #f8fafc; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-padding: 10 15; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10; -fx-cursor: hand;"/>
                        </HBox>
                    </HBox>

                    <!-- Table -->
                    <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 20;">
                        <TableView fx:id="partenaireTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;" styleClass="premium-table">
                            <placeholder>
                                <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40;">
                                    <Label text="📭" style="-fx-font-size: 40px;"/>
                                    <Label text="Aucun établissement trouvé" style="-fx-text-fill: #94a3b8; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                                </VBox>
                            </placeholder>
                        </TableView>
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

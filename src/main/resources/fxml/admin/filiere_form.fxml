<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.admin.FiliereFormController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="5">
                <Label text="🎓 LearnHub" styleClass="sidebar-brand-text"/>
                <Label text="Espace Administrateur" styleClass="sidebar-brand-sub"/>
            </VBox>
            <VBox spacing="2" style="-fx-padding: 10 0;">
                <Label text="NAVIGATION" styleClass="nav-section-title"/>
                <Button text="🏠  Tableau de bord" styleClass="nav-btn" onAction="#goBack" maxWidth="Infinity"/>
                <Label text="PÉDAGOGIE" styleClass="nav-section-title"/>
                <Button text="📂  Filières" styleClass="nav-btn, nav-btn-active" onAction="#goBack" maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="admin-section" spacing="10">
                <Button text="🚪  Déconnexion" styleClass="nav-logout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:#f5f7fa;-fx-border-color:transparent;">
            <VBox styleClass="content-area" spacing="30" style="-fx-padding: 35 50;">
                
                <!-- BANNER HEADER -->
                <VBox spacing="10" style="-fx-background-color: linear-gradient(to right, #0A1F44, #1e3a8a, #4f46e5); -fx-background-radius: 20; -fx-padding: 35 45; -fx-effect: dropshadow(gaussian, rgba(30,58,138,0.3), 25, 0, 0, 10);">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox HBox.hgrow="ALWAYS" spacing="6">
                            <Label fx:id="titleLabel" text="Ajouter une filière" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                            <Label text="Définition du parcours académique et des capacités" style="-fx-font-size: 15px; -fx-text-fill: rgba(255,255,255,0.75);"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="← Retour à la liste" onAction="#goBack"
                                style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 12; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1; -fx-border-radius: 12; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- FORM CARD -->
                <VBox maxWidth="900" style="-fx-background-color: white; -fx-background-radius: 22; -fx-padding: 50 60; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 30, 0, 0, 12); -fx-alignment: CENTER;" spacing="35" VBox.vgrow="ALWAYS">
                    
                    <VBox spacing="30" maxWidth="700">
                        <!-- Two Column Layout for Code and Name -->
                        <HBox spacing="25">
                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label text="Code de la filière *" styleClass="form-label"/>
                                <TextField fx:id="codeField" promptText="Ex: INFO-L3" styleClass="form-control" prefHeight="50"/>
                            </VBox>
                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label text="Nom de la filière *" styleClass="form-label"/>
                                <TextField fx:id="nomField" promptText="Ex: Licence en Informatique" styleClass="form-control" prefHeight="50"/>
                            </VBox>
                        </HBox>

                        <!-- Level and University -->
                        <HBox spacing="25">
                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label text="Niveau d'études *" styleClass="form-label"/>
                                <ComboBox fx:id="niveauCombo" promptText="Sélectionnez le niveau" maxWidth="Infinity" styleClass="form-control" prefHeight="50"/>
                            </VBox>
                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label text="Université d'appartenance *" styleClass="form-label"/>
                                <ComboBox fx:id="universiteCombo" promptText="Sélectionnez l'université" maxWidth="Infinity" styleClass="form-control" prefHeight="50"/>
                            </VBox>
                        </HBox>

                        <!-- Duration and Capacity -->
                        <HBox spacing="25">
                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label text="Durée (en années) *" styleClass="form-label"/>
                                <TextField fx:id="dureeField" promptText="Ex: 3" styleClass="form-control" prefHeight="50"/>
                            </VBox>
                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label text="Capacité maximale *" styleClass="form-label"/>
                                <TextField fx:id="capaciteField" promptText="Ex: 100" styleClass="form-control" prefHeight="50"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <Separator style="-fx-opacity: 0.3;"/>

                    <!-- Action Buttons -->
                    <HBox alignment="CENTER_RIGHT" spacing="15" maxWidth="700">
                        <Button text="Annuler" onAction="#goBack"
                                styleClass="btn-cancel-pink" prefWidth="140" prefHeight="48"/>
                        <Button text="Enregistrer la filière" onAction="#handleSave"
                                styleClass="btn-save-premium" prefWidth="250" prefHeight="48"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.admin.EvenementFormController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="5">
                <Label text="🎓 LearnHub" styleClass="sidebar-brand-text"/>
                <Label text="Espace Administrateur" styleClass="sidebar-brand-sub"/>
            </VBox>
            <VBox spacing="2" style="-fx-padding: 10 0;">
                <Label text="NAVIGATION" styleClass="nav-section-title"/>
                <Button text="🏠  Tableau de bord" styleClass="nav-btn" onAction="#goBack" maxWidth="Infinity"/>
                <Label text="VIE SCOLAIRE" styleClass="nav-section-title"/>
                <Button text="🎉  Événements" styleClass="nav-btn, nav-btn-active" onAction="#goBack" maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="admin-section" spacing="10">
                <Button text="🚪  Déconnexion" styleClass="nav-logout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <StackPane styleClass="root-container">
                <VBox styleClass="content-area" spacing="35" style="-fx-padding: 40 60;">
                    
                    <!-- TOPBAR (Style Symfony Premium Enhanced) -->
                    <VBox spacing="10" style="-fx-background-color: transparent; -fx-padding: 0 0 10 0;">
                        <HBox alignment="CENTER_LEFT" spacing="25">
                            <VBox HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="✨" style="-fx-font-size: 32px;"/>
                                    <Label fx:id="titleLabel" text="Ajouter un Événement" styleClass="page-title" style="-fx-font-size: 30px; -fx-font-weight: 900; -fx-text-fill: #1e3a8a;"/>
                                </HBox>
                                <Label text="Définissez les détails, la date et le lieu de votre nouvel événement." styleClass="page-subtitle" style="-fx-font-size: 15px; -fx-text-fill: #64748b;"/>
                            </VBox>
                            <Button text="← Retour à la liste" onAction="#goBack" 
                                    style="-fx-background-color: white; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="30" style="-fx-padding: 0 20;">
                        <!-- CARD FORM with accent -->
                        <VBox styleClass="card, card-accent" spacing="45" style="-fx-padding:55; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 40, 0, 0, 20);">
                            
                            <VBox spacing="30">
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label text="📌" styleClass="icon-blue" style="-fx-font-size: 24px;"/>
                                    <Label text="Informations de l'événement" style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #0f172a;"/>
                                </HBox>
                                
                                <!-- Titre (Full Width) -->
                                <VBox spacing="10">
                                    <Label text="Titre de l'événement" styleClass="form-label"/>
                                    <TextField fx:id="titreField" promptText="Ex: Conférence Annuelle LearnHub 2024" styleClass="form-control" prefHeight="52"/>
                                </VBox>

                                <GridPane hgap="40" vgap="30">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                    </columnConstraints>
                                    
                                    <!-- Ligne 1: Type & Statut -->
                                    <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Label text="Type d'événement" styleClass="form-label"/>
                                        <ComboBox fx:id="typeCombo" promptText="Choisir un type..." maxWidth="Infinity" prefHeight="52" styleClass="form-control"/>
                                    </VBox>
                                    <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Label text="Statut actuel" styleClass="form-label"/>
                                        <ComboBox fx:id="statutCombo" promptText="Sélectionner..." maxWidth="Infinity" prefHeight="52" styleClass="form-control"/>
                                    </VBox>
                                    
                                    <!-- Ligne 2: Dates -->
                                    <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                        <Label text="Date de début" styleClass="form-label"/>
                                        <DatePicker fx:id="dateDebutPicker" promptText=" jj / mm / aaaa" maxWidth="Infinity" prefHeight="52" styleClass="form-control"/>
                                    </VBox>
                                    <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Label text="Date de fin" styleClass="form-label"/>
                                        <DatePicker fx:id="dateFinPicker" promptText=" jj / mm / aaaa" maxWidth="Infinity" prefHeight="52" styleClass="form-control"/>
                                    </VBox>

                                    <!-- Ligne 3: Heures -->
                                    <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                        <Label text="Heure de début" styleClass="form-label"/>
                                        <TextField fx:id="heureDebutField" promptText="--:--" styleClass="form-control" prefHeight="52"/>
                                    </VBox>
                                    <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                        <Label text="Heure de fin" styleClass="form-label"/>
                                        <TextField fx:id="heureFinField" promptText="--:--" styleClass="form-control" prefHeight="52"/>
                                    </VBox>

                                    <!-- Ligne 4: Lieu & Capacité -->
                                    <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                        <Label text="Lieu / Emplacement" styleClass="form-label"/>
                                        <TextField fx:id="lieuField" promptText="Ex: Amphithéâtre A" styleClass="form-control" prefHeight="52"/>
                                    </VBox>
                                    <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                        <Label text="Capacité maximale" styleClass="form-label"/>
                                        <TextField fx:id="capaciteField" promptText="Nombre de places" styleClass="form-control" prefHeight="52"/>
                                    </VBox>
                                </GridPane>
                            </VBox>

                            <Separator style="-fx-opacity: 0.3;"/>

                            <!-- Description -->
                            <VBox spacing="15">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="📝" styleClass="icon-purple" style="-fx-font-size: 20px;"/>
                                    <Label text="Détails et Description" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                </HBox>
                                <TextArea fx:id="descriptionArea" promptText="Fournissez une description détaillée de l'événement..." prefHeight="160" styleClass="form-control" wrapText="true"/>
                            </VBox>
                            
                            <!-- ACTIONS -->
                            <HBox alignment="CENTER_RIGHT" spacing="25" style="-fx-padding: 10 0 0 0;">
                                <Button text="Annuler" styleClass="btn-cancel-pink" onAction="#goBack" prefWidth="120" prefHeight="45"/>
                                <Button text="Enregistrer l'événement" styleClass="btn-save-premium" onAction="#handleSave" prefWidth="250" prefHeight="45"/>
                            </HBox>
                            
                        </VBox>
                    </VBox>
                    
                </VBox>
            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>

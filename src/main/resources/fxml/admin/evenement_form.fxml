<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.learnhub.controller.admin.EvenementFormController"
            stylesheets="@/css/styles.css" prefWidth="1280" prefHeight="800">
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="5">
                <Label text="🎓 LearnHub" styleClass="sidebar-brand-text"/>
                <Label text="Espace Administrateur" styleClass="sidebar-brand-sub"/>
            </VBox>
            <VBox spacing="2" style="-fx-padding: 10 0;">
                <Label text="NAVIGATION" styleClass="nav-section-title"/>
                <Button text="🏠  Tableau de bord" styleClass="nav-btn" onAction="#goBack" maxWidth="Infinity"/>
                <Label text="VIE SCOLAIRE" styleClass="nav-section-title"/>
                <Button text="🎉  Événements" styleClass="nav-btn, nav-btn-active" onAction="#goBack" maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="admin-section" spacing="10">
                <Button text="🚪  Déconnexion" styleClass="nav-logout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:#f5f7fa;-fx-border-color:transparent;">
            <VBox styleClass="content-area" spacing="24">
                
                <!-- TOP HEADER -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label fx:id="titleLabel" text="Ajouter un Événement" styleClass="page-title"/>
                        <Label text="Décrivez l'événement et planifiez sa date et son lieu" styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="← Retour à la liste" styleClass="btn, btn-secondary, btn-sm" onAction="#goBack"/>
                </HBox>

                <!-- CARD FORM -->
                <VBox styleClass="card" spacing="20" style="-fx-padding:30;">
                    
                    <VBox spacing="8">
                        <Label text="Titre de l'événement" style="-fx-font-weight:bold;"/>
                        <TextField fx:id="titreField" promptText="Ex: Conférence Annuelle LearnHub" styleClass="search-field" prefHeight="40"/>
                    </VBox>

                    <GridPane hgap="20" vgap="20">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        </columnConstraints>
                        
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Type d'événement" style="-fx-font-weight:bold;"/>
                            <ComboBox fx:id="typeCombo" promptText="Conférence / Atelier / Fête" prefWidth="Infinity" prefHeight="40" styleClass="search-field"/>
                        </VBox>
                        
                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Lieu" style="-fx-font-weight:bold;"/>
                            <TextField fx:id="lieuField" promptText="Ex: Amphithéâtre Central" styleClass="search-field" prefHeight="40"/>
                        </VBox>
                        
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Date de début" style="-fx-font-weight:bold;"/>
                            <DatePicker fx:id="dateDebutPicker" prefWidth="Infinity" prefHeight="40" styleClass="search-field"/>
                        </VBox>
                        
                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Date de fin" style="-fx-font-weight:bold;"/>
                            <DatePicker fx:id="dateFinPicker" prefWidth="Infinity" prefHeight="40" styleClass="search-field"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label text="Heure de début" style="-fx-font-weight:bold;"/>
                            <TextField fx:id="heureDebutField" promptText="Ex: 09:00" styleClass="search-field" prefHeight="40"/>
                        </VBox>
                        
                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label text="Heure de fin" style="-fx-font-weight:bold;"/>
                            <TextField fx:id="heureFinField" promptText="Ex: 18:00" styleClass="search-field" prefHeight="40"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="3">
                            <Label text="Capacité" style="-fx-font-weight:bold;"/>
                            <TextField fx:id="capaciteField" promptText="Ex: 200" styleClass="search-field" prefHeight="40"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="3">
                            <Label text="Statut" style="-fx-font-weight:bold;"/>
                            <ComboBox fx:id="statutCombo" promptText="En cours / Terminé / Annulé" prefWidth="Infinity" prefHeight="40" styleClass="search-field"/>
                        </VBox>
                    </GridPane>

                    <VBox spacing="8">
                        <Label text="Description de l'événement" style="-fx-font-weight:bold;"/>
                        <TextArea fx:id="descriptionArea" promptText="Décrivez l'objectif et les détails de l'événement..." prefHeight="100" styleClass="search-field" wrapText="true"/>
                    </VBox>
                    
                    <!-- BOTTOM ACTIONS -->
                    <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 20 0 0 0; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
                        <Button text="Annuler" styleClass="btn, btn-secondary" prefWidth="120" prefHeight="40" onAction="#goBack"/>
                        <Button text="Enregistrer l'événement" styleClass="btn, btn-primary" style="-fx-background-color: #7c3aed; -fx-text-fill: white;" prefWidth="180" prefHeight="40" onAction="#handleSave"/>
                    </HBox>
                    
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

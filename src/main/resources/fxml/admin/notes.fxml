<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<BorderPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@/css/styles.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.learnhub.controller.admin.NotesAdminController">
    <left>
        <VBox prefWidth="250.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <VBox alignment="CENTER" prefHeight="100.0" style="-fx-padding: 20 10;">
                <Label text="🎓 LearnHub" textFill="WHITE" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                <Label text="Espace Administrateur" textFill="#a0aabf" style="-fx-font-size: 11px;"/>
            </VBox>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <VBox spacing="2.0" style="-fx-padding: 8 0;">
                    <Button maxWidth="Infinity" styleClass="sidebar-btn" text="📊 Dashboard" onAction="#goDashboard"/>
                    <Button maxWidth="Infinity" styleClass="sidebar-btn" text="👥 Utilisateurs" onAction="#goUtilisateurs"/>
                    <Button maxWidth="Infinity" styleClass="sidebar-btn" text="📚 Modules" onAction="#goModules"/>
                    <Button maxWidth="Infinity" styleClass="sidebar-btn" text="🗓 Séances" onAction="#goSeances"/>
                    <Button maxWidth="Infinity" styleClass="sidebar-btn sidebar-btn-active" text="📝 Notes" onAction="#goNotes"/>
                    <Button maxWidth="Infinity" styleClass="sidebar-btn" text="✔ Présences" onAction="#goPresences"/>
                    <Button maxWidth="Infinity" styleClass="sidebar-btn" text="🎓 Filières" onAction="#goFilieres"/>
                    <Button maxWidth="Infinity" styleClass="sidebar-btn" text="🎉 Événements" onAction="#goEvenements"/>
                    <Button maxWidth="Infinity" styleClass="sidebar-btn" text="🏥 RDV Médicaux" onAction="#goRdv"/>
                    <Button maxWidth="Infinity" styleClass="sidebar-btn" text="🕐 Créneaux" onAction="#goCreneaux"/>
                    <Button maxWidth="Infinity" styleClass="sidebar-btn" text="🤝 Partenaires" onAction="#goPartenaires"/>
                    <Button maxWidth="Infinity" styleClass="sidebar-btn" text="💼 Offres de Stage" onAction="#goOffresStage"/>
                    <Button maxWidth="Infinity" styleClass="sidebar-btn" text="📋 Demandes Stage" onAction="#goDemandesStage"/>
                </VBox>
            </ScrollPane>
            <VBox alignment="CENTER" prefHeight="100.0" spacing="8.0" style="-fx-background-color: #151a2b; -fx-padding: 10;">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <StackPane><Circle fill="#ff9800" radius="18.0"/><Label text="AD" textFill="WHITE" style="-fx-font-weight: bold;"/></StackPane>
                    <VBox alignment="CENTER_LEFT">
                        <Label text="Admin Principal" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                        <Label text="admin@learnhub.tn" textFill="#a0aabf" style="-fx-font-size: 11px;"/>
                    </VBox>
                </HBox>
                <Button text="🚪 Déconnexion" maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: #293047; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 8 10;"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f4f5f7; -fx-border-color: transparent;">
            <VBox spacing="20.0" style="-fx-background-color: #f4f5f7; -fx-padding: 20 30 20 30;">
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <VBox>
                        <Label text="📝 Gestion des Notes" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a2238;"/>
                        <Label text="Gérer les évaluations et les résultats académiques" textFill="#7a7a7a"/>
                    </VBox>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <TextField promptText="Rechercher..." prefWidth="250.0" styleClass="search-field"/>
                </HBox>

                <!-- Blue Banner -->
                <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1a56db; -fx-background-radius: 10; -fx-padding: 25 30;">
                    <VBox spacing="5.0">
                        <Label text="📝 Gestion des Notes" textFill="WHITE" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                        <Label text="Saisie et suivi des évaluations" textFill="#e0e0e0"/>
                    </VBox>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button text="+ Ajouter une note" onAction="#handleAdd" styleClass="btn-yellow"/>
                </HBox>

                <!-- Table Section -->
                <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 8, 0, 0, 3);">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Liste des notes" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a56db;"/>
                            <Label fx:id="statusLabel" text="" textFill="#888888" style="-fx-font-size: 12px;"/>
                        </VBox>
                        <Button text="✏️ Modifier" onAction="#handleEdit" styleClass="btn-primary"/>
                        <Button text="🗑 Supprimer" onAction="#handleDelete" styleClass="btn-danger"/>
                        <Button text="🔄 Actualiser" onAction="#handleRefresh" styleClass="btn-white"/>
                    </HBox>

                    <TableView fx:id="table" VBox.vgrow="ALWAYS" prefHeight="440.0" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="55.0"/>
                            <TableColumn fx:id="colEtudiant" text="Étudiant" prefWidth="180.0"/>
                            <TableColumn fx:id="colModule" text="Module" prefWidth="180.0"/>
                            <TableColumn fx:id="colValeur" text="Note" prefWidth="80.0" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colType" text="Type" prefWidth="110.0" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colDate" text="Date" prefWidth="110.0" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colMention" text="Mention" prefWidth="110.0" style="-fx-alignment: CENTER;"/>
                        </columns>
                        <placeholder>
                            <Label text="Aucune note trouvée" style="-fx-text-fill: #9ca3af;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

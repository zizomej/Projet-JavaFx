<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<HBox prefWidth="850.0" prefHeight="550.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #E2E8F0;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.learnhub.medical.controller.PaymentSimulationController">
    <!-- Côté Gauche : Résumé Vert -->
    <VBox prefWidth="350.0" style="-fx-background-color: #008060; -fx-padding: 40; -fx-background-radius: 11 0 0 11;" spacing="30">
        <Button onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-opacity: 0.8; -fx-cursor: hand;" text="← Retour" />
        
        <VBox spacing="10">
            <Label style="-fx-text-fill: #E2E8F0; -fx-font-weight: bold; -fx-font-size: 13;" text="PAYER A MEDICALHUB" />
            <Label style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: white;" text="20 DT" />
        </VBox>

        <VBox spacing="15">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <StackPane style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 8;" prefWidth="54" prefHeight="54">
                    <Label text="🏥" style="-fx-font-size: 24;" />
                </StackPane>
                <VBox spacing="2">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 15;" text="Consultation Médicale" />
                    <Label style="-fx-text-fill: #E2E8F0; -fx-font-size: 13;" text="Séance de soin" />
                </VBox>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS" />
        
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label style="-fx-text-fill: white; -fx-opacity: 0.7; -fx-font-size: 12;" text="Garanti par" />
            <Label style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14;" text="Stripe" />
        </HBox>
    </VBox>

    <!-- Côté Droit : Champs restants -->
    <VBox HBox.hgrow="ALWAYS" style="-fx-padding: 50;" spacing="25">
        <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Validation du paiement" />

        <VBox spacing="20">
            <VBox spacing="8">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 13;" text="Adresse e-mail *" />
                <TextField fx:id="emailField" prefHeight="45.0" promptText="votre@email.com" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 5; -fx-padding: 0 10;" />
            </VBox>

            <VBox spacing="8">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 13;" text="Numéro de Téléphone (WhatsApp) *" />
                <TextField fx:id="phoneField" prefHeight="45.0" promptText="28796935" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 5; -fx-padding: 0 10;" />
            </VBox>

            <VBox spacing="8">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 13;" text="Nom du titulaire *" />
                <TextField fx:id="nameField" prefHeight="45.0" promptText="Nom complet" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 5; -fx-padding: 0 10;" />
            </VBox>
        </VBox>

        <Region prefHeight="20" />

        <Button fx:id="payButton" maxWidth="Infinity" onAction="#handlePayment" prefHeight="50.0" style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16; -fx-background-radius: 5; -fx-cursor: hand;" text="Valider le paiement" />
        
        <HBox alignment="CENTER" spacing="5">
            <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 11;" text="Système de paiement sécurisé" />
        </HBox>
    </VBox>
</HBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.learnhub.medical.controller.AddRDVController" prefWidth="500" spacing="0" style="-fx-background-color: white; -fx-background-radius: 15;">
    
    <!-- Header style Symfony -->
    <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #F8FAFC; -fx-padding: 20; -fx-background-radius: 15 15 0 0; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
        <VBox alignment="CENTER" style="-fx-background-color: #EEF2FF; -fx-padding: 10; -fx-background-radius: 10;">
             <Label text="+" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #6366F1;" />
        </VBox>
        <VBox>
            <Label text="Prise de Rendez-vous" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
            <Label text="Veuillez remplir vos informations médicales" style="-fx-text-fill: #64748B; -fx-font-size: 11;" />
        </VBox>
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: white; -fx-background: white;">
        <VBox spacing="15.0" style="-fx-padding: 25;">
            
            <VBox spacing="5">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12;" text="Nom Complet *" />
                <TextField fx:id="txtNom" editable="false" prefHeight="40.0" style="-fx-background-color: #F1F5F9; -fx-border-color: #E2E8F0; -fx-border-radius: 6;" />
            </VBox>

            <VBox spacing="5">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12;" text="Email *" />
                <TextField fx:id="txtEmail" prefHeight="40.0" style="-fx-border-color: #E2E8F0; -fx-border-radius: 6;" />
            </VBox>

            <VBox spacing="5">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12;" text="Téléphone (WhatsApp) *" />
                <TextField fx:id="txtTel" prefHeight="40.0" promptText="Ex: +21628796935" style="-fx-border-color: #E2E8F0; -fx-border-radius: 6;" />
            </VBox>

            <VBox spacing="5">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12;" text="Motif de Consultation *" />
                <TextField fx:id="txtMotif" prefHeight="40.0" promptText="Ex: Douleurs dos" style="-fx-border-color: #E2E8F0; -fx-border-radius: 6;" />
            </VBox>

            <VBox spacing="5">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12;" text="Description symptômes *" />
                <TextArea fx:id="txtDescription" prefHeight="80.0" style="-fx-border-color: #E2E8F0; -fx-border-radius: 6;" wrapText="true" />
            </VBox>

            <VBox spacing="5">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12;" text="CIN" />
                <TextField fx:id="txtCIN" editable="false" prefHeight="40.0" style="-fx-background-color: #F1F5F9; -fx-border-color: #E2E8F0; -fx-border-radius: 6;" />
            </VBox>
        </VBox>
    </ScrollPane>

    <!-- Footer -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0" style="-fx-padding: 20; -fx-background-color: #F8FAFC; -fx-background-radius: 0 0 15 15;">
        <Button onAction="#handleCancel" prefHeight="35.0" prefWidth="90.0" text="Annuler" />
        <Button onAction="#handleSave" prefHeight="35.0" prefWidth="180.0" style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Continuer vers le paiement" />
    </HBox>

</VBox>

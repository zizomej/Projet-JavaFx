<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<VBox prefHeight="650.0" prefWidth="550.0" spacing="0.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.learnhub.medical.controller.AddRDVController" stylesheets="@../css/style.css">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="dialog-header" style="-fx-padding: 25;">
        <StackPane>
            <Circle radius="22" fill="#E0F2FE" />
            <Label text="🏥" style="-fx-font-size: 20;" />
        </StackPane>
        <VBox spacing="2.0">
            <Label styleClass="header-title" text="Prendre un Rendez-vous" />
            <Label text="Complétez les informations pour confirmer votre réservation" style="-fx-text-fill: #64748B; -fx-font-size: 13;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCancel" styleClass="btn-header-action" text="Annuler" />
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
        <VBox spacing="25.0" style="-fx-padding: 30 40;">
            
            <VBox spacing="8.0">
                <Label text="Nom complet *" styleClass="label-form" />
                <TextField fx:id="txtNom" prefHeight="45.0" promptText="Votre nom complet" />
            </VBox>

            <VBox spacing="8.0">
                <Label text="Email *" styleClass="label-form" />
                <TextField fx:id="txtEmail" prefHeight="45.0" promptText="Votre adresse email" />
            </VBox>

            <VBox spacing="8.0">
                <HBox spacing="5.0">
                    <Label text="Motif du RDV" styleClass="label-form" />
                    <Label text="*" style="-fx-text-fill: #EF4444;" />
                </HBox>
                <TextField fx:id="txtMotif" promptText="Ex: Consultation psychologique" prefHeight="45.0" />
            </VBox>

            <VBox spacing="8.0">
                <HBox spacing="5.0">
                    <Label text="Description détaillée" styleClass="label-form" />
                    <Label text="*" style="-fx-text-fill: #EF4444;" />
                </HBox>
                <TextArea fx:id="txtDescription" promptText="Décrivez brièvement votre situation ou vos symptômes..." prefHeight="120.0" wrapText="true" />
            </VBox>

            <VBox spacing="8.0">
                <Label text="Numéro CIN (Aperçu)" styleClass="label-form" />
                <TextField fx:id="txtCIN" promptText="Optionnel si déjà fourni" prefHeight="45.0" />
            </VBox>

        </VBox>
    </ScrollPane>

    <!-- Footer -->
    <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 20 40; -fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;">
        <Button onAction="#handleCancel" prefHeight="45.0" prefWidth="120.0" style="-fx-background-color: #E2E8F0; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 6;" text="Annuler" />
        <Button onAction="#handleSave" prefHeight="45.0" prefWidth="250.0" styleClass="btn-save-blue" style="-fx-background-color: #2563EB;" text="Confirmer la Réservation" />
    </HBox>

</VBox>

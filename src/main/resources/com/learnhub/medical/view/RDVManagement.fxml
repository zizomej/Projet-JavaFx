<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="25.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.learnhub.medical.controller.RDVManagementController" stylesheets="@../css/style.css" prefHeight="700.0" prefWidth="1050.0">

    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/></padding>

    <!-- Header Section (Style Symfony) -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <StackPane style="-fx-background-color: #F1F5F9; -fx-padding: 12; -fx-background-radius: 12;">
            <Label text="📂" style="-fx-font-size: 24;" />
        </StackPane>
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Liste des Rendez-vous" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
            <Label fx:id="lblResultCount" text="0 résultat(s)" style="-fx-text-fill: #64748B; -fx-font-size: 13;" />
        </VBox>
        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <TextField fx:id="txtSearch" promptText="Rechercher (Étudiant, Motif...)" style="-fx-background-radius: 20; -fx-padding: 8 15; -fx-pref-width: 250;" />
            <Button onAction="#handleAdd" styleClass="btn-primary" text="➕ Nouveau RDV" />
        </HBox>
    </HBox>

    <!-- Table Section -->
    <VBox VBox.vgrow="ALWAYS" styleClass="card" style="-fx-padding: 0; -fx-background-radius: 10; -fx-overflow: hidden;">
        <TableView fx:id="tableRDV" VBox.vgrow="ALWAYS" styleClass="table-rdv-pro" style="-fx-background-radius: 10; -fx-border-radius: 10;">
            <columns>
                <TableColumn fx:id="colDate" prefWidth="120.0" text="DATE" />
                <TableColumn fx:id="colEtudiant" prefWidth="250.0" text="ÉTUDIANT" />
                <TableColumn fx:id="colMotif" prefWidth="150.0" text="MOTIF" />
                <TableColumn fx:id="colStatut" prefWidth="130.0" text="STATUT" />
                <TableColumn fx:id="colCreneau" prefWidth="180.0" text="CRÉNEAU" />
                <TableColumn fx:id="colActions" prefWidth="180.0" text="ACTIONS" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>

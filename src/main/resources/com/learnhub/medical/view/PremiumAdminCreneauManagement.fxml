<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" style="-fx-background-color: #f4f5f7;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.learnhub.medical.controller.PremiumAdminCreneauManagementController">
    <VBox spacing="20.0" style="-fx-padding: 20; -fx-background-color: #f4f5f7;">
        
        <!-- Header Section -->
        <VBox spacing="5.0">
            <Label text="Gestion des Créneaux" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a2238;" />
            <Label text="Visualisation globale des disponibilités médicales" style="-fx-text-fill: #64748B;" />
        </VBox>

        <!-- Blue Banner -->
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1e3a8a; -fx-background-radius: 12; -fx-padding: 20 30;">
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label text="📅 Vue d'ensemble des Créneaux" textFill="WHITE" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                <Label fx:id="lblSummary" text="Administrateur | 0 créneaux au total" textFill="#d0d0f0" />
            </VBox>
            <HBox spacing="10.0">
                <Button onAction="#handleAdd" text="➕ Nouveau Créneau" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;" />
                <Button onAction="#handleExportPDF" text="💾 Exporter PDF" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;" />
                <Button onAction="#handleRefresh" text="🔄 Actualiser" style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;" />
            </HBox>
        </HBox>

        <!-- Stats Cards -->
        <HBox spacing="15.0">
            <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: transparent transparent transparent #3b82f6; -fx-border-width: 0 0 0 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                <Label fx:id="lblTotal" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;" />
                <Label text="Total Créneaux" style="-fx-text-fill: #64748B; -fx-font-size: 12px; -fx-font-weight: bold;" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: transparent transparent transparent #10b981; -fx-border-width: 0 0 0 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                <Label fx:id="lblDisponibles" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;" />
                <Label text="Disponibles" style="-fx-text-fill: #64748B; -fx-font-size: 12px; -fx-font-weight: bold;" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: transparent transparent transparent #ef4444; -fx-border-width: 0 0 0 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                <Label fx:id="lblReserves" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;" />
                <Label text="Réservés" style="-fx-text-fill: #64748B; -fx-font-size: 12px; -fx-font-weight: bold;" />
            </VBox>
        </HBox>

        <!-- Filters Section -->
        <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="🔍 Recherche" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;" />
                <TextField fx:id="txtSearch" promptText="Rechercher par jour, heure..." style="-fx-background-radius: 5; -fx-padding: 8;" />
            </VBox>
            <VBox spacing="5" prefWidth="200">
                <Label text="📊 Statut" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;" />
                <ComboBox fx:id="comboStatut" maxWidth="Infinity" style="-fx-background-radius: 5; -fx-padding: 5;" />
            </VBox>
        </HBox>

        <!-- Table Section -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
            <TableView fx:id="tableCreneaux" prefHeight="400.0" style="-fx-background-radius: 12; -fx-background-color: transparent;">
                <columns>
                    <TableColumn fx:id="colJour" text="JOUR" prefWidth="200" />
                    <TableColumn fx:id="colHeure" text="HORAIRE" prefWidth="150" />
                    <TableColumn fx:id="colRecurrence" text="RÉCURRENCE" prefWidth="200" />
                    <TableColumn fx:id="colStatut" text="STATUT" prefWidth="150" />
                    <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="100" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>

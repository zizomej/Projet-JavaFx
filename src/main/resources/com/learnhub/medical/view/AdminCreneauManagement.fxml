<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.learnhub.medical.controller.AdminCreneauManagementController"
      stylesheets="@../css/style.css" prefHeight="700.0" prefWidth="1100.0">

    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>

    <!-- Header -->
    <HBox spacing="15.0" alignment="CENTER_LEFT" styleClass="dashboard-header">
        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <Label text="📋 Gestion des Créneaux" textFill="WHITE"
                   style="-fx-font-size: 26; -fx-font-weight: 900;"/>
            <Label text="Analyse des disponibilités et filtrage en temps réel"
                   textFill="WHITE" style="-fx-opacity: 0.85; -fx-font-size: 14;"/>
        </VBox>
        <Button onAction="#showAddDialog" styleClass="btn-success" text="➕ Nouveau Créneau"
                style="-fx-font-size: 14; -fx-padding: 12 25; -fx-background-radius: 10;"/>
        <Button onAction="#handleExportPDF" styleClass="btn-primary" text="💾 Exporter PDF"
                style="-fx-font-size: 14; -fx-padding: 12 25; -fx-background-color: rgba(255,255,255,0.25); -fx-background-radius: 10;"/>
        <Button onAction="#refreshPlanning" styleClass="btn-primary" text="🔄 Actualiser"
                style="-fx-font-size: 14; -fx-padding: 12 25; -fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10;"/>
    </HBox>

    <!-- Chart Section -->
    <HBox spacing="20.0" alignment="CENTER">
        <VBox spacing="15" prefWidth="400" styleClass="glass-card" alignment="CENTER">
            <Label text="Statut des Disponibilités" style="-fx-font-size: 18; -fx-font-weight: 900; -fx-text-fill: #1E3A8A;"/>
            <StackPane>
                <PieChart fx:id="pieChartStatus" prefHeight="220" labelsVisible="true" animated="true" legendVisible="false"/>
                <VBox alignment="CENTER" mouseTransparent="true">
                    <Label fx:id="lblTotalSlots" text="0" style="-fx-font-size: 32; -fx-font-weight: 900; -fx-text-fill: #1E3A8A;"/>
                    <Label text="TOTAL" style="-fx-font-size: 12; -fx-text-fill: #64748B; -fx-font-weight: bold;"/>
                </VBox>
            </StackPane>
        </VBox>
    </HBox>

    <!-- Table Section -->
    <VBox spacing="15" VBox.vgrow="ALWAYS" styleClass="glass-card">
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="2">
                <Label text="Tous les créneaux" style="-fx-font-size: 20; -fx-font-weight: 900; -fx-text-fill: #1E3A8A;"/>
                <Label fx:id="lblResultCount" text="0 résultat(s)" style="-fx-text-fill: #64748B; -fx-font-size: 12;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #F1F5F9; -fx-background-radius: 10; -fx-padding: 5 15; -fx-min-width: 300;">
                <Label text="🔍" style="-fx-font-size: 14;"/>
                <TextField fx:id="txtSearch" promptText="Rechercher par date, heure, récurrence..." 
                           HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 5;"/>
            </HBox>
        </HBox>
        <TableView fx:id="tableCreneaux" VBox.vgrow="ALWAYS" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="colJour" text="JOUR" prefWidth="180"/>
                <TableColumn fx:id="colHeure" text="HORAIRES" prefWidth="120"/>
                <TableColumn fx:id="colRecurrence" text="RÉCURRENCE" prefWidth="180"/>
                <TableColumn fx:id="colStatut" text="STATUT" prefWidth="150"/>
                <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="150"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
    </VBox>
</VBox>

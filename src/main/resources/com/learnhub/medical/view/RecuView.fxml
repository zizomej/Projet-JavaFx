<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Text?>

<VBox alignment="TOP_CENTER" prefWidth="650.0" prefHeight="800.0" style="-fx-background-color: white; -fx-padding: 40;" spacing="0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.learnhub.medical.controller.RecuController">
    
    <StackPane VBox.vgrow="ALWAYS">
        <!-- Filigrane (Watermark) -->
        <Label text="PAYÉ - VALIDÉ" rotate="-35" style="-fx-font-size: 80; -fx-text-fill: #F1F5F9; -fx-font-weight: bold; -fx-opacity: 0.5;" />
        
        <VBox spacing="30">
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="LearnHub Medical" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                    <Label text="Service Médical Universitaire" style="-fx-text-fill: #64748B;" />
                    <Label text="Tunis, Tunisie" style="-fx-text-fill: #64748B;" />
                </VBox>
                <VBox alignment="CENTER_RIGHT">
                    <Label text="REÇU MÉDICAL" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #10B981;" />
                    <Label fx:id="lblReference" text="Référence: #127-2026" style="-fx-text-fill: #64748B;" />
                    <Label fx:id="lblDateEmission" text="Émis le: 25/04/2026" style="-fx-text-fill: #64748B;" />
                </VBox>
            </HBox>

            <Line endX="570" stroke="#E2E8F0" />

            <!-- Infos Patient / Pro -->
            <HBox spacing="50">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="PATIENT" style="-fx-font-weight: bold; -fx-text-fill: #94A3B8; -fx-font-size: 11;" />
                    <Label fx:id="lblPatientNom" text="Étudiant LearnHub" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                    <Label fx:id="lblPatientEmail" text="contact@learnhub.com" style="-fx-text-fill: #64748B;" />
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="PROFESSIONNEL" style="-fx-font-weight: bold; -fx-text-fill: #94A3B8; -fx-font-size: 11;" />
                    <Label text="Dr. Khalil (SANTÉ)" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                    <Label text="Service Médical Universitaire" style="-fx-text-fill: #64748B;" />
                </VBox>
            </HBox>

            <!-- Table -->
            <VBox spacing="15">
                <HBox style="-fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 10 0;">
                    <Label text="DESCRIPTION DE LA PRESTATION" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-font-weight: bold; -fx-text-fill: #94A3B8; -fx-font-size: 11;" />
                    <Label text="MONTANT" style="-fx-font-weight: bold; -fx-text-fill: #94A3B8; -fx-font-size: 11;" />
                </HBox>
                <HBox alignment="TOP_LEFT">
                    <VBox HBox.hgrow="ALWAYS" spacing="5">
                        <Label text="Consultation Médicale Universitaire" style="-fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                        <Label fx:id="lblMotif" text="Motif: ..." style="-fx-text-fill: #64748B; -fx-font-size: 12;" />
                        <Label fx:id="lblRdvDate" text="Date du RDV: 2026-04-26" style="-fx-text-fill: #64748B; -fx-font-size: 12;" />
                    </VBox>
                    <Label text="20.00 DT" style="-fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Total -->
            <HBox alignment="CENTER_RIGHT" spacing="40">
                <Label text="TOTAL PAYÉ" style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 16;" />
                <Label text="20.00 DT" style="-fx-font-weight: bold; -fx-text-fill: #10B981; -fx-font-size: 24;" />
            </HBox>

            <!-- Footer Badge -->
            <HBox style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-padding: 20;" spacing="15" alignment="CENTER_LEFT">
                <Label text="🛡️" style="-fx-font-size: 20;" />
                <VBox>
                    <Label text="Transaction Sécurisée" style="-fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                    <Label text="Ce document fait office de preuve de paiement officielle." style="-fx-text-fill: #64748B; -fx-font-size: 11;" />
                </VBox>
            </HBox>
        </VBox>
    </StackPane>

    <!-- Buttons -->
    <HBox alignment="CENTER" spacing="20" style="-fx-padding: 30 0 0 0;">
        <Button fx:id="btnEnregistrer" onAction="#handleExportPDF" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #1E40AF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Enregistrer en PDF" />
        <Button onAction="#handleClose" prefHeight="45.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #1E40AF; -fx-text-fill: #1E40AF; -fx-font-weight: bold; -fx-background-radius: 8;" text="Retour" />
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.learnhub.medical.controller.CreneauManagementController"
      stylesheets="@../css/style.css" prefHeight="650.0" prefWidth="1000.0">

    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>

    <!-- Header -->
    <VBox spacing="10.0" style="-fx-background-color: linear-gradient(to right, #1E3A8A, #2563EB);
          -fx-background-radius: 12; -fx-padding: 20;">
        <Label text="📅 Gestion des Créneaux" textFill="WHITE"
               style="-fx-font-size: 22; -fx-font-weight: bold;"/>
        <Label text="Vue calendrier hebdomadaire — clic droit sur un créneau pour le gérer"
               textFill="WHITE" style="-fx-opacity: 0.85;"/>
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Button onAction="#handlePrevWeek" styleClass="btn-primary" text="← Semaine Précédente"/>
        <Label fx:id="lblWeekRange" text="Semaine du --/-- au --/--"
               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1E3A8A;"/>
        <Button onAction="#handleNextWeek" styleClass="btn-primary" text="Semaine Suivante →"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#showAddDialog" styleClass="btn-success" text="➕ Nouveau Créneau"/>
        <Button onAction="#refreshPlanning" styleClass="btn-primary" text="🔄 Actualiser"/>
    </HBox>

    <!-- Calendrier -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <GridPane fx:id="gridPlanning" hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" minWidth="100.0"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="100.0"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="100.0"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="100.0"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="100.0"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="100.0"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="100.0"/>
            </columnConstraints>
        </GridPane>
    </ScrollPane>

    <!-- Légende -->
    <HBox spacing="30.0" alignment="CENTER"
          style="-fx-padding: 12; -fx-background-color: #F8FAFC; -fx-background-radius: 8;">
        <HBox spacing="8" alignment="CENTER">
            <Pane prefHeight="16" prefWidth="16" style="-fx-background-color: #d1fae5; -fx-border-color: #10B981; -fx-border-radius: 3;"/>
            <Label text="Disponible" style="-fx-font-weight: bold;"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER">
            <Pane prefHeight="16" prefWidth="16" style="-fx-background-color: #fee2e2; -fx-border-color: #EF4444; -fx-border-radius: 3;"/>
            <Label text="Réservé" style="-fx-font-weight: bold;"/>
        </HBox>
        <Label text="💡 Clic droit sur un créneau : Supprimer / Changer disponibilité"
               style="-fx-opacity: 0.6;"/>
    </HBox>

</VBox>

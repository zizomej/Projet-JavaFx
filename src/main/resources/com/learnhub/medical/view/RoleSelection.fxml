<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<VBox alignment="CENTER" spacing="50.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.learnhub.medical.controller.RoleSelectionController"
      style="-fx-background-color: linear-gradient(to bottom right, #0A1F44, #1E3A8A);" 
      prefHeight="600.0" prefWidth="900.0" stylesheets="@../css/style.css">
    
    <padding>
        <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
    </padding>

    <VBox alignment="CENTER" spacing="10.0">
        <Label text="LearnHub Medical" textFill="#FFC107">
            <font>
                <Font name="System Bold" size="48.0" />
            </font>
        </Label>
        <Label text="Plateforme de Gestion Universitaire" textFill="WHITE" style="-fx-opacity: 0.8;">
            <font>
                <Font size="18.0" />
            </font>
        </Label>
    </VBox>

    <HBox alignment="CENTER" spacing="30.0">
        <children>
            <!-- Medecin Card -->
            <VBox fx:id="cardMedecin" onMouseClicked="#selectMedecin" alignment="CENTER" spacing="20.0" prefHeight="250.0" prefWidth="200.0" styleClass="role-card">
                <children>
                    <StackPane alignment="CENTER">
                        <Circle radius="40" style="-fx-fill: linear-gradient(to bottom right, #10B981, #059669); -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.4), 10, 0, 0, 5);" />
                        <Label text="Dr" style="-fx-font-size: 32; -fx-font-weight: 900; -fx-text-fill: white;" />
                    </StackPane>
                    <Label text="Médecin" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 20;" />
                    <Label text="Gérez vos créneaux et RDV" textAlignment="CENTER" textFill="WHITE" wrapText="true" style="-fx-opacity: 0.7;" />
                </children>
            </VBox>

            <!-- Student Card -->
            <VBox fx:id="cardStudent" onMouseClicked="#selectStudent" alignment="CENTER" spacing="20.0" prefHeight="250.0" prefWidth="200.0" styleClass="role-card">
                <children>
                    <StackPane alignment="CENTER">
                        <Circle radius="40" style="-fx-fill: linear-gradient(to bottom right, #3B82F6, #1D4ED8); -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.4), 10, 0, 0, 5);" />
                        <Label text="Ét" style="-fx-font-size: 32; -fx-font-weight: 900; -fx-text-fill: white;" />
                    </StackPane>
                    <Label text="Étudiant" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 20;" />
                    <Label text="Prenez vos rendez-vous médicaux" textAlignment="CENTER" textFill="WHITE" wrapText="true" style="-fx-opacity: 0.7;" />
                </children>
            </VBox>

            <!-- Admin Card -->
            <VBox fx:id="cardAdmin" onMouseClicked="#selectAdmin" alignment="CENTER" spacing="20.0" prefHeight="250.0" prefWidth="200.0" styleClass="role-card">
                <children>
                    <StackPane alignment="CENTER">
                        <Circle radius="40" style="-fx-fill: linear-gradient(to bottom right, #F59E0B, #B45309); -fx-effect: dropshadow(gaussian, rgba(245, 158, 11, 0.4), 10, 0, 0, 5);" />
                        <Label text="Ad" style="-fx-font-size: 32; -fx-font-weight: 900; -fx-text-fill: white;" />
                    </StackPane>
                    <Label text="Administrateur" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 20;" />
                    <Label text="Configuration globale du système" textAlignment="CENTER" textFill="WHITE" wrapText="true" style="-fx-opacity: 0.7;" />
                </children>
            </VBox>
        </children>
    </HBox>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.learnhub.gestion_rdv_creneau.controller.StudentPlanningController"
      stylesheets="@../css/style.css" prefHeight="650.0" prefWidth="950.0">
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Header similar to Symfony -->
    <VBox spacing="10.0" styleClass="medical-header" style="-fx-background-color: linear-gradient(to right, #10B981, #059669); -fx-background-radius: 15; -fx-padding: 25;">
        <children>
            <Label text="🏥 Service Médical - Créneaux Disponibles" textFill="WHITE" style="-fx-font-size: 24; -fx-font-weight: bold;" />
            <Label text="Sélectionnez un créneau disponible pour prendre rendez-vous" textFill="WHITE" style="-fx-opacity: 0.9;" />
        </children>
    </VBox>

    <HBox spacing="15.0" alignment="CENTER_LEFT">
        <children>
            <Button mnemonicParsing="false" onAction="#handlePrevWeek" styleClass="btn-primary" text="← Semaine précédente" />
            <Label fx:id="lblWeekRange" text="Semaine du ... au ..." style="-fx-font-weight: bold; -fx-font-size: 16;" />
            <Button mnemonicParsing="false" onAction="#handleNextWeek" styleClass="btn-primary" text="Semaine suivante →" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#refreshPlanning" styleClass="btn-yellow" text="Actualiser" />
        </children>
    </HBox>

    <!-- Planning Grid -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <GridPane fx:id="gridPlanning" hgap="10.0" vgap="10.0" prefHeight="500.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <!-- Headers and columns will be added dynamically in controller -->
        </GridPane>
    </ScrollPane>

    <!-- Legend -->
    <HBox spacing="30.0" alignment="CENTER" style="-fx-padding: 15; -fx-background-color: #F8FAFC; -fx-background-radius: 10;">
        <children>
            <HBox spacing="10.0" alignment="CENTER">
                <Pane prefHeight="20.0" prefWidth="20.0" style="-fx-background-color: #d1fae5; -fx-border-color: #10B981; -fx-border-radius: 3;" />
                <Label text="Disponible" style="-fx-font-weight: bold;" />
            </HBox>
            <HBox spacing="10.0" alignment="CENTER">
                <Pane prefHeight="20.0" prefWidth="20.0" style="-fx-background-color: #fee2e2; -fx-border-color: #EF4444; -fx-border-radius: 3;" />
                <Label text="Réservé" style="-fx-font-weight: bold;" />
            </HBox>
            <HBox spacing="10.0" alignment="CENTER">
                <Pane prefHeight="20.0" prefWidth="20.0" style="-fx-background-color: #E2E8F0; -fx-border-color: #94A3B8; -fx-border-radius: 3;" />
                <Label text="Fermé" style="-fx-font-weight: bold;" />
            </HBox>
        </children>
    </HBox>
    
</VBox>


<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="700.0" prefWidth="1100.0" spacing="25.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.learnhub.gestion_rdv_creneau.controller.CreneauManagementController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="calendar-container" style="-fx-padding: 25;">
        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <Label text="Mon Planning Hebdomadaire" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
            <Label text="Gérez vos disponibilités types pour la semaine" style="-fx-text-fill: #64748b;" />
        </VBox>
        
        <HBox alignment="CENTER" spacing="15.0">
            <Button onAction="#handlePrevWeek" styleClass="pagination-button" text="← Précédent" />
            <VBox alignment="CENTER">
                <Label fx:id="lblWeekRange" text="06 APR - 12 APR 2026" style="-fx-font-weight: bold; -fx-text-fill: #1e3a8a;" />
                <Label text="Cette semaine" style="-fx-font-size: 10; -fx-text-fill: #2563eb;" />
            </VBox>
            <Button onAction="#handleNextWeek" styleClass="pagination-button" text="Suivant →" />
        </HBox>

        <Button onAction="#showAddDialog" styleClass="btn-primary" text="+ Nouveau créneau" style="-fx-background-radius: 12; -fx-padding: 12 25;" />
    </HBox>

    <!-- Calendar Grid -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
        <GridPane fx:id="gridPlanning" hgap="15.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" minWidth="140.0" prefWidth="150.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="140.0" prefWidth="150.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="140.0" prefWidth="150.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="140.0" prefWidth="150.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="140.0" prefWidth="150.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="140.0" prefWidth="150.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="140.0" prefWidth="150.0" />
            </columnConstraints>
            <!-- Day Columns will be injected here dynamically -->
        </GridPane>
    </ScrollPane>
    
    <!-- Legend -->
    <HBox alignment="CENTER" spacing="30.0">
        <HBox alignment="CENTER" spacing="10.0">
            <Region style="-fx-background-color: #f0fdf4; -fx-border-color: #10B981; -fx-border-radius: 4; -fx-background-radius: 4;" prefWidth="20.0" prefHeight="20.0" />
            <Label text="Disponible" style="-fx-font-size: 13; -fx-text-fill: #64748b;" />
        </HBox>
        <HBox alignment="CENTER" spacing="10.0">
            <Region style="-fx-background-color: #fef2f2; -fx-border-color: #EF4444; -fx-border-radius: 4; -fx-background-radius: 4;" prefWidth="20.0" prefHeight="20.0" />
            <Label text="Réservé" style="-fx-font-size: 13; -fx-text-fill: #64748b;" />
        </HBox>
    </HBox>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefWidth="500.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.learnhub.gestion_rdv_creneau.controller.AddCreneauController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="📅" style="-fx-font-size: 24;" />
        <Label text="Détails du créneau" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
    </HBox>

    <Separator />

    <VBox spacing="15.0">
        <VBox spacing="8.0">
            <Label text="Horaires &amp; Fréquence" style="-fx-font-weight: bold; -fx-text-fill: #1e3a8a;" />
            <GridPane hgap="15.0" vgap="15.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                </columnConstraints>
                
                <VBox spacing="5.0">
                    <Label text="Date du créneau" style="-fx-text-fill: #64748b;" />
                    <DatePicker fx:id="datePicker" prefWidth="440.0" promptText="jj/mm/aaaa" />
                </VBox>
                
                <VBox spacing="5.0" GridPane.rowIndex="1">
                    <Label text="Heure de début" style="-fx-text-fill: #64748b;" />
                    <TextField fx:id="txtHeure" promptText="HH:mm (ex: 08:00)" />
                </VBox>
                
                <VBox spacing="5.0" GridPane.rowIndex="2">
                    <Label text="Récurrence" style="-fx-text-fill: #64748b;" />
                    <TextField fx:id="txtRecurrence" promptText="Ex: Hebdomadaire, Mensuelle..." />
                </VBox>

                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>
        </VBox>

        <VBox spacing="10.0" style="-fx-padding: 15; -fx-background-color: #f0fdf4; -fx-background-radius: 10; -fx-border-color: #10B981; -fx-border-radius: 10;">
            <CheckBox fx:id="checkDisponibilite" selected="true" text="Marquer comme Disponible" style="-fx-font-weight: bold; -fx-text-fill: #059669;" />
        </VBox>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <Button onAction="#handleCancel" styleClass="pagination-button" text="Annuler" />
        <Button onAction="#handleSave" styleClass="btn-primary" text="💾 Enregistrer le Créneau" style="-fx-background-radius: 8;" />
    </HBox>
</VBox>
